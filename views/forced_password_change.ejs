<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Your Account — Agali Awamu SACCO</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="./assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <style>
        /* Reusing your login.ejs styles conceptually */
        body { font-family: 'DM Sans', sans-serif; background: #f0f4f8; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .card { background: white; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); width: 100%; max-width: 400px; }
        h2 { margin-bottom: 10px; font-weight: 800; color: #1a1f2e; }
        p { color: #718096; font-size: 0.9rem; margin-bottom: 25px; }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 0.75rem; font-weight: 700; color: #4a5568; text-transform: uppercase; margin-bottom: 5px; }
        input { width: 100%; padding: 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; outline: none; box-sizing: border-box; }
        input:focus { border-color: #00b894; }
        .btn { width: 100%; padding: 14px; background: #00b894; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 10px; }
        .error { color: #e53e3e; font-size: 0.8rem; margin-top: 10px; display: none; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Secure Your Account</h2>
        <p>This is your first time logging in. Please set a new personal password to continue.</p>
        
        <form id="forced-change-form">
            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="new_password" required placeholder="Minimum 6 characters">
            </div>
            <div class="form-group">
                <label>Confirm Password</label>
                <input type="password" name="confirm_password" required placeholder="Repeat new password">
            </div>
            <div class="error" id="errMsg"></div>
            <button type="submit" class="btn" id="submitBtn">Update Password & Continue</button>
        </form>
    </div>

    <script src="./assets/vendors/jquery/dist/jquery.min.js"></script>
    <script>
        $('#forced-change-form').on('submit', function(e) {
            e.preventDefault();
            const new_password = $('input[name="new_password"]').val();
            const confirm_password = $('input[name="confirm_password"]').val();
            
            if (new_password.length < 6) {
                $('#errMsg').text('Password must be at least 6 characters').show();
                return;
            }
            if (new_password !== confirm_password) {
                $('#errMsg').text('Passwords do not match').show();
                return;
            }

            $('#submitBtn').prop('disabled', true).text('Updating...');

            $.ajax({
                url: '/forced-password-change',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ new_password, confirm_password }),
                success: function() {
                    window.location.href = '/';
                },
                error: function(xhr) {
                    $('#errMsg').text(xhr.responseJSON.error || 'An error occurred').show();
                    $('#submitBtn').prop('disabled', false).text('Update Password & Continue');
                }
            });
        });
    </script>
</body>
</html>
