<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Statement</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading { padding: 14px 22px 0; }
        .page-heading h3 { font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0; }
        .page-subtitle { margin-top: 4px; color: #718096; font-size: .78rem; }

        .page-content { padding: 12px 22px 24px; }
        .page-footer { padding: 12px 22px; font-size: .72rem; color: #a0aec0; text-align: center; border-top: 1px solid #eaeef2; background: #fff; }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #eaeef2;
            background: #fff;
        }
        .ibox-title {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #718096;
        }
        .ibox-body { padding: 14px; background: #fff; }

        .btn {
            font-size: .75rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            transition: all .15s;
        }
        .btn-sm { padding: 5px 12px; font-size: .7rem; }
        .btn-primary { background: #00b894; border: none; color: #fff; }
        .btn-primary:hover { background: #00a388; color: #fff; }
        .btn-secondary { background: #edf2f7; border: none; color: #2d3748; }
        .btn-secondary:hover { background: #e2e8f0; color: #1a202c; }
        .btn-outline-primary {
            border: 1px solid #00b894;
            color: #00b894;
            background: #fff;
        }
        .btn-outline-primary:hover {
            background: #00b894;
            color: #fff;
        }

        .hero-strip {
            background: linear-gradient(135deg, #00b894 0%, #008f76 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(0, 184, 148, 0.16);
        }
        .hero-strip .title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .hero-strip .meta {
            font-size: .78rem;
            opacity: .92;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
        }
        @media (max-width: 1199px) {
            .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 575px) {
            .summary-grid { grid-template-columns: 1fr; }
        }
        .metric-card {
            background: #fff;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            padding: 14px;
            min-height: 104px;
        }
        .lookup-card {
            background: #fff;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 14px;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
        }
        .lookup-actions {
            display: flex;
            gap: 10px;
            align-items: end;
            flex-wrap: wrap;
        }
        .metric-label {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #718096;
            margin-bottom: 10px;
        }
        .metric-value {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1f2e;
            line-height: 1.35;
        }
        .metric-sub {
            margin-top: 6px;
            font-size: .72rem;
            color: #718096;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0 16px;
        }
        @media (max-width: 767px) {
            .details-grid { grid-template-columns: 1fr; }
        }
        .detail-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #edf2f7;
        }
        .detail-row:last-child,
        .details-grid .detail-row:nth-last-child(-n+2) { border-bottom: 1px solid #edf2f7; }
        .detail-label {
            color: #718096;
            font-size: .75rem;
            font-weight: 600;
        }
        .detail-value {
            color: #1a1f2e;
            font-size: .78rem;
            font-weight: 700;
            text-align: right;
        }

        .table-responsive { overflow-x: auto; }
        #scheduleTable {
            width: 100% !important;
            font-size: .75rem;
        }
        #scheduleTable thead th {
            padding: 7px 8px;
            font-size: .72rem;
            font-weight: 700;
            background: #f7fafc;
            border-bottom: 2px solid #eaeef2;
            color: #1a1f2e;
            white-space: nowrap;
        }
        #scheduleTable tbody td {
            padding: 7px 8px;
            vertical-align: middle;
            border-color: #eaeef2;
        }
        #scheduleTable tbody tr:hover { background: #f7fafc; }
        .text-right { text-align: right !important; }

        .status-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .status-paid { background: rgba(56, 161, 105, .12); color: #2f855a; }
        .status-pending { background: rgba(221, 107, 32, .14); color: #c05621; }
        .status-overdue { background: rgba(229, 62, 62, .12); color: #c53030; }
        .status-active { background: rgba(49, 130, 206, .12); color: #2b6cb0; }
        .status-completed { background: rgba(56, 161, 105, .12); color: #2f855a; }
        .status-defaulted { background: rgba(229, 62, 62, .12); color: #c53030; }

        .note-panel {
            margin-top: 12px;
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid #bee3f8;
            background: #ebf8ff;
            color: #2c5282;
            font-size: .75rem;
        }

        .dataTables_wrapper { font-size: .75rem; }
        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: .75rem;
        }
        .dataTables_wrapper .pagination .page-link {
            font-size: .75rem;
            padding: .4rem .6rem;
            color: #00b894;
        }
        .dataTables_wrapper .pagination .page-item.active .page-link {
            background: #00b894;
            border-color: #00b894;
        }

        .loading-state,
        .empty-state {
            padding: 24px 16px;
            text-align: center;
            color: #718096;
            font-size: .82rem;
        }

        @media print {
            body { background: #fff !important; }
            .page-heading,
            .page-footer,
            .ibox-tools,
            .dataTables_length,
            .dataTables_filter,
            .dataTables_info,
            .dataTables_paginate,
            .dataTables_empty,
            .sidebar,
            .header,
            .page-header,
            .print-hide { display: none !important; }

            .page-wrapper,
            body.sidebar-collapsed .page-wrapper {
                margin: 0 !important;
                width: 100% !important;
            }

            .ibox,
            .metric-card,
            .hero-strip {
                box-shadow: none !important;
                border: 1px solid #ddd !important;
            }

            .hero-strip {
                color: #1a1f2e !important;
                background: #fff !important;
            }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <h3><i class="fa fa-file-text" style="color: #00b894; margin-right: 8px;"></i>Loan Statement</h3>
            <div class="page-subtitle">Member statement, repayment progress, and installment schedule.</div>
        </div>

        <div class="page-content">
            <div class="hero-strip" id="statementHero">
                <div class="title">Preparing statement</div>
                <div class="meta">Enter a loan ID or open this page from the loan list.</div>
            </div>

            <div class="lookup-card">
                <div class="row">
                    <div class="col-md-6 col-lg-4">
                        <div class="form-group mb-md-0">
                            <label for="loanLookupInput">Loan ID</label>
                            <input type="number" class="form-control" id="loanLookupInput" min="1" placeholder="Enter loan ID">
                            <div class="metric-sub">Load a statement for a specific loan account.</div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-8">
                        <div class="lookup-actions">
                            <button class="btn btn-primary" id="loadLoanBtn" type="button">
                                <i class="fa fa-search"></i> Load Statement
                            </button>
                            <a href="/loan_list" class="btn btn-secondary">
                                <i class="fa fa-list"></i> Browse Loans
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Statement Actions</div>
                    <div class="ibox-tools">
                        <button class="btn btn-outline-primary btn-sm" id="refreshStatementBtn">
                            <i class="fa fa-refresh"></i> Refresh
                        </button>
                        <button class="btn btn-secondary btn-sm" id="exportExcelBtn">
                            <i class="fa fa-file-excel-o"></i> Excel Export
                        </button>
                        <button class="btn btn-primary btn-sm" id="printPdfBtn">
                            <i class="fa fa-file-pdf-o"></i> PDF Print
                        </button>
                    </div>
                </div>
                <div class="ibox-body">
                    <div class="summary-grid" id="summaryCards">
                        <div class="metric-card"><div class="metric-label">Status</div><div class="metric-value">Loading...</div></div>
                        <div class="metric-card"><div class="metric-label">Outstanding</div><div class="metric-value">Loading...</div></div>
                        <div class="metric-card"><div class="metric-label">Installments</div><div class="metric-value">Loading...</div></div>
                        <div class="metric-card"><div class="metric-label">Repayment</div><div class="metric-value">Loading...</div></div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-5">
                    <div class="ibox">
                        <div class="ibox-head">
                            <div class="ibox-title">Loan Details</div>
                        </div>
                        <div class="ibox-body">
                            <div class="details-grid" id="loanDetails">
                                <div class="loading-state">Loading loan details...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="ibox">
                        <div class="ibox-head">
                            <div class="ibox-title">Repayment Snapshot</div>
                        </div>
                        <div class="ibox-body">
                            <div class="details-grid" id="repaymentSnapshot">
                                <div class="loading-state">Loading repayment summary...</div>
                            </div>
                            <div class="note-panel">
                                <i class="fa fa-info-circle"></i>
                                Expected interest in the schedule reflects the planned structure at disbursement. For reducing-balance loans, actual interest accrues daily on the outstanding balance.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Payment Schedule</div>
                </div>
                <div class="ibox-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover" id="scheduleTable" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Due Date</th>
                                    <th class="text-right">Expected Payment</th>
                                    <th class="text-right">Principal</th>
                                    <th class="text-right">Interest</th>
                                    <th class="text-right">Paid</th>
                                    <th class="text-right">Balance</th>
                                    <th>Status</th>
                                    <th>Paid Date</th>
                                </tr>
                            </thead>
                            <tbody id="scheduleBody">
                                <tr>
                                    <td colspan="9" class="loading-state">Loading payment schedule...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            2026 © Agali Awamu SACCO — All rights reserved.
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        let loanId = urlParams.get('loan_id');

        let currentLoan = null;
        let currentSchedule = [];
        let scheduleTableInstance = null;

        $('#loanLookupInput').val(loanId || '');

        function formatCurrency(value) {
            return 'UGX ' + Number(value || 0).toLocaleString('en-UG', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }

        function formatDate(value) {
            if (!value) return '-';
            const parsed = new Date(value);
            if (Number.isNaN(parsed.getTime())) return '-';
            return parsed.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatStatusPill(status) {
            const normalized = String(status || 'Pending').toLowerCase();
            const classMap = {
                paid: 'status-paid',
                pending: 'status-pending',
                overdue: 'status-overdue',
                active: 'status-active',
                completed: 'status-completed',
                defaulted: 'status-defaulted'
            };
            const pillClass = classMap[normalized] || 'status-pending';
            return '<span class="status-pill ' + pillClass + '">' + escapeHtml(status || 'Pending') + '</span>';
        }

        function buildDetailRows(items) {
            return items.map(item => `
                <div class="detail-row">
                    <div class="detail-label">${escapeHtml(item.label)}</div>
                    <div class="detail-value">${item.value}</div>
                </div>
            `).join('');
        }

        function setLoanContext(nextLoanId) {
            loanId = nextLoanId ? String(nextLoanId).trim() : '';
            $('#loanLookupInput').val(loanId);

            const nextUrl = new URL(window.location.href);
            if (loanId) {
                nextUrl.searchParams.set('loan_id', loanId);
            } else {
                nextUrl.searchParams.delete('loan_id');
            }
            window.history.replaceState({}, '', nextUrl.toString());
        }

        function renderAwaitingLoanSelection() {
            currentLoan = null;
            currentSchedule = [];

            $('#statementHero').html(`
                <div class="title">Loan statement workspace</div>
                <div class="meta">Enter a loan ID above to load the statement and payment schedule.</div>
            `);
            $('#summaryCards').html(`
                <div class="metric-card"><div class="metric-label">Status</div><div class="metric-value">Awaiting loan</div></div>
                <div class="metric-card"><div class="metric-label">Outstanding</div><div class="metric-value">-</div></div>
                <div class="metric-card"><div class="metric-label">Installments</div><div class="metric-value">-</div></div>
                <div class="metric-card"><div class="metric-label">Repayment</div><div class="metric-value">-</div></div>
            `);
            $('#loanDetails').html('<div class="empty-state">Enter a loan ID to view statement details.</div>');
            $('#repaymentSnapshot').html('<div class="empty-state">Enter a loan ID to view repayment progress.</div>');

            if (scheduleTableInstance) {
                scheduleTableInstance.destroy();
                scheduleTableInstance = null;
            }

            $('#scheduleBody').html('<tr><td colspan="9" class="empty-state">Enter a loan ID to view the payment schedule.</td></tr>');
        }

        function renderHero(loan, scheduleStats) {
            $('#statementHero').html(`
                <div class="title">Loan #${escapeHtml(loan.id)} statement for ${escapeHtml(loan.member_name)}</div>
                <div class="meta">
                    Disbursed ${escapeHtml(formatDate(loan.disbursement_date))} •
                    Term ${escapeHtml(loan.loan_term_months)} months •
                    ${escapeHtml(scheduleStats.paidCount)} of ${escapeHtml(scheduleStats.totalCount)} installments paid
                </div>
            `);
        }

        function renderSummaryCards(loan, scheduleStats) {
            const totalPaid = scheduleStats.totalPaid;
            const outstanding = scheduleStats.totalExpectedPayment - totalPaid;

            $('#summaryCards').html(`
                <div class="metric-card">
                    <div class="metric-label">Loan Status</div>
                    <div class="metric-value">${formatStatusPill(loan.status)}</div>
                    <div class="metric-sub">Interest method: ${escapeHtml((loan.interest_method || 'reducing_balance').replace(/_/g, ' '))}</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Current Exposure</div>
                    <div class="metric-value">${formatCurrency(Number(loan.balance || 0) + Number(loan.accumulated_interest || 0))}</div>
                    <div class="metric-sub">Principal ${formatCurrency(loan.balance)} + interest ${formatCurrency(loan.accumulated_interest)}</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Installments</div>
                    <div class="metric-value">${scheduleStats.paidCount}/${scheduleStats.totalCount}</div>
                    <div class="metric-sub">${scheduleStats.pendingCount} pending • ${scheduleStats.overdueCount} overdue</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Recovered So Far</div>
                    <div class="metric-value">${formatCurrency(totalPaid)}</div>
                    <div class="metric-sub">Unpaid scheduled amount ${formatCurrency(outstanding)}</div>
                </div>
            `);
        }

        function renderLoanDetails(loan) {
            $('#loanDetails').html(buildDetailRows([
                { label: 'Loan ID', value: escapeHtml(loan.id) },
                { label: 'Member', value: escapeHtml(loan.member_name) },
                { label: 'Member ID', value: escapeHtml(loan.member_id) },
                { label: 'Disbursement Date', value: escapeHtml(formatDate(loan.disbursement_date)) },
                { label: 'Maturity Date', value: escapeHtml(formatDate(loan.maturity_date)) },
                { label: 'Term', value: escapeHtml(loan.loan_term_months + ' months') },
                { label: 'Interest Rate', value: escapeHtml((Number(loan.interest_rate || 0)).toLocaleString('en-UG', { maximumFractionDigits: 2 }) + '% p.a.') },
                { label: 'Monthly Payment', value: escapeHtml(formatCurrency(loan.monthly_payment)) },
                { label: 'Loan Amount', value: escapeHtml(formatCurrency(loan.loan_amount)) },
                { label: 'Status', value: formatStatusPill(loan.status) }
            ]));
        }

        function renderRepaymentSnapshot(loan, scheduleStats) {
            const totalPaid = scheduleStats.totalPaid;
            const totalExpected = scheduleStats.totalExpectedPayment;
            const totalExpectedInterest = scheduleStats.totalExpectedInterest;
            const totalExpectedPrincipal = scheduleStats.totalExpectedPrincipal;

            $('#repaymentSnapshot').html(buildDetailRows([
                { label: 'Total Scheduled Repayment', value: escapeHtml(formatCurrency(totalExpected)) },
                { label: 'Scheduled Principal', value: escapeHtml(formatCurrency(totalExpectedPrincipal)) },
                { label: 'Scheduled Interest', value: escapeHtml(formatCurrency(totalExpectedInterest)) },
                { label: 'Amount Paid', value: '<span style="color:#2f855a;">' + escapeHtml(formatCurrency(totalPaid)) + '</span>' },
                { label: 'Outstanding Principal', value: '<span style="color:#2b6cb0;">' + escapeHtml(formatCurrency(loan.balance)) + '</span>' },
                { label: 'Accumulated Interest', value: '<span style="color:#c05621;">' + escapeHtml(formatCurrency(loan.accumulated_interest)) + '</span>' },
                { label: 'Total Loan Interest Posted', value: escapeHtml(formatCurrency(loan.total_interest)) },
                { label: 'Total Repayment Figure', value: escapeHtml(formatCurrency(loan.total_repayment)) },
                { label: 'Processing Fee', value: escapeHtml(formatCurrency(loan.processing_fee_amount || 0)) },
                { label: 'Net Disbursement', value: escapeHtml(formatCurrency(loan.net_disbursement || loan.loan_amount)) }
            ]));
        }

        function getScheduleStats(schedule) {
            return schedule.reduce((stats, item) => {
                const expectedPayment = Number(item.expected_payment || 0);
                const expectedPrincipal = Number(item.expected_principal || 0);
                const expectedInterest = Number(item.expected_interest || 0);
                const paidAmount = Number(item.paid_amount || 0);
                const status = String(item.status || '').toLowerCase();

                stats.totalCount += 1;
                stats.totalExpectedPayment += expectedPayment;
                stats.totalExpectedPrincipal += expectedPrincipal;
                stats.totalExpectedInterest += expectedInterest;
                stats.totalPaid += paidAmount;

                if (status === 'paid') stats.paidCount += 1;
                if (status === 'pending') stats.pendingCount += 1;
                if (status === 'overdue') stats.overdueCount += 1;

                return stats;
            }, {
                totalCount: 0,
                totalExpectedPayment: 0,
                totalExpectedPrincipal: 0,
                totalExpectedInterest: 0,
                totalPaid: 0,
                paidCount: 0,
                pendingCount: 0,
                overdueCount: 0
            });
        }

        function buildScheduleRows(schedule) {
            if (!schedule.length) {
                return `
                    <tr>
                        <td colspan="9" class="empty-state">No payment schedule found for this loan.</td>
                    </tr>
                `;
            }

            let totalExpectedPayment = 0;
            let totalExpectedPrincipal = 0;
            let totalExpectedInterest = 0;
            let totalPaid = 0;

            const rows = schedule.map(item => {
                const expectedPayment = Number(item.expected_payment || 0);
                const expectedPrincipal = Number(item.expected_principal || 0);
                const expectedInterest = Number(item.expected_interest || 0);
                const paidAmount = Number(item.paid_amount || 0);
                const balance = Math.max(0, expectedPayment - paidAmount);

                totalExpectedPayment += expectedPayment;
                totalExpectedPrincipal += expectedPrincipal;
                totalExpectedInterest += expectedInterest;
                totalPaid += paidAmount;

                return `
                    <tr>
                        <td>${escapeHtml(item.payment_number)}</td>
                        <td>${escapeHtml(formatDate(item.due_date))}</td>
                        <td class="text-right">${escapeHtml(formatCurrency(expectedPayment))}</td>
                        <td class="text-right">${escapeHtml(formatCurrency(expectedPrincipal))}</td>
                        <td class="text-right">${escapeHtml(formatCurrency(expectedInterest))}</td>
                        <td class="text-right">${escapeHtml(formatCurrency(paidAmount))}</td>
                        <td class="text-right">${escapeHtml(formatCurrency(balance))}</td>
                        <td>${formatStatusPill(item.status)}</td>
                        <td>${escapeHtml(formatDate(item.paid_date))}</td>
                    </tr>
                `;
            }).join('');

            return rows + `
                <tr style="font-weight:700;background:#edfdf8;">
                    <td colspan="2">Totals</td>
                    <td class="text-right">${escapeHtml(formatCurrency(totalExpectedPayment))}</td>
                    <td class="text-right">${escapeHtml(formatCurrency(totalExpectedPrincipal))}</td>
                    <td class="text-right">${escapeHtml(formatCurrency(totalExpectedInterest))}</td>
                    <td class="text-right">${escapeHtml(formatCurrency(totalPaid))}</td>
                    <td class="text-right">${escapeHtml(formatCurrency(totalExpectedPayment - totalPaid))}</td>
                    <td colspan="2"></td>
                </tr>
            `;
        }

        function renderSchedule(schedule) {
            $('#scheduleBody').html(buildScheduleRows(schedule));

            if (scheduleTableInstance) {
                scheduleTableInstance.destroy();
            }

            scheduleTableInstance = $('#scheduleTable').DataTable({
                order: [[0, 'asc']],
                pageLength: 12,
                lengthMenu: [[12, 25, 50, -1], [12, 25, 50, 'All']],
                scrollX: true,
                autoWidth: false,
                columnDefs: [
                    { targets: [2, 3, 4, 5, 6], className: 'text-right' },
                    { orderable: false, targets: [7] }
                ],
                dom: '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>'
            });
        }

        function createExcelExport() {
            if (!currentLoan || !currentSchedule.length) {
                alert('Loan statement is still loading.');
                return;
            }

            const rows = currentSchedule.map(item => ({
                'Payment #': item.payment_number,
                'Due Date': formatDate(item.due_date),
                'Expected Payment': Number(item.expected_payment || 0),
                'Expected Principal': Number(item.expected_principal || 0),
                'Expected Interest': Number(item.expected_interest || 0),
                'Amount Paid': Number(item.paid_amount || 0),
                'Balance': Math.max(0, Number(item.expected_payment || 0) - Number(item.paid_amount || 0)),
                'Status': item.status || '',
                'Paid Date': formatDate(item.paid_date)
            }));

            let tableHtml = `
                <table>
                    <tr><th colspan="2">Loan Statement</th></tr>
                    <tr><td>Loan ID</td><td>${escapeHtml(currentLoan.id)}</td></tr>
                    <tr><td>Member</td><td>${escapeHtml(currentLoan.member_name)}</td></tr>
                    <tr><td>Loan Amount</td><td>${escapeHtml(formatCurrency(currentLoan.loan_amount))}</td></tr>
                    <tr><td>Interest Rate</td><td>${escapeHtml(currentLoan.interest_rate)}%</td></tr>
                    <tr><td>Term</td><td>${escapeHtml(currentLoan.loan_term_months)} months</td></tr>
                    <tr><td>Status</td><td>${escapeHtml(currentLoan.status)}</td></tr>
                </table>
                <br />
                <table border="1">
                    <thead>
                        <tr>
                            <th>Payment #</th>
                            <th>Due Date</th>
                            <th>Expected Payment</th>
                            <th>Expected Principal</th>
                            <th>Expected Interest</th>
                            <th>Amount Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th>Paid Date</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            rows.forEach(row => {
                tableHtml += `
                    <tr>
                        <td>${escapeHtml(row['Payment #'])}</td>
                        <td>${escapeHtml(row['Due Date'])}</td>
                        <td>${escapeHtml(row['Expected Payment'])}</td>
                        <td>${escapeHtml(row['Expected Principal'])}</td>
                        <td>${escapeHtml(row['Expected Interest'])}</td>
                        <td>${escapeHtml(row['Amount Paid'])}</td>
                        <td>${escapeHtml(row['Balance'])}</td>
                        <td>${escapeHtml(row['Status'])}</td>
                        <td>${escapeHtml(row['Paid Date'])}</td>
                    </tr>
                `;
            });

            tableHtml += '</tbody></table>';

            const blob = new Blob(['\ufeff' + tableHtml], {
                type: 'application/vnd.ms-excel'
            });

            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `loan-statement-${currentLoan.id}.xls`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);
        }

        function printStatementPdf() {
            if (!currentLoan || !currentSchedule.length) {
                alert('Loan statement is still loading.');
                return;
            }

            const printWindow = window.open('', '_blank', 'width=1200,height=800');
            if (!printWindow) {
                alert('Please allow popups to print the statement.');
                return;
            }

            const summaryCardsHtml = document.getElementById('summaryCards').innerHTML;
            const loanDetailsHtml = document.getElementById('loanDetails').innerHTML;
            const repaymentSnapshotHtml = document.getElementById('repaymentSnapshot').innerHTML;
            const scheduleTableHtml = document.getElementById('scheduleTable').outerHTML;

            printWindow.document.write(`
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <title>Loan Statement #${escapeHtml(currentLoan.id)}</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 24px; color: #1a1f2e; }
                        h1 { margin: 0 0 6px; font-size: 24px; }
                        .meta { color: #4a5568; margin-bottom: 18px; font-size: 13px; }
                        .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 18px; }
                        .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
                        .card { border: 1px solid #dfe6ee; border-radius: 8px; padding: 12px; }
                        .label { font-size: 11px; text-transform: uppercase; color: #718096; font-weight: 700; margin-bottom: 8px; }
                        .value { font-size: 16px; font-weight: 700; }
                        .detail-row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid #edf2f7; font-size: 12px; }
                        .detail-row:last-child { border-bottom: none; }
                        .status-pill { display: inline-block; padding: 4px 8px; border-radius: 999px; font-size: 11px; font-weight: 700; }
                        .status-paid { background: rgba(56, 161, 105, .12); color: #2f855a; }
                        .status-pending { background: rgba(221, 107, 32, .14); color: #c05621; }
                        .status-overdue { background: rgba(229, 62, 62, .12); color: #c53030; }
                        .status-active { background: rgba(49, 130, 206, .12); color: #2b6cb0; }
                        .status-completed { background: rgba(56, 161, 105, .12); color: #2f855a; }
                        .status-defaulted { background: rgba(229, 62, 62, .12); color: #c53030; }
                        table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 12px; }
                        th, td { border: 1px solid #dfe6ee; padding: 7px 8px; text-align: left; }
                        th { background: #f7fafc; }
                        .text-right { text-align: right; }
                        .note { margin-top: 12px; border: 1px solid #bee3f8; background: #ebf8ff; color: #2c5282; padding: 10px 12px; border-radius: 8px; font-size: 12px; }
                    </style>
                </head>
                <body>
                    <h1>Loan Statement</h1>
                    <div class="meta">Loan #${escapeHtml(currentLoan.id)} • ${escapeHtml(currentLoan.member_name)} • Generated ${escapeHtml(formatDate(new Date().toISOString()))}</div>
                    <div class="grid4">${summaryCardsHtml}</div>
                    <div class="grid">
                        <div class="card">${loanDetailsHtml}</div>
                        <div class="card">${repaymentSnapshotHtml}</div>
                    </div>
                    ${scheduleTableHtml}
                    <div class="note">
                        Expected interest in the schedule reflects the planned structure at disbursement. For reducing-balance loans, actual interest accrues daily on the outstanding balance.
                    </div>
                </body>
                </html>
            `);

            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => {
                printWindow.print();
            }, 400);
        }

        function loadLoanStatement() {
            if (!loanId) {
                renderAwaitingLoanSelection();
                return;
            }

            $.ajax({
                url: '/loans/' + loanId + '/statement',
                type: 'GET',
                success: function(response) {
                    currentLoan = response.loan;
                    currentSchedule = Array.isArray(response.schedule) ? response.schedule : [];

                    const scheduleStats = getScheduleStats(currentSchedule);

                    renderHero(currentLoan, scheduleStats);
                    renderSummaryCards(currentLoan, scheduleStats);
                    renderLoanDetails(currentLoan);
                    renderRepaymentSnapshot(currentLoan, scheduleStats);
                    renderSchedule(currentSchedule);
                },
                error: function() {
                    currentLoan = null;
                    currentSchedule = [];
                    $('#statementHero').html(`
                        <div class="title">Unable to load statement</div>
                        <div class="meta">The selected loan could not be found or the request failed.</div>
                    `);
                    $('#loanDetails').html('<div class="empty-state">Error loading loan details.</div>');
                    $('#repaymentSnapshot').html('<div class="empty-state">Error loading repayment summary.</div>');
                    $('#scheduleBody').html('<tr><td colspan="9" class="empty-state">Error loading payment schedule.</td></tr>');
                    alert('Error loading loan statement');
                }
            });
        }

        $('#loadLoanBtn').on('click', function() {
            const enteredLoanId = ($('#loanLookupInput').val() || '').trim();
            if (!enteredLoanId) {
                alert('Enter a loan ID to continue.');
                $('#loanLookupInput').focus();
                return;
            }

            setLoanContext(enteredLoanId);
            loadLoanStatement();
        });

        $('#loanLookupInput').on('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                $('#loadLoanBtn').trigger('click');
            }
        });

        $('#refreshStatementBtn').on('click', function() {
            loadLoanStatement();
        });

        $('#exportExcelBtn').on('click', function() {
            createExcelExport();
        });

        $('#printPdfBtn').on('click', function() {
            printStatementPdf();
        });

        setLoanContext(loanId);
        loadLoanStatement();
    </script>
</body>
</html>
