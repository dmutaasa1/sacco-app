<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members - Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; }
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

/* ══════════════════════════════════════════
   BASE LAYOUT — matches admin dashboard
══════════════════════════════════════════ */
body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
.page-wrapper { 
    margin-left: 220px !important;
    margin-top: 60px; 
    width: calc(100% - 220px) !important; 
    max-width: 100%; 
    transition: margin-left .22s ease, width .22s ease;
}
body.sidebar-collapsed .page-wrapper { 
    margin-left: 60px !important; 
    width: calc(100% - 60px) !important; 
}
@media (max-width: 991px) {
    .page-wrapper { 
        margin-left: 0 !important; 
        width: 100% !important; 
        max-width: 100%; 
    }
    .page-heading { padding: 12px 14px 0; }
    .page-content { padding: 12px 14px 24px; }
}

/* ══════════════════════════════════════════
   PAGE HEADING
══════════════════════════════════════════ */
.page-heading {
    padding: 14px 22px 0;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
}
.page-heading h3 {
    font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0;
}
.page-heading .sub { font-size: .72rem; color: #a0aec0; margin-top: 2px; }

/* ══════════════════════════════════════════
   SHARED CARD
══════════════════════════════════════════ */
.ibox { margin-bottom: 0 !important; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 6px rgba(26,31,46,.06); border: 1px solid #eaeef2; }
.ibox-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border-bottom: 1px solid #eaeef2; background: #fff;
}
.ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
.ibox-body  { padding: 12px 14px; background: #fff; }

/* ══════════════════════════════════════════
   MEMBERS TABLE
══════════════════════════════════════════ */
.members-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
#members-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .72rem;
}
#members-table th {
    font-size: .68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .4px; color: #a0aec0; padding: 8px 10px;
    border-bottom: 2px solid #eaeef2; background: #fafbfc; white-space: nowrap;
}
#members-table td {
    font-size: .74rem; padding: 8px 10px;
    border-bottom: 1px solid #f0f4f8; color: #444; vertical-align: middle;
}
#members-table tr:last-child td { border-bottom: none; }
@media (max-width: 600px) { #members-table .hide-sm { display: none; } }

/* Status badge */
.badge-status { font-size: .66rem; padding: 3px 10px; border-radius: 12px; font-weight: 600; }
.badge-active   { background: #e6faf4; color: #00b894; }
.badge-disabled { background: #fff5f5; color: #e53e3e; }

/* Action buttons */
.btn-action { 
    font-size: .7rem; 
    padding: 4px 10px; 
    border-radius: 5px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    transition: all .15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
}
.btn-view { 
    background: #e3f2fd; 
    color: #1565c0;
}
.btn-edit { 
    background: #fff3e0; 
    color: #e65100;
}
.btn-view:hover { 
    background: #bbdefb; 
    color: #0d47a1;
}
.btn-edit:hover { 
    background: #ffe0b2; 
    color: #bf360c;
    text-decoration: none;
}

/* DataTables toolbar */
.dataTables_wrapper .dataTables_filter input {
    font-size: .75rem;
    padding: 5px 12px;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    background: #fff;
}
.dataTables_wrapper .dataTables_length select {
    font-size: .75rem;
    padding: 5px 8px;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    background: #fff;
}
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_length { margin-bottom: 8px; }
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_paginate { font-size: .72rem; margin-top: 8px; }
.dataTables_wrapper .paginate_button {
    padding: 4px 8px !important;
    font-size: .72rem !important;
    border-radius: 4px;
    margin: 0 2px;
}
.dataTables_wrapper .paginate_button.current {
    background: #00b894 !important;
    border-color: #00b894 !important;
}

/* Mobile card layout (hidden on desktop) */
.member-cards { display: none; }
.member-card {
    background: #fff;
    border: 1px solid #eaeef2;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 10px;
    font-size: .75rem;
    box-shadow: 0 1px 3px rgba(26,31,46,.06);
}
.member-card .member-name { 
    font-weight: 700; 
    font-size: .9rem; 
    color: #1a1f2e;
    margin-bottom: 4px;
}
.member-card .member-meta { 
    color: #a0aec0; 
    font-size: .68rem; 
    margin-bottom: 8px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.member-card .member-actions { 
    display: flex; 
    gap: 6px;
    margin-top: 8px;
}
.member-card .member-status {
    display: inline-block;
    margin-left: auto;
}

/* Top bar: search + add button */
.members-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
}
.members-topbar .search-box {
    flex: 1;
    min-width: 160px;
    max-width: 300px;
    position: relative;
}
.members-topbar .search-box input {
    width: 100%;
    padding: 6px 12px 6px 32px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    font-size: .75rem;
    outline: none;
    background: #fff;
}
.members-topbar .search-box input::placeholder {
    color: #a0aec0;
}
.members-topbar .search-box .fa {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #a0aec0;
    font-size: .75rem;
}
.btn-add-member {
    font-size: .75rem;
    padding: 6px 14px;
    border-radius: 6px;
    white-space: nowrap;
    font-weight: 600;
    background: #00b894;
    color: #fff;
    border: none;
    cursor: pointer;
    transition: all .15s;
}
.btn-add-member:hover {
    background: #00a388;
    text-decoration: none;
    color: #fff;
}
.btn-add-member i { margin-right: 4px; }

/* Page content */
.page-content { padding: 12px 22px 24px; }

/* Footer */
.page-footer {
    padding: 12px 22px;
    font-size: .72rem;
    color: #a0aec0;
    text-align: center;
    border-top: 1px solid #eaeef2;
    background: #fff;
}

@media (max-width: 768px) {
    /* Hide desktop table, show cards */
    .table-wrapper { display: none !important; }
    .member-cards { display: block; }
    .page-content { padding: 12px 14px 20px; }
}

@media (min-width: 769px) {
    /* On desktop, hide card controls (search handled by DataTables) */
    .mobile-search { display: none; }
}
</style>
</head>

<body>
<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="page-wrapper">
    <div class="page-heading">
        <div>
            <h3><i class="fa fa-users" style="margin-right: 8px; color: #00b894;"></i>Members Directory</h3>
        </div>
    </div>

    <div class="page-content">
        <div class="ibox">
            <div class="ibox-head">
                <span class="ibox-title"><i class="fa fa-list" style="color: #00b894; margin-right: 5px;"></i>Members List</span>
                <a href="/member_add" class="btn-add-member" style="margin: 0;">
                    <i class="fa fa-plus"></i> Add Member
                </a>
            </div>

            <div class="ibox-body">

                <!-- ── MOBILE: search + cards ── -->
                <div class="member-cards">
                    <div class="members-topbar mobile-search">
                        <div class="search-box">
                            <i class="fa fa-search"></i>
                            <input type="text" id="card-search" placeholder="Search members…">
                        </div>
                    </div>

                    <div id="card-list">
                    <% users.forEach(member => { %>
                        <div class="member-card" data-name="<%= (member.First_Name + ' ' + member.Middle_Name + ' ' + member.Last_Name).toLowerCase() %>" data-phone="<%= member.tel_no %>">
                            <div class="d-flex justify-content-between align-items-start">
                                <div style="flex: 1;">
                                    <div class="member-name">#<%= member.id %> — <%= member.First_Name %> <%= member.Middle_Name %> <%= member.Last_Name %></div>
                                    <div class="member-meta">
                                        <span><i class="fa fa-phone"></i> <%= member.tel_no %></span>
                                        <span><i class="fa fa-venus-mars"></i> <%= member.sex %></span>
                                        <span><i class="fa fa-map-marker"></i> <%= member.village_lc1 %></span>
                                    </div>
                                </div>
                                <span class="badge-status <%= member.Status && member.Status.toUpperCase() === 'ACTIVE' ? 'badge-active' : 'badge-disabled' %>" style="white-space: nowrap; margin-left: 8px;">
                                    <%= member.Status %>
                                </span>
                            </div>
                            <div class="member-actions">
                                <a href="/members/<%= member.id %>" class="btn btn-action btn-view"><i class="fa fa-eye"></i> View</a>
                                <a href="/members/<%= member.id %>/edit" class="btn btn-action btn-edit"><i class="fa fa-pencil"></i> Edit</a>
                            </div>
                        </div>
                    <% }) %>
                    </div>

                    <div id="no-results" style="display:none; text-align:center; padding:20px; color:#a0aec0; font-size:0.85rem;">
                        No members found.
                    </div>
                </div>

                <!-- ── DESKTOP: DataTable ── -->
                <div class="members-table-wrap">
                    <table class="table table-striped table-hover" id="members-table" width="100%">
                        <thead>
                            <tr>
                                <th style="width:8%;">#</th>
                                <th style="width:25%;">Name</th>
                                <th style="width:15%;">Phone</th>
                                <th class="hide-sm" style="width:10%;">Gender</th>
                                <th class="hide-sm" style="width:15%;">Village</th>
                                <th style="width:12%;">Status</th>
                                <th style="width:15%;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% users.forEach(member => { %>
                            <tr>
                                <td><%= member.id %></td>
                                <td style="font-weight: 600;"><%= member.First_Name %> <%= member.Middle_Name %> <%= member.Last_Name %></td>
                                <td><%= member.tel_no %></td>
                                <td class="hide-sm"><%= member.sex %></td>
                                <td class="hide-sm"><%= member.village_lc1 %></td>
                                <td>
                                    <span class="badge-status <%= member.Status && member.Status.toUpperCase() === 'ACTIVE' ? 'badge-active' : 'badge-disabled' %>">
                                        <%= member.Status %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/members/<%= member.id %>" class="btn btn-action btn-view"><i class="fa fa-eye"></i> View</a>
                                    <a href="/members/<%= member.id %>/edit" class="btn btn-action btn-edit"><i class="fa fa-pencil"></i> Edit</a>
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>

    <footer class="page-footer">
        <div>2026 © <b>Agali Awamu SACCO</b> — All rights reserved.</div>
    </footer>
</div>

<!-- Backdrops -->
<div class="sidenav-backdrop backdrop"></div>
<div class="preloader-backdrop"><div class="page-preloader">Loading</div></div>

<!-- Scripts -->
<script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
<script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
<script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
<script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
<script src="/assets/vendors/DataTables/datatables.min.js"></script>
<script src="/assets/js/app.min.js"></script>
<script>
$(function () {
    // Desktop DataTable
    $('#members-table').DataTable({
        pageLength: 25,
        order: [[0, 'desc']],
        columnDefs: [{ targets: [3, 4], visible: $(window).width() > 992 }],
        language: {
            search: '',
            searchPlaceholder: 'Search…',
            lengthMenu: 'Show _MENU_',
            info: '_START_–_END_ of _TOTAL_',
            paginate: { previous: '‹', next: '›' }
        }
    });

    // Mobile card search
    $('#card-search').on('input', function () {
        const q = $(this).val().toLowerCase();
        let visible = 0;
        $('#card-list .member-card').each(function () {
            const match = $(this).data('name').includes(q) || $(this).data('phone').includes(q);
            $(this).toggle(match);
            if (match) visible++;
        });
        $('#no-results').toggle(visible === 0);
    });
});
</script>
</body>
</html>
