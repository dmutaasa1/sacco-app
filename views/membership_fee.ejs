<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Membership Fee Status — Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading { padding: 14px 22px 0; }
        .page-heading h3 { font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0; }
        .page-subtitle { margin-top: 4px; color: #718096; font-size: .78rem; }
        .page-content { padding: 12px 22px 24px; }

        .hero-strip {
            background: linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(14, 165, 233, 0.16);
        }
        .hero-strip .title { font-size: 1rem; font-weight: 700; margin-bottom: 4px; }
        .hero-strip .meta { font-size: .78rem; opacity: .92; }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (max-width: 767px) { .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 575px) { .summary-grid { grid-template-columns: 1fr; } }

        .metric-card {
            background: #fff;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            padding: 14px;
            min-height: 104px;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
        }
        .metric-label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #718096; margin-bottom: 10px; }
        .metric-value { font-size: 1rem; font-weight: 700; color: #1a1f2e; line-height: 1.35; }
        .metric-sub { margin-top: 6px; font-size: .72rem; color: #718096; }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head { padding: 12px 14px; border-bottom: 1px solid #eaeef2; background: #fff; }
        .ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
        .ibox-body { padding: 14px; background: #fff; }

        .filters-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            align-items: end;
        }
        @media (max-width: 991px) { .filters-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 575px) { .filters-grid { grid-template-columns: 1fr; } }

        .form-control { font-size: .75rem; border-radius: 6px; min-height: 38px; }
        .btn { font-size: .75rem; font-weight: 600; padding: 7px 16px; border-radius: 6px; }
        .btn-primary { background: #0ea5e9; border: none; }
        .btn-primary:hover { background: #0284c7; }

        #paymentStatusTable { font-size: .75rem; }
        #paymentStatusTable thead th { font-weight: 700; background: #f7fafc; color: #1a1f2e; border-bottom: 2px solid #eaeef2; }
        
        .badge-pill { padding: 4px 10px; font-weight: 700; font-size: .65rem; border-radius: 6px; }
        .bg-success-light { background: #e6faf4; color: #00b894; }
        .bg-danger-light { background: #fff5f5; color: #e53e3e; }
    </style>
</head>

<body class="fixed-navbar">
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <h3><i class="fa fa-id-card-o" style="color: #0ea5e9; margin-right: 8px;"></i>Membership Fee Status</h3>
            <div class="page-subtitle">Track registration and annual membership fee compliance across the SACCO.</div>
        </div>

        <div class="page-content">
            <div class="hero-strip">
                <div class="title">Compliance Overview</div>
                <div class="meta">Filter by year and payment status to identify members with outstanding arrears.</div>
            </div>

            <div class="summary-grid">
                <div class="metric-card">
                    <div class="metric-label">Members Loaded</div>
                    <div class="metric-value" id="membersCount">-</div>
                    <div class="metric-sub">Total under current filters</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Total Collected</div>
                    <div class="metric-value" id="totalFees">-</div>
                    <div class="metric-sub">Membership fees received</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Fully Paid</div>
                    <div class="metric-value" id="paidCount" style="color: #00b894;">-</div>
                    <div class="metric-sub">Compliant members</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Pending Arrears</div>
                    <div class="metric-value" id="pendingCount" style="color: #e53e3e;">-</div>
                    <div class="metric-sub">Non-compliant members</div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Filter Criteria</div>
                </div>
                <div class="ibox-body">
                    <div class="filters-grid">
                        <div class="form-group mb-0">
                            <label>Payment Period</label>
                            <select id="payment_period" class="form-control">
                                <option value="">-- All Years --</option>
                                <% for(let y=2024; y<=2030; y++) { %>
                                    <option value="<%= y %>" <%= y===2026 ? 'selected' : '' %>><%= y %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label>Member Status</label>
                            <select id="memberStatus" class="form-control">
                                <option value="ACTIVE" selected>Active</option>
                                <option value="INACTIVE">Inactive</option>
                                <option value="SUSPENDED">Suspended</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label>Payment Status</label>
                            <select id="paymentStatus" class="form-control">
                                <option value="">-- All Statuses --</option>
                                <option value="Paid">Paid</option>
                                <option value="Not Paid">Not Paid</option>
                            </select>
                        </div>
                        <button id="filterBtn" class="btn btn-primary btn-block">
                            <i class="fa fa-refresh mr-2"></i> Update Report
                        </button>
                    </div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-body">
                    <div class="table-responsive">
                        <table id="paymentStatusTable" class="table table-striped table-bordered table-hover" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Phone</th>
                                    <th>Date Joined</th>
                                    <th>Status</th>
                                    <th>Total (UGX)</th>
                                    <th>Last Date</th>
                                    <th>Period</th>
                                    <th>Payment Status</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <script>
        function updateSummaryCards(data) {
            let total = 0;
            let paid = 0;
            let pending = 0;
            
            data.forEach(r => {
                total += parseFloat(r.Total_Amount || 0);
                if (r.Payment_Status === 'Paid') paid++;
                else pending++;
            });

            $('#membersCount').text(data.length);
            $('#totalFees').text('UGX ' + total.toLocaleString());
            $('#paidCount').text(paid);
            $('#pendingCount').text(pending);
        }

        $(document).ready(function () {
            const table = $('#paymentStatusTable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                pageLength: 25,
                ajax: {
                    url: '/membership_fee/payment-status',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        return JSON.stringify({
                            ...d,
                            payment_period: $('#payment_period').val(),
                            memberStatus: $('#memberStatus').val(),
                            paymentStatus: $('#paymentStatus').val()
                        });
                    },
                    dataSrc: function (json) {
                        updateSummaryCards(json.data);
                        return json.data;
                    },
                    error: function(xhr, error, thrown) {
                        alert('Error: ' + (xhr.responseJSON?.error || 'Could not load data.'));
                    }
                },
                columns: [
                    { data: 'member_id' },
                    { data: 'First_name' },
                    { data: 'Last_Name' },
                    { data: 'tel_no' },
                    { 
                        data: 'Date_Joined',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('en-GB') : '';
                        }
                    },
                    { 
                        data: 'Status',
                        className: 'text-center',
                        render: function (data) {
                            const cls = data === 'Active' ? 'bg-success-light' : 'bg-danger-light';
                            return `<span class="badge-pill ${cls}">${data}</span>`;
                        }
                    },
                    { 
                        data: 'Total_Amount',
                        render: function (data) {
                            return `<strong>${parseInt(data, 10).toLocaleString()}</strong>`;
                        }
                    },
                    { 
                        data: 'last_payment_date',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('en-GB') : 'N/A';
                        }
                    },
                    { data: 'last_payment_period', className: 'text-center' },
                    { 
                        data: 'Payment_Status',
                        className: 'text-center',
                        render: function (data) {
                            const cls = data === 'Paid' ? 'bg-success-light' : 'bg-danger-light';
                            return `<span class="badge-pill ${cls}">${data}</span>`;
                        }
                    }
                ]
            });

            // Reload table when filter button clicked
            $('#filterBtn').on('click', function () {
                table.ajax.reload();
            });
        });
    </script>
</body>

</html>