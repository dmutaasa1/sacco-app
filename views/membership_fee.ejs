    <script>
        function updateSummaryCards(data) {
            let total = 0;
            let paid = 0;
            let pending = 0;
            
            data.forEach(r => {
                total += parseFloat(r.Total_Amount || 0);
                if (r.Payment_Status === 'Paid') paid++;
                else pending++;
            });

            $('#membersCount').text(data.length);
            $('#totalFees').text('UGX ' + total.toLocaleString());
            $('#paidCount').text(paid);
            $('#pendingCount').text(pending);
        }

        $(document).ready(function () {
            const table = $('#paymentStatusTable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                pageLength: 25,
                ajax: {
                    url: '/membership_fee/payment-status',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        return JSON.stringify({
                            ...d,
                            payment_period: $('#payment_period').val(),
                            memberStatus: $('#memberStatus').val(),
                            paymentStatus: $('#paymentStatus').val()
                        });
                    },
                    dataSrc: function (json) {
                        updateSummaryCards(json.data);
                        return json.data;
                    },
                    error: function(xhr, error, thrown) {
                        alert('Error: ' + (xhr.responseJSON?.error || 'Could not load data.'));
                    }
                },
                columns: [
                    { data: 'member_id' },
                    { data: 'First_name' },
                    { data: 'Last_Name' },
                    { data: 'tel_no' },
                    { 
                        data: 'Date_Joined',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('en-GB') : '';
                        }
                    },
                    { 
                        data: 'Status',
                        className: 'text-center',
                        render: function (data) {
                            const color = data === 'Active' ? 'green' : 'red';
                            return `<span style="color:${color}; font-weight:bold;">${data}</span>`;
                            const cls = data === 'Active' ? 'bg-success-light' : 'bg-danger-light';
                            return `<span class="badge-pill ${cls}">${data}</span>`;
                        }
                    },
                    { 
                        data: 'Total_Amount',
                        render: function (data) {
                            return `UGX ${parseInt(data, 10).toLocaleString()}`;
                            return `<strong>${parseInt(data, 10).toLocaleString()}</strong>`;
                        }
                    },
                    { 
                        data: 'last_payment_date',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('en-GB') : 'N/A';
                        }
                    },
                    { data: 'last_payment_period' },
                    { data: 'last_payment_period', className: 'text-center' },
                    { 
                        data: 'Payment_Status',
                        className: 'text-center',
                        render: function (data) {
                            const color = data === 'Paid' ? 'green' : 'red';
                            const icon = data === 'Paid' ? '✓' : '✗';
                            return `<span style="color:${color}; font-weight:bold;">${icon} ${data}</span>`;
                            const cls = data === 'Paid' ? 'bg-success-light' : 'bg-danger-light';
                            return `<span class="badge-pill ${cls}">${data}</span>`;
                        }
                    }
                ]
            });

            // Reload table when filter button clicked
            $('#filterBtn').on('click', function () {
                table.ajax.reload();
            });
        });
    </script>
