<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transactions - Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<style>
* { box-sizing: border-box; }
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

/* ══════════════════════════════════════════
   BASE LAYOUT — matches dashboard
══════════════════════════════════════════ */
body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
.page-wrapper { 
    margin-left: 220px !important;
    margin-top: 60px; 
    width: calc(100% - 220px) !important; 
    max-width: 100%; 
    transition: margin-left .22s ease, width .22s ease;
}
body.sidebar-collapsed .page-wrapper { 
    margin-left: 60px !important; 
    width: calc(100% - 60px) !important; 
}
@media (max-width: 991px) {
    .page-wrapper { 
        margin-left: 0 !important; 
        width: 100% !important; 
        max-width: 100%; 
    }
    .page-heading { padding: 12px 14px 0; }
    .page-content { padding: 12px 14px 24px; }
}

/* PAGE HEADING */
.page-heading {
    padding: 14px 22px 0;
}
.page-heading h3 {
    font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0;
}

/* SHARED CARD */
.ibox { margin-bottom: 0 !important; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 6px rgba(26,31,46,.06); border: 1px solid #eaeef2; }
.ibox-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border-bottom: 1px solid #eaeef2; background: #fff;
}
.ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
.ibox-body  { padding: 14px; background: #fff; }

/* FORM STYLING */
.form-group { margin-bottom: 10px; }
.form-group label {
    font-size: .75rem;
    font-weight: 600;
    color: #1a1f2e;
    margin-bottom: 5px;
    display: block;
}
.form-control, .form-select {
    font-size: .75rem;
    padding: 6px 10px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    background: #fff;
    height: auto;
}
.form-control:focus, .form-select:focus {
    border-color: #00b894;
    box-shadow: 0 0 0 3px rgba(0, 184, 148, 0.1);
}

/* BUTTONS */
.btn {
    font-size: .75rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 6px;
    transition: all .15s;
}
.btn-primary {
    background: #00b894;
    color: #fff;
    border: none;
}
.btn-primary:hover {
    background: #00a388;
    color: #fff;
}

.page-content { padding: 12px 22px 24px; }

.page-footer {
    padding: 12px 22px;
    font-size: .72rem;
    color: #a0aec0;
    text-align: center;
    border-top: 1px solid #eaeef2;
    background: #fff;
}

/* FILTER SECTION */
.filter-section {
    background: #fff;
    padding: 14px;
    border-radius: 8px;
    margin-bottom: 14px;
    border: 1px solid #eaeef2;
}

.filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
    margin-bottom: 10px;
}

@media (max-width: 768px) {
    .filter-grid { grid-template-columns: 1fr; }
}

.filter-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

/* TABLE STYLING */
.dataTable { font-size: .75rem; }
.dataTable thead th {
    background: #f7fafc;
    color: #1a1f2e;
    font-weight: 700;
    border-color: #eaeef2;
    padding: 10px;
    white-space: nowrap;
}
.dataTable tbody td {
    padding: 10px;
    vertical-align: middle;
    border-color: #eaeef2;
    color: #1a1f2e;
}
.dataTable tbody tr:hover {
    background: #f7fafc;
}

/* DataTables Elements */
.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_paginate {
    font-size: .75rem;
    color: #718096;
}

.dataTables_wrapper .dataTables_paginate .paginate_button {
    padding: 4px 8px;
    margin: 2px;
    border-radius: 4px;
    border: 1px solid #eaeef2;
}

.dataTables_wrapper .dataTables_paginate .paginate_button.current {
    background: #00b894;
    border-color: #00b894;
    color: #fff !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
    background: #f0f0f0;
    border-color: #eaeef2;
}

/* Amount styling */
.amount-credit { color: #00b894; font-weight: 600; }
.amount-debit { color: #f56565; font-weight: 600; }

/* Status badges */
.badge-active { background: #c6f6d5; color: #22543d; }
.badge-inactive { background: #fed7d7; color: #742a2a; }
</style>
</head>

<body>
    <div class="page-wrapper">
        <!-- START HEADER-->         
        <%- include('partials/header') %>
        <!-- END HEADER-->
        <!-- START SIDEBAR-->
        <%- include('partials/sidebar') %>        
        <!-- END SIDEBAR-->
        
        <div class="page-heading">
            <h3><i class="fa fa-exchange" style="color: #00b894; margin-right: 8px;"></i>Transactions</h3>
        </div>
        
        <div class="page-content">
            <!-- Filters -->
            <div class="filter-section">
                <div style="font-size: .8rem; font-weight: 600; color: #1a1f2e; margin-bottom: 12px; display: flex; align-items: center;">
                    <i class="fa fa-filter" style="color: #00b894; margin-right: 6px;"></i> Filter Transactions
                </div>
                
                <div class="filter-grid">
                    <div class="form-group">
                        <label for="startDate">Start Date</label>
                        <input type="date" id="startDate" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="endDate">End Date</label>
                        <input type="date" id="endDate" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="memberId">Member ID</label>
                        <input type="text" id="memberId" class="form-control" placeholder="Enter member ID" />
                    </div>
                    <div class="form-group">
                        <label for="memberStatus">Status</label>
                        <select id="memberStatus" class="form-select">
                            <option value="">-- All --</option>
                            <option value="internal">Internal</option>
                            <option value="Member">Member</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="payment_period">Payment Period</label>
                        <select id="payment_period" class="form-select">
                            <option value="">-- All --</option>
                            <option value="2022">2022</option>
                            <option value="2023">2023</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="transaction_type">Transaction Type</label>
                        <select id="transaction_type" class="form-select">
                            <option value="">-- All --</option>
                            <option value="saving">Savings</option>
                            <option value="Insurance Fee">Insurance Fee</option>
                            <option value="Wellfare Fee">Welfare Fee</option>
                            <option value="Loan Disbursments">Loan Disbursements</option>
                            <option value="Loan Repayment">Loan Repayment</option>
                            <option value="Rental Income">Rental Income</option>
                            <option value="Other Income">Other Income</option>
                            <option value="Other Expense">Other Expense</option>
                        </select>
                    </div>
            </div>
        </div>
        
        <div class="page-footer">
            2026 © <strong>Agali Awamu SACCO</strong> — All rights reserved.
        </div>
    </div>

    <!-- CORE PLUGINS-->
    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize DataTable with safety check
            let table;
            
            function initializeTable() {
                if ($.fn.DataTable.isDataTable('#transactionsTable')) {
                    table = $('#transactionsTable').DataTable();
                } else {
                    table = $('#transactionsTable').DataTable({
                        processing: true,
                        serverSide: true,
                        searching: false,
                        paging: true,
                        ordering: true,
                        info: true,
                        lengthChange: true,
                        pageLength: 25,
                        ajax: {
                            url: '/transactions/filter',
                            type: 'POST',
                            contentType: 'application/json',
                            data: function (d) {
                                return JSON.stringify({
                                    ...d,
                                    startDate: $('#startDate').val(),
                                    endDate: $('#endDate').val(),
                                    memberStatus: $('#memberStatus').val(),
                                    memberId: $('#memberId').val(),
                                    transaction_type: $('#transaction_type').val(),
                                    payment_period: $('#payment_period').val()
                                });
                            },
                            error: function(xhr, error, thrown) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error Loading Data',
                                    text: xhr.responseJSON?.error || 'Could not load transactions',
                                    confirmButtonColor: '#00b894'
                                });
                            }
                        },
                        columnDefs: [
                            {
                                targets: 3, // Amount column
                                render: function (data, type, row) {
                                    const debitCredit = row.debit_credit ? row.debit_credit.toLowerCase() : '';
                                    const className = debitCredit === 'credit' ? 'amount-credit' : 'amount-debit';
                                    const symbol = debitCredit === 'credit' ? '+' : '-';
                                    return `<span class="${className}">${symbol} UGX ${parseInt(data || 0, 10).toLocaleString()}</span>`;
                                }
                            },
                            {
                                targets: 2, // Date column
                                render: function (data) {
                                    return data ? new Date(data).toLocaleDateString('en-GB') : '';
                                }
                            }
                        ],
                        columns: [
                            { data: 'id' },
                            { data: 'member_id' },
                            { data: 'tran_date' },
                            { data: 'Amount' },
                            { data: 'payment_period' },
                            { data: 'transaction_type' },
                            { data: 'description' },
                            { data: 'debit_credit' }
                        ]
                    });
                }
            }

            // Initialize table on page load
            initializeTable();

            // Reload table when filter button clicked
            $('#filterBtn').on('click', function () {
                if (table) {
                    table.ajax.reload();
                }
            });

            // Allow Enter key to trigger filter
            $('#startDate, #endDate, #memberId, #memberStatus, #payment_period, #transaction_type').on('keypress', function(e) {
                if (e.which === 13) {
                    $('#filterBtn').click();
                    return false;
                }
            });
        });
    </script>
</body>
</html>