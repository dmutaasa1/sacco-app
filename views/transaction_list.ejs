<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Transactions - Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading { padding: 14px 22px 0; }
        .page-heading h3 { font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0; }
        .page-subtitle { margin-top: 4px; color: #718096; font-size: .78rem; }
        .page-content { padding: 12px 22px 24px; }
        .page-footer { padding: 12px 22px; font-size: .72rem; color: #a0aec0; text-align: center; border-top: 1px solid #eaeef2; background: #fff; }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #eaeef2;
            background: #fff;
        }
        .ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
        .ibox-body { padding: 14px; background: #fff; }

        .btn {
            font-size: .75rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            transition: all .15s;
        }
        .btn-sm { padding: 5px 12px; font-size: .7rem; }
        .btn-primary { background: #00b894; color: #fff; border: none; }
        .btn-primary:hover { background: #00a388; color: #fff; }
        .btn-secondary { background: #edf2f7; color: #2d3748; border: none; }
        .btn-secondary:hover { background: #e2e8f0; color: #1a202c; }
        .btn-outline-primary { border: 1px solid #00b894; color: #00b894; background: #fff; }
        .btn-outline-primary:hover { background: #00b894; color: #fff; }

        .hero-strip {
            background: linear-gradient(135deg, #00b894 0%, #008f76 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(0, 184, 148, 0.16);
        }
        .hero-strip .title { font-size: 1rem; font-weight: 700; margin-bottom: 4px; }
        .hero-strip .meta { font-size: .78rem; opacity: .92; }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (max-width: 1199px) {
            .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 575px) {
            .summary-grid { grid-template-columns: 1fr; }
        }
        .metric-card {
            background: #fff;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            padding: 14px;
            min-height: 104px;
        }
        .metric-label { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #718096; margin-bottom: 10px; }
        .metric-value { font-size: 1rem; font-weight: 700; color: #1a1f2e; line-height: 1.35; }
        .metric-sub { margin-top: 6px; font-size: .72rem; color: #718096; }

        .filter-section {
            background: #fff;
            padding: 14px;
            border-radius: 8px;
            margin-bottom: 14px;
            border: 1px solid #eaeef2;
        }
        .filter-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px;
            margin-bottom: 10px;
        }
        .form-group { margin-bottom: 0; }
        .form-group label {
            display: block;
            font-size: .75rem;
            font-weight: 600;
            color: #1a1f2e;
            margin-bottom: 5px;
        }
        .form-control, .form-select {
            font-size: .75rem;
            padding: 6px 10px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            background: #fff;
            height: auto;
        }
        .form-control:focus, .form-select:focus {
            border-color: #00b894;
            box-shadow: 0 0 0 3px rgba(0, 184, 148, 0.1);
        }
        .filter-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .badge-fixed {
            display: inline-flex;
            align-items: center;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
            background: rgba(56,161,105,.12);
            color: #2f855a;
        }

        #transactionsTable { width: 100% !important; font-size: .75rem; }
        #transactionsTable thead th {
            padding: 7px 8px;
            font-size: .72rem;
            font-weight: 700;
            background: #f7fafc;
            border-bottom: 2px solid #eaeef2;
            color: #1a1f2e;
            white-space: nowrap;
        }
        #transactionsTable tbody td {
            padding: 7px 8px;
            vertical-align: middle;
            border-color: #eaeef2;
        }
        #transactionsTable tbody tr:hover { background: #f7fafc; }
        .dataTables_wrapper { font-size: .75rem; }
        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: .75rem;
        }
        .dataTables_wrapper .pagination .page-link {
            font-size: .75rem;
            padding: .4rem .6rem;
            color: #00b894;
        }
        .dataTables_wrapper .pagination .page-item.active .page-link {
            background: #00b894;
            border-color: #00b894;
        }
        .text-right { text-align: right !important; }
        .amount-credit { color: #00b894; font-weight: 700; }
        .amount-debit { color: #e53e3e; font-weight: 700; }
        .dc-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
        }
        .dc-credit { background: rgba(56,161,105,.12); color: #2f855a; }
        .dc-debit { background: rgba(229,62,62,.12); color: #c53030; }
        .note-panel {
            margin-top: 12px;
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid #bee3f8;
            background: #ebf8ff;
            color: #2c5282;
            font-size: .75rem;
        }

        @media print {
            .page-heading,
            .page-footer,
            .filter-section,
            .ibox-tools,
            .dataTables_length,
            .dataTables_filter,
            .dataTables_info,
            .dataTables_paginate { display: none !important; }
            .page-wrapper, body.sidebar-collapsed .page-wrapper {
                margin: 0 !important;
                width: 100% !important;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <h3><i class="fa fa-exchange" style="color: #00b894; margin-right: 8px;"></i>Member Transaction Listing</h3>
            <div class="page-subtitle">All member transactions except internal, with dashboard-style filtering and exports.</div>
        </div>

        <div class="page-content">
            <div class="hero-strip">
                <div class="title">Member transactions workspace</div>
                <div class="meta">This listing excludes members whose status is <strong>internal</strong>.</div>
            </div>

            <div class="summary-grid">
                <div class="metric-card">
                    <div class="metric-label">Scope</div>
                    <div class="metric-value">Non-Internal</div>
                    <div class="metric-sub">All statuses except internal</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Export</div>
                    <div class="metric-value">Excel & PDF</div>
                    <div class="metric-sub">Exports use the active filters</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Source</div>
                    <div class="metric-value">Transactions</div>
                    <div class="metric-sub">Loaded from the filtered transactions endpoint</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Status Filter</div>
                    <div class="metric-value"><span class="badge-fixed">not internal</span></div>
                    <div class="metric-sub">Internal status is excluded on this page</div>
                </div>
            </div>

            <div class="filter-section">
                <div style="font-size:.8rem;font-weight:600;color:#1a1f2e;margin-bottom:12px;display:flex;align-items:center;">
                    <i class="fa fa-filter" style="color:#00b894;margin-right:6px;"></i> Filter Member Transactions
                </div>
                <div class="filter-grid">
                    <div class="form-group">
                        <label for="startDate">Start Date</label>
                        <input type="date" id="startDate" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="endDate">End Date</label>
                        <input type="date" id="endDate" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="memberId">Member ID</label>
                        <input type="text" id="memberId" class="form-control" placeholder="Enter member ID" />
                    </div>
                    <div class="form-group">
                        <label for="payment_period">Payment Period</label>
                        <select id="payment_period" class="form-select">
                            <option value="">-- All --</option>
                            <option value="2022">2022</option>
                            <option value="2023">2023</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                            <option value="2028">2028</option>
                            <option value="2029">2029</option>
                            <option value="2030">2030</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="transaction_type">Transaction Type</label>
                        <select id="transaction_type" class="form-select">
                            <option value="">-- All --</option>
                            <option value="Saving">Savings</option>
                            <option value="Savings Withdrawal">Savings Withdrawal</option>
                            <option value="Membership Fee">Membership Fee</option>
                            <option value="welfare Fee">Welfare Fee</option>
                            <option value="Insurance Cover">Insurance Cover</option>
                            <option value="Loan Disbursement">Loan Disbursement</option>
                            <option value="Loan Repayment">Loan Repayment</option>
                            <option value="Rental Income">Rental Income</option>
                            <option value="Real Estate Income">Real Estate Income</option>
                            <option value="Other Income">Other Income</option>
                            <option value="Other Expense">Other Expense</option>
                            <option value="Penalty Fees">Penalty Fees</option>
                        </select>
                    </div>
                </div>
                <div class="filter-actions">
                    <button id="filterBtn" class="btn btn-primary"><i class="fa fa-search"></i> Load Transactions</button>
                    <button id="clearBtn" class="btn btn-secondary"><i class="fa fa-refresh"></i> Clear Filters</button>
                    <button id="excelExportBtn" class="btn btn-outline-primary"><i class="fa fa-file-excel-o"></i> Excel Export</button>
                    <button id="pdfExportBtn" class="btn btn-outline-primary"><i class="fa fa-file-pdf-o"></i> PDF Export</button>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Member Transactions</div>
                </div>
                <div class="ibox-body">
                    <div class="note-panel">
                        <i class="fa fa-info-circle"></i>
                        Only transactions linked to members whose status is <strong>not internal</strong> appear here, even when you export.
                    </div>
                    <div class="table-responsive mt-3">
                        <table id="transactionsTable" class="table table-striped table-bordered table-hover" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Transaction ID</th>
                                    <th>Member ID</th>
                                    <th>Date</th>
                                    <th class="text-right">Amount</th>
                                    <th>Period</th>
                                    <th>Type</th>
                                    <th>Description</th>
                                    <th>Debit/Credit</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            2026 © <strong>Agali Awamu SACCO</strong> — All rights reserved.
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        $(document).ready(function () {
            function getFilters() {
                return {
                    startDate: $('#startDate').val(),
                    endDate: $('#endDate').val(),
                    excludeInternal: true,
                    memberId: $('#memberId').val(),
                    transaction_type: $('#transaction_type').val(),
                    payment_period: $('#payment_period').val()
                };
            }

            function formatShortDate(value) {
                if (!value) return '';
                return new Date(value).toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: '2-digit'
                });
            }

            function getDebitCreditPill(value) {
                const normalized = String(value || '').toLowerCase();
                const cls = normalized === 'credit' ? 'dc-credit' : 'dc-debit';
                return '<span class="dc-pill ' + cls + '">' + String(value || '') + '</span>';
            }

            async function fetchExportRows() {
                const payload = Object.assign({
                    draw: 1,
                    start: 0,
                    length: 100000
                }, getFilters());

                return $.ajax({
                    url: '/transactions/filter',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload)
                });
            }

            function exportExcel(rows) {
                if (!rows.length) {
                    Swal.fire({
                        icon: 'info',
                        title: 'No Data',
                        text: 'There are no member transactions to export.',
                        confirmButtonColor: '#00b894'
                    });
                    return;
                }

                let html = `
                    <table>
                        <tr><th colspan="8">Member Transactions</th></tr>
                        <tr><td>Status Filter</td><td>all except internal</td></tr>
                        <tr><td>Generated</td><td>${formatShortDate(new Date().toISOString())}</td></tr>
                    </table>
                    <br />
                    <table border="1">
                        <thead>
                            <tr>
                                <th>Transaction ID</th>
                                <th>Member ID</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Period</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Debit/Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                `;

                rows.forEach(row => {
                    html += `
                        <tr>
                            <td>${row.id ?? ''}</td>
                            <td>${row.member_id ?? ''}</td>
                            <td>${formatShortDate(row.tran_date)}</td>
                            <td>${Number(row.Amount || 0)}</td>
                            <td>${row.payment_period ?? ''}</td>
                            <td>${row.transaction_type ?? ''}</td>
                            <td>${row.description ?? ''}</td>
                            <td>${row.debit_credit ?? ''}</td>
                        </tr>
                    `;
                });

                html += '</tbody></table>';

                const blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'member_transactions.xls';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(link.href);
            }

            function exportPdf(rows) {
                if (!rows.length) {
                    Swal.fire({
                        icon: 'info',
                        title: 'No Data',
                        text: 'There are no member transactions to export.',
                        confirmButtonColor: '#00b894'
                    });
                    return;
                }

                const printWindow = window.open('', '_blank', 'width=1200,height=800');
                if (!printWindow) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Popup Blocked',
                        text: 'Please allow popups to export the PDF view.',
                        confirmButtonColor: '#00b894'
                    });
                    return;
                }

                const rowsHtml = rows.map(row => `
                    <tr>
                        <td>${row.id ?? ''}</td>
                        <td>${row.member_id ?? ''}</td>
                        <td>${formatShortDate(row.tran_date)}</td>
                        <td style="text-align:right;">UGX ${Number(row.Amount || 0).toLocaleString('en-UG')}</td>
                        <td>${row.payment_period ?? ''}</td>
                        <td>${row.transaction_type ?? ''}</td>
                        <td>${row.description ?? ''}</td>
                        <td>${row.debit_credit ?? ''}</td>
                    </tr>
                `).join('');

                printWindow.document.write(`
                    <!DOCTYPE html>
                    <html lang="en">
                    <head>
                        <meta charset="UTF-8">
                        <title>Member Transactions</title>
                        <style>
                            body { font-family: Arial, sans-serif; margin: 24px; color: #1a1f2e; }
                            h1 { margin: 0 0 6px; font-size: 24px; }
                            .meta { color: #4a5568; margin-bottom: 18px; font-size: 13px; }
                            table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 12px; }
                            th, td { border: 1px solid #dfe6ee; padding: 7px 8px; text-align: left; vertical-align: top; }
                            th { background: #f7fafc; }
                        </style>
                    </head>
                    <body>
                        <h1>Member Transactions</h1>
                        <div class="meta">Status filter: all except internal • Generated ${formatShortDate(new Date().toISOString())}</div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Transaction ID</th>
                                    <th>Member ID</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Period</th>
                                    <th>Type</th>
                                    <th>Description</th>
                                    <th>Debit/Credit</th>
                                </tr>
                            </thead>
                            <tbody>${rowsHtml}</tbody>
                        </table>
                    </body>
                    </html>
                `);

                printWindow.document.close();
                printWindow.focus();
                setTimeout(() => printWindow.print(), 400);
            }

            const table = $('#transactionsTable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                paging: true,
                ordering: true,
                info: true,
                lengthChange: true,
                pageLength: 25,
                ajax: {
                    url: '/transactions/filter',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        return JSON.stringify(Object.assign({}, d, getFilters()));
                    },
                    error: function(xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error Loading Data',
                            text: xhr.responseJSON?.error || 'Could not load member transactions',
                            confirmButtonColor: '#00b894'
                        });
                    }
                },
                columns: [
                    { data: 'id' },
                    { data: 'member_id' },
                    {
                        data: 'tran_date',
                        render: function (data) {
                            return formatShortDate(data);
                        }
                    },
                    {
                        data: 'Amount',
                        className: 'text-right',
                        render: function (data, type, row) {
                            const normalized = String(row.debit_credit || '').toLowerCase();
                            const cls = normalized === 'credit' ? 'amount-credit' : 'amount-debit';
                            const prefix = normalized === 'credit' ? '+' : '-';
                            return '<span class="' + cls + '">' + prefix + ' UGX ' + Number(data || 0).toLocaleString('en-UG') + '</span>';
                        }
                    },
                    { data: 'payment_period' },
                    { data: 'transaction_type' },
                    { data: 'description' },
                    {
                        data: 'debit_credit',
                        render: function (data) {
                            return getDebitCreditPill(data);
                        }
                    }
                ],
                dom: '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>'
            });

            table.ajax.reload();

            $('#filterBtn').on('click', function () {
                table.ajax.reload();
            });

            $('#clearBtn').on('click', function () {
                $('#startDate').val('');
                $('#endDate').val('');
                $('#memberId').val('');
                $('#payment_period').val('');
                $('#transaction_type').val('');
                table.ajax.reload();
            });

            $('#excelExportBtn').on('click', async function () {
                const response = await fetchExportRows();
                exportExcel(response.data || []);
            });

            $('#pdfExportBtn').on('click', async function () {
                const response = await fetchExportRows();
                exportPdf(response.data || []);
            });

            $('#startDate, #endDate, #memberId, #payment_period, #transaction_type').on('keypress', function(e) {
                if (e.which === 13) {
                    $('#filterBtn').click();
                    return false;
                }
            });
        });
    </script>
</body>
</html>
