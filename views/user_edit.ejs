<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --users-primary: #0ea5e9;
            --users-primary-dark: #0369a1;
            --users-soft: #f0f9ff;
            --users-border: #dbeafe;
            --users-text: #1a1f2e;
            --users-muted: #718096;
            --users-success: #047857;
        }

        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }
        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }

        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading {
            padding: 14px 22px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }
        .page-heading h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--users-text);
            margin: 0;
        }
        .page-subtitle {
            margin-top: 4px;
            color: var(--users-muted);
            font-size: .78rem;
        }
        .page-content { padding: 12px 22px 24px; }
        .page-footer {
            padding: 12px 22px;
            font-size: .72rem;
            color: #a0aec0;
            text-align: center;
            border-top: 1px solid #eaeef2;
            background: #fff;
        }

        .top-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: .75rem;
            font-weight: 600;
            background: var(--users-soft);
            color: var(--users-primary-dark);
            border: 1px solid var(--users-border);
            text-decoration: none;
        }
        .top-link:hover {
            text-decoration: none;
            color: var(--users-primary-dark);
            background: #e0f2fe;
        }

        .hero-strip {
            background: linear-gradient(135deg, var(--users-primary) 0%, var(--users-primary-dark) 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(14, 165, 233, 0.16);
        }
        .hero-strip .title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .hero-strip .meta {
            font-size: .78rem;
            opacity: .92;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (max-width: 767px) {
            .summary-grid { grid-template-columns: 1fr; }
        }
        .metric-card {
            background: #fff;
            border: 1px solid var(--users-border);
            border-radius: 10px;
            padding: 14px;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            position: relative;
            min-height: 102px;
        }
        .metric-card::after {
            content: '';
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            border-radius: 10px 0 0 10px;
            background: linear-gradient(180deg, var(--users-primary), var(--users-primary-dark));
        }
        .metric-label {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--users-muted);
            margin-bottom: 10px;
        }
        .metric-value {
            font-size: 1rem;
            font-weight: 700;
            color: var(--users-text);
            line-height: 1.35;
        }
        .metric-sub {
            margin-top: 6px;
            font-size: .72rem;
            color: var(--users-muted);
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
            gap: 14px;
            align-items: start;
        }
        @media (max-width: 991px) {
            .content-grid { grid-template-columns: 1fr; }
        }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #eaeef2;
            background: #fff;
            flex-wrap: wrap;
        }
        .ibox-title {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--users-muted);
        }
        .ibox-body { padding: 14px; background: #fff; }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }
        @media (max-width: 767px) {
            .form-grid { grid-template-columns: 1fr; }
        }
        .form-group label {
            font-size: .75rem;
            font-weight: 600;
            color: var(--users-text);
            margin-bottom: 5px;
        }
        .form-control {
            font-size: .75rem;
            padding: 8px 10px;
            border: 1px solid #d9e2ec;
            border-radius: 6px;
            min-height: 38px;
            background: #fff;
        }
        .form-control:focus {
            border-color: var(--users-primary);
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
        }
        .form-hint {
            margin-top: 5px;
            font-size: .68rem;
            color: var(--users-muted);
        }

        .role-pill-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }
        .role-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
            background: #f8fafc;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
        }
        .status-pill.active {
            background: #ecfdf5;
            color: #047857;
        }
        .status-pill.inactive {
            background: #f3f4f6;
            color: #6b7280;
        }

        .btn {
            font-size: .75rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            transition: all .15s;
        }
        .btn-secondary {
            background: #edf2f7;
            border: none;
            color: #2d3748;
        }
        .btn-secondary:hover {
            background: #e2e8f0;
            color: #1a202c;
        }
        .btn-success {
            background: var(--users-success);
            border: none;
            color: #fff;
        }
        .btn-success:hover {
            background: #065f46;
            color: #fff;
        }

        .actions-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        .helper-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .helper-item {
            padding: 12px;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            background: #fff;
        }
        .helper-title {
            font-size: .74rem;
            font-weight: 700;
            color: var(--users-text);
            margin-bottom: 4px;
        }
        .helper-copy {
            font-size: .72rem;
            color: var(--users-muted);
            line-height: 1.5;
        }
    </style>
</head>

<body class="fixed-navbar">
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <div>
                <h3><i class="fa fa-edit" style="color:var(--users-primary); margin-right: 8px;"></i>Edit User</h3>
                <div class="page-subtitle">Update account details, access role, and status for this user without changing the rest of the user-management flow.</div>
            </div>
            <a href="/users" class="top-link">
                <i class="fa fa-arrow-left"></i> Back to Users
            </a>
        </div>

        <div class="page-content">
            <div class="hero-strip">
                <div class="title">User account update</div>
                <div class="meta">Review role and account status carefully so the user keeps the right access after changes are saved.</div>
            </div>

            <div class="summary-grid">
                <div class="metric-card">
                    <div class="metric-label">Editing User</div>
                    <div class="metric-value">@<%= editUser.username %></div>
                    <div class="metric-sub">Current account username</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Current Role</div>
                    <div class="metric-value"><%= editUser.role %></div>
                    <div class="metric-sub">Existing access assignment</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Account Status</div>
                    <div class="metric-value"><%= editUser.status %></div>
                    <div class="metric-sub">Current activation state</div>
                </div>
            </div>

            <div class="content-grid">
                <div class="ibox">
                    <div class="ibox-head">
                        <div class="ibox-title">Edit User Details</div>
                    </div>
                    <div class="ibox-body">
                        <form id="editUserForm">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="username">Username <span class="text-danger">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="username"
                                        name="username"
                                        value="<%= editUser.username %>"
                                        required
                                    >
                                </div>

                                <div class="form-group">
                                    <label for="role">Role <span class="text-danger">*</span></label>
                                    <select class="form-control" id="role" name="role" required>
                                        <option value="user" <%= editUser.role === 'user' ? 'selected' : '' %>>User</option>
                                        <option value="admin" <%= editUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
                                        <option value="member" <%= editUser.role === 'member' ? 'selected' : '' %>>Member</option>
                                    </select>
                                    <div class="role-pill-row">
                                        <span class="role-pill"><i class="fa fa-user"></i> User</span>
                                        <span class="role-pill"><i class="fa fa-shield"></i> Admin</span>
                                        <span class="role-pill"><i class="fa fa-users"></i> Member</span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="first_name">First Name <span class="text-danger">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="first_name"
                                        name="first_name"
                                        value="<%= editUser.first_name %>"
                                        required
                                    >
                                </div>

                                <div class="form-group">
                                    <label for="last_name">Last Name <span class="text-danger">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="last_name"
                                        name="last_name"
                                        value="<%= editUser.last_name %>"
                                        required
                                    >
                                </div>

                                <div class="form-group">
                                    <label for="status">Status <span class="text-danger">*</span></label>
                                    <select class="form-control" id="status" name="status" required>
                                        <option value="active" <%= editUser.status === 'active' ? 'selected' : '' %>>Active</option>
                                        <option value="inactive" <%= editUser.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                    <div class="form-hint">Set inactive if this account should stop signing in without deleting its history.</div>
                                </div>
                            </div>

                            <div class="actions-row">
                                <button type="submit" class="btn btn-success" id="submitBtn">
                                    <i class="fa fa-save"></i> Update User
                                </button>
                                <a href="/users" class="btn btn-secondary">
                                    <i class="fa fa-times"></i> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="ibox">
                    <div class="ibox-head">
                        <div class="ibox-title">Quick Guidance</div>
                    </div>
                    <div class="ibox-body">
                        <div class="helper-list">
                            <div class="helper-item">
                                <div class="helper-title">Role changes</div>
                                <div class="helper-copy">Only promote users to admin when they need access to sensitive workflows like loans, transactions, and reports.</div>
                            </div>
                            <div class="helper-item">
                                <div class="helper-title">Status control</div>
                                <div class="helper-copy">
                                    <span class="status-pill <%= editUser.status === 'active' ? 'active' : 'inactive' %>">
                                        <i class="fa <%= editUser.status === 'active' ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                                        <%= editUser.status %>
                                    </span>
                                </div>
                            </div>
                            <div class="helper-item">
                                <div class="helper-title">Before saving</div>
                                <div class="helper-copy">Double-check the username spelling and status update so the user lands exactly where you expect after the change.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            2026 &copy; Agali Awamu SACCO - All rights reserved.
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        const userId = <%= editUser.id %>;

        $('#editUserForm').on('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            $('#submitBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Updating...');

            try {
                const response = await fetch(`/users/${userId}/edit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Validation Errors',
                        html: result.errors.map(function(e) { return `<p>- ${e}</p>`; }).join('')
                    });

                    $('#submitBtn').prop('disabled', false).html('<i class="fa fa-save"></i> Update User');
                    return;
                }

                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: result.message
                }).then(() => {
                    window.location.href = '/users';
                });

            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Could not update user'
                });

                $('#submitBtn').prop('disabled', false).html('<i class="fa fa-save"></i> Update User');
            }
        });
    </script>
</body>
</html>
