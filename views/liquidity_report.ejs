<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liquidity Report</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading { padding: 14px 22px 0; }
        .page-heading h3 { font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0; }
        .page-subtitle { margin-top: 4px; color: #718096; font-size: .78rem; }
        .page-content { padding: 12px 22px 24px; }
        .page-footer { padding: 12px 22px; font-size: .72rem; color: #a0aec0; text-align: center; border-top: 1px solid #eaeef2; background: #fff; }

        .hero-strip {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(245, 158, 11, 0.18);
        }
        .hero-strip .title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .hero-strip .meta {
            font-size: .78rem;
            opacity: .92;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (max-width: 991px) {
            .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 575px) {
            .summary-grid { grid-template-columns: 1fr; }
        }
        .metric-card {
            background: #fff;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            padding: 14px;
            min-height: 104px;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
        }
        .metric-label {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #718096;
            margin-bottom: 10px;
        }
        .metric-value {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1f2e;
            line-height: 1.35;
        }
        .metric-sub {
            margin-top: 6px;
            font-size: .72rem;
            color: #718096;
        }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #eaeef2;
            background: #fff;
            flex-wrap: wrap;
        }
        .ibox-title {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #718096;
        }
        .ibox-body { padding: 14px; background: #fff; }

        .btn {
            font-size: .75rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            transition: all .15s;
        }
        .btn-sm { padding: 5px 12px; font-size: .7rem; }
        .btn-primary { background: #f59e0b; border: none; color: #fff; }
        .btn-primary:hover { background: #d97706; color: #fff; }
        .btn-secondary { background: #edf2f7; border: none; color: #2d3748; }
        .btn-secondary:hover { background: #e2e8f0; color: #1a202c; }
        .btn-outline-primary { border: 1px solid #f59e0b; color: #d97706; background: #fff; }
        .btn-outline-primary:hover { background: #f59e0b; color: #fff; }
        .btn-warning { background: #f6ad55; border: none; color: #fff; }
        .btn-danger { background: #f56565; border: none; color: #fff; }

        .filters-row {
            display: flex;
            gap: 12px;
            align-items: end;
            flex-wrap: wrap;
        }
        .form-group label {
            font-size: .75rem;
            font-weight: 600;
            color: #1a1f2e;
            margin-bottom: 5px;
        }
        .form-control {
            font-size: .75rem;
            padding: 8px 10px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            background: #fff;
            min-height: 38px;
        }
        .form-control:focus {
            border-color: #f59e0b;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
        }

        .category-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .cat-bank { background: rgba(14, 165, 233, .12); color: #0369a1; }
        .cat-unittrust { background: rgba(56, 161, 105, .12); color: #2f855a; }
        .cat-mobilemoney { background: rgba(245, 158, 11, .14); color: #b45309; }
        .cat-cash { background: rgba(229, 62, 62, .12); color: #c53030; }
        .cat-other { background: rgba(139, 92, 246, .12); color: #6d28d9; }

        .chart-wrap {
            position: relative;
            min-height: 260px;
        }

        .table-responsive { overflow-x: auto; }
        #liquidityTable {
            width: 100% !important;
            font-size: .75rem;
        }
        #liquidityTable thead th {
            padding: 7px 8px;
            font-size: .72rem;
            font-weight: 700;
            background: #f7fafc;
            border-bottom: 2px solid #eaeef2;
            color: #1a1f2e;
            white-space: nowrap;
        }
        #liquidityTable tbody td {
            padding: 7px 8px;
            vertical-align: middle;
            border-color: #eaeef2;
        }
        #liquidityTable tbody tr:hover { background: #f7fafc; }
        .text-right { text-align: right !important; }

        .dataTables_wrapper { font-size: .75rem; }
        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: .75rem;
        }
        .dataTables_wrapper .pagination .page-link {
            font-size: .75rem;
            padding: .4rem .6rem;
            color: #f59e0b;
        }
        .dataTables_wrapper .pagination .page-item.active .page-link {
            background: #f59e0b;
            border-color: #f59e0b;
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <h3><i class="fa fa-bank" style="color: #f59e0b; margin-right: 8px;"></i>Liquidity Report</h3>
            <div class="page-subtitle">Fund distribution across banks, unit trusts, mobile money, cash, and other liquidity sources.</div>
        </div>

        <div class="page-content">
            <div class="hero-strip">
                <div class="title">Liquidity position by reporting date</div>
                <div class="meta">Choose a reporting date to reload the balances. Available dates are shown in descending order.</div>
            </div>

            <div class="summary-grid" id="summaryCards"></div>

            <div class="row">
                <div class="col-lg-4">
                    <div class="ibox">
                        <div class="ibox-head">
                            <div class="ibox-title">Fund Distribution</div>
                        </div>
                        <div class="ibox-body">
                            <div class="chart-wrap">
                                <canvas id="report_pie"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="ibox">
                        <div class="ibox-head">
                            <div class="ibox-title">Filters & Actions</div>
                            <div class="ibox-tools">
                                <button class="btn btn-outline-primary btn-sm" id="excelExportBtn">
                                    <i class="fa fa-file-excel-o"></i> Excel Export
                                </button>
                                <button class="btn btn-secondary btn-sm" id="pdfExportBtn">
                                    <i class="fa fa-file-pdf-o"></i> PDF Print
                                </button>
                                <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addModal">
                                    <i class="fa fa-plus"></i> Add Entry
                                </button>
                            </div>
                        </div>
                        <div class="ibox-body">
                            <div class="filters-row">
                                <div class="form-group mb-0" style="min-width:220px;">
                                    <label for="dateFilter">As At Date</label>
                                    <select id="dateFilter" class="form-control">
                                        <% dates.forEach(function(d) { %>
                                            <option value="<%= d.date_val %>"><%= d.date_val %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="metric-sub">The table refreshes and remains aligned to the selected reporting date.</div>
                            </div>
                        </div>
                    </div>

                    <div class="ibox">
                        <div class="ibox-head">
                            <div class="ibox-title">Fund Details</div>
                        </div>
                        <div class="ibox-body">
                            <div class="table-responsive">
                                <table id="liquidityTable" class="table table-striped table-bordered table-hover" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th>Institution</th>
                                            <th>Account Ref</th>
                                            <th class="text-right">Amount (UGX)</th>
                                            <th>As At Date</th>
                                            <th>Notes</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="liquidityTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            2026 © Agali Awamu SACCO — All rights reserved.
        </div>
    </div>

    <div class="modal fade" id="addModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Liquidity Entry</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="entry_id">
                    <div class="form-group">
                        <label>Category *</label>
                        <select id="entry_category" class="form-control">
                            <option value="Bank">Bank</option>
                            <option value="Unit Trust">Unit Trust</option>
                            <option value="Mobile Money">Mobile Money</option>
                            <option value="Cash">Cash</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Institution</label>
                        <input type="text" id="entry_institution" class="form-control" placeholder="e.g. Stanbic Bank">
                    </div>
                    <div class="form-group">
                        <label>Account Reference</label>
                        <input type="text" id="entry_account_ref" class="form-control" placeholder="Account number">
                    </div>
                    <div class="form-group">
                        <label>Amount (UGX) *</label>
                        <input type="number" id="entry_amount" class="form-control" placeholder="0" min="0">
                    </div>
                    <div class="form-group">
                        <label>As At Date *</label>
                        <input type="date" id="entry_date" class="form-control">
                    </div>
                    <div class="form-group mb-0">
                        <label>Notes</label>
                        <textarea id="entry_notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" id="saveEntryBtn">Save</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="/assets/vendors/chart.js/dist/Chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>
    <script>
        const initialRecords = <%- JSON.stringify(records) %>;
        const initialSummary = <%- JSON.stringify(summary) %>;
        const initialGrandTotal = <%- JSON.stringify(grandTotal) %>;

        let currentRecords = Array.isArray(initialRecords) ? initialRecords : [];
        let currentSummary = Array.isArray(initialSummary) ? initialSummary : [];
        let currentGrandTotal = Number(initialGrandTotal || 0);
        let liquidityTable = null;
        let pieChart = null;

        function formatCurrency(value) {
            return 'UGX ' + Number(value || 0).toLocaleString('en-UG', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }

        function formatDate(value) {
            if (!value) return '-';
            const parsed = new Date(value);
            if (Number.isNaN(parsed.getTime())) return value;
            return parsed.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function categoryClass(category) {
            return 'cat-' + String(category || '')
                .toLowerCase()
                .replace(/\s+/g, '');
        }

        function renderSummaryCards(summaryRows, grandTotal) {
            const cards = summaryRows.map(row => `
                <div class="metric-card">
                    <div class="metric-label">${escapeHtml(row.category)}</div>
                    <div class="metric-value">${escapeHtml(formatCurrency(row.total_amount))}</div>
                    <div class="metric-sub">${escapeHtml(row.account_count)} account(s)</div>
                </div>
            `).join('');

            $('#summaryCards').html(cards + `
                <div class="metric-card">
                    <div class="metric-label">Grand Total</div>
                    <div class="metric-value">${escapeHtml(formatCurrency(grandTotal))}</div>
                    <div class="metric-sub">${escapeHtml(summaryRows.length)} category bucket(s)</div>
                </div>
            `);
        }

        function renderTable(records) {
            const rowsHtml = records.map(r => `
                <tr>
                    <td><span class="category-badge ${categoryClass(r.category)}">${escapeHtml(r.category)}</span></td>
                    <td>${escapeHtml(r.institution || '—')}</td>
                    <td>${escapeHtml(r.account_ref || '—')}</td>
                    <td class="text-right"><strong>${escapeHtml(Number(r.amount || 0).toLocaleString('en-UG', { maximumFractionDigits: 0 }))}</strong></td>
                    <td data-order="${escapeHtml(r.as_at_date || '')}">${escapeHtml(r.formatted_date || formatDate(r.as_at_date))}</td>
                    <td>${escapeHtml(r.notes || '')}</td>
                    <td>
                        <button class="btn btn-warning btn-sm edit-btn"
                            data-id="${escapeHtml(r.id)}"
                            data-category="${escapeHtml(r.category)}"
                            data-institution="${escapeHtml(r.institution || '')}"
                            data-account_ref="${escapeHtml(r.account_ref || '')}"
                            data-amount="${escapeHtml(r.amount || '')}"
                            data-notes="${escapeHtml(r.notes || '')}"
                            data-date="${escapeHtml(r.as_at_date || '')}">
                            <i class="fa fa-edit"></i>
                        </button>
                        <button class="btn btn-danger btn-sm delete-btn" data-id="${escapeHtml(r.id)}">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `).join('');

            $('#liquidityTableBody').html(rowsHtml);

            if (liquidityTable) {
                liquidityTable.destroy();
            }

            liquidityTable = $('#liquidityTable').DataTable({
                pageLength: 25,
                order: [[4, 'desc'], [0, 'asc']],
                columnDefs: [
                    { targets: [3], className: 'text-right' },
                    { orderable: false, targets: [6] }
                ],
                dom: '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>'
            });
        }

        function renderChart(summaryRows) {
            const ctx = document.getElementById('report_pie').getContext('2d');
            const colors = ['rgba(14,165,233,.85)', 'rgba(40,167,69,.85)', 'rgba(245,158,11,.85)', 'rgba(229,62,62,.85)', 'rgba(139,92,246,.85)', 'rgba(107,114,128,.85)'];

            if (pieChart) {
                pieChart.destroy();
            }

            pieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: summaryRows.map(item => item.category),
                    datasets: [{
                        data: summaryRows.map(item => Number(item.total_amount || 0)),
                        backgroundColor: colors.slice(0, summaryRows.length),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    tooltips: {
                        callbacks: {
                            label: function(item, data) {
                                return data.labels[item.index] + ': ' + formatCurrency(data.datasets[0].data[item.index]);
                            }
                        }
                    }
                }
            });
        }

        function refreshLiquidityView(records, summaryRows, grandTotal) {
            currentRecords = records;
            currentSummary = summaryRows;
            currentGrandTotal = Number(grandTotal || 0);
            renderSummaryCards(currentSummary, currentGrandTotal);
            renderTable(currentRecords);
            renderChart(currentSummary);
        }

        function exportLiquidityExcel() {
            if (!currentRecords.length) {
                alert('No liquidity rows available for export.');
                return;
            }

            let tableHtml = `
                <table>
                    <tr><th colspan="6">Liquidity Report</th></tr>
                    <tr><td>As At Date</td><td>${escapeHtml($('#dateFilter').val() || '')}</td></tr>
                    <tr><td>Grand Total</td><td>${escapeHtml(formatCurrency(currentGrandTotal))}</td></tr>
                </table>
                <br />
                <table border="1">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Institution</th>
                            <th>Account Ref</th>
                            <th>Amount</th>
                            <th>As At Date</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            currentRecords.forEach(row => {
                tableHtml += `
                    <tr>
                        <td>${escapeHtml(row.category)}</td>
                        <td>${escapeHtml(row.institution || '')}</td>
                        <td>${escapeHtml(row.account_ref || '')}</td>
                        <td>${escapeHtml(Number(row.amount || 0))}</td>
                        <td>${escapeHtml(row.formatted_date || formatDate(row.as_at_date))}</td>
                        <td>${escapeHtml(row.notes || '')}</td>
                    </tr>
                `;
            });

            tableHtml += '</tbody></table>';

            const blob = new Blob(['\ufeff' + tableHtml], { type: 'application/vnd.ms-excel' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'liquidity-report.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);
        }

        function printLiquidityPdf() {
            if (!currentRecords.length) {
                alert('No liquidity rows available for printing.');
                return;
            }

            const printWindow = window.open('', '_blank', 'width=1200,height=800');
            if (!printWindow) {
                alert('Please allow popups to print the report.');
                return;
            }

            const summaryCardsHtml = document.getElementById('summaryCards').innerHTML;
            const rowsHtml = currentRecords.map(row => `
                <tr>
                    <td>${escapeHtml(row.category)}</td>
                    <td>${escapeHtml(row.institution || '')}</td>
                    <td>${escapeHtml(row.account_ref || '')}</td>
                    <td style="text-align:right;">${escapeHtml(formatCurrency(row.amount))}</td>
                    <td>${escapeHtml(row.formatted_date || formatDate(row.as_at_date))}</td>
                    <td>${escapeHtml(row.notes || '')}</td>
                </tr>
            `).join('');

            printWindow.document.write(`
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <title>Liquidity Report</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 24px; color: #1a1f2e; }
                        h1 { margin: 0 0 6px; font-size: 24px; }
                        .meta { color: #4a5568; margin-bottom: 18px; font-size: 13px; }
                        .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
                        .metric-card { border: 1px solid #dfe6ee; border-radius: 8px; padding: 12px; }
                        .metric-label { font-size: 11px; text-transform: uppercase; color: #718096; font-weight: 700; margin-bottom: 8px; }
                        .metric-value { font-size: 16px; font-weight: 700; }
                        .metric-sub { font-size: 11px; color: #718096; margin-top: 6px; }
                        table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 12px; }
                        th, td { border: 1px solid #dfe6ee; padding: 7px 8px; text-align: left; }
                        th { background: #f7fafc; }
                    </style>
                </head>
                <body>
                    <h1>Liquidity Report</h1>
                    <div class="meta">As at ${escapeHtml($('#dateFilter').val() || '')}</div>
                    <div class="grid">${summaryCardsHtml}</div>
                    <table>
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Institution</th>
                                <th>Account Ref</th>
                                <th>Amount</th>
                                <th>As At Date</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>${rowsHtml}</tbody>
                    </table>
                </body>
                </html>
            `);

            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => printWindow.print(), 400);
        }

        $(function() {
            refreshLiquidityView(currentRecords, currentSummary, currentGrandTotal);

            $('#entry_date').val(new Date().toISOString().split('T')[0]);

            $('#excelExportBtn').on('click', function() {
                exportLiquidityExcel();
            });

            $('#pdfExportBtn').on('click', function() {
                printLiquidityPdf();
            });

            $(document).on('click', '.edit-btn', function() {
                const d = $(this).data();
                $('#modalTitle').text('Edit Entry');
                $('#entry_id').val(d.id);
                $('#entry_category').val(d.category);
                $('#entry_institution').val(d.institution || '');
                $('#entry_account_ref').val(d.account_ref || '');
                $('#entry_amount').val(d.amount || '');
                $('#entry_notes').val(d.notes || '');
                $('#entry_date').val(d.date ? String(d.date).split('T')[0] : '');
                $('#addModal').modal('show');
            });

            $('#addModal').on('show.bs.modal', function(e) {
                if (!$(e.relatedTarget).length) return;
                $('#modalTitle').text('Add Liquidity Entry');
                $('#entry_id').val('');
                $('#entry_institution, #entry_account_ref, #entry_notes').val('');
                $('#entry_amount').val('');
                $('#entry_category').val('Bank');
                $('#entry_date').val(new Date().toISOString().split('T')[0]);
            });

            $('#saveEntryBtn').on('click', function() {
                const payload = {
                    id: $('#entry_id').val(),
                    category: $('#entry_category').val(),
                    institution: $('#entry_institution').val(),
                    account_ref: $('#entry_account_ref').val(),
                    amount: $('#entry_amount').val(),
                    notes: $('#entry_notes').val(),
                    as_at_date: $('#entry_date').val()
                };

                if (!payload.category || !payload.amount || !payload.as_at_date) {
                    Swal.fire('Validation', 'Category, amount and date are required.', 'warning');
                    return;
                }

                $.post('/liquidity/save', payload)
                    .done(function() {
                        Swal.fire({ icon: 'success', title: 'Saved', timer: 1200, showConfirmButton: false })
                            .then(() => location.reload());
                    })
                    .fail(function() {
                        Swal.fire('Error', 'Failed to save entry.', 'error');
                    });
            });

            $(document).on('click', '.delete-btn', function() {
                const id = $(this).data('id');
                Swal.fire({
                    title: 'Delete this entry?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f56565',
                    confirmButtonText: 'Delete'
                }).then(result => {
                    if (result.isConfirmed) {
                        $.post('/liquidity/delete/' + id)
                            .done(function() {
                                Swal.fire({ icon: 'success', title: 'Deleted', timer: 1000, showConfirmButton: false })
                                    .then(() => location.reload());
                            })
                            .fail(function() {
                                Swal.fire('Error', 'Failed to delete.', 'error');
                            });
                    }
                });
            });

            $('#dateFilter').on('change', function() {
                $.post('/liquidity/filter', { as_at_date: $(this).val() })
                    .done(function(data) {
                        refreshLiquidityView(data.records || [], data.summary || [], data.grandTotal || 0);
                    });
            });
        });
    </script>
</body>
</html>
