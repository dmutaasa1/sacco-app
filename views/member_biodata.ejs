<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Bio Data - Agali Awamu SACCO</title>

<link href="./assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="./assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
<link href="assets/css/main.min.css" rel="stylesheet" />

<style>

body {
overflow-x:hidden;
background:#f7fafc;
font-family:'DM Sans',sans-serif;
}

.page-wrapper {
margin-left:220px;
margin-top:60px;
padding:20px;
}

.ibox {
border-radius:10px;
background:#fff;
border:1px solid #eaeef2;
margin-bottom:16px;
box-shadow:0 1px 6px rgba(0,0,0,.05);
}

.ibox-head {
padding:12px 16px;
border-bottom:1px solid #eaeef2;
font-weight:700;
font-size:.75rem;
text-transform:uppercase;
color:#718096;
}

.ibox-body {
padding:16px;
}

.detail-grid {
display:grid;
grid-template-columns:1fr 1fr;
gap:10px;
}

@media(max-width:576px){
.detail-grid {
grid-template-columns:1fr;
}
}

.detail-label {
font-size:.65rem;
color:#a0aec0;
text-transform:uppercase;
font-weight:600;
}

.detail-value {
font-size:.82rem;
font-weight:500;
color:#1a1f2e;
}

.dep-card {
display:flex;
align-items:center;
gap:12px;
padding:10px 0;
border-bottom:1px solid #f0f4f8;
}

.dep-card:last-child {
border-bottom:none;
}

.dep-avatar {
width:40px;
height:40px;
border-radius:10px;
background:#4299e1;
color:#fff;
display:flex;
align-items:center;
justify-content:center;
font-weight:700;
}

.dep-name {
font-size:.85rem;
font-weight:600;
}

.dep-dob {
font-size:.7rem;
color:#a0aec0;
}

</style>

</head>

<body>

<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="page-wrapper">

<h4 style="font-weight:700;margin-bottom:16px;">
<i class="fa fa-user"></i>
My Bio Data
</h4>

<!-- ================= BIO DATA ================= -->

<div class="ibox">

<div class="ibox-head">
<i class="fa fa-id-card"></i>
Personal Details
</div>

<div class="ibox-body">

<div class="detail-grid">

<div>
<div class="detail-label">First Name</div>
<div class="detail-value">
<%= member.First_Name || member.First_name || '—' %>
</div>
</div>

<div>
<div class="detail-label">Last Name</div>
<div class="detail-value">
<%= member.Last_Name || '—' %>
</div>
</div>

<div>
<div class="detail-label">National ID</div>
<div class="detail-value">
<%= member.national_id || '—' %>
</div>
</div>

<div>
<div class="detail-label">Date of Birth</div>
<div class="detail-value">
<%= member.Date_of_Birth || '—' %>
</div>
</div>

<div>
<div class="detail-label">Gender</div>
<div class="detail-value">
<%= member.sex || '—' %>
</div>
</div>

<div>
<div class="detail-label">Mobile Number</div>
<div class="detail-value">
<%= member.tel_no || '—' %>
</div>
</div>

<div>
<div class="detail-label">Village</div>
<div class="detail-value">
<%= member.village_lc1 || '—' %>
</div>
</div>

<div>
<div class="detail-label">Parish</div>
<div class="detail-value">
<%= member.parish || '—' %>
</div>
</div>

</div>

</div>

</div>

<!-- ================= NEXT OF KIN ================= -->

<div class="ibox">

<div class="ibox-head">
<i class="fa fa-heart"></i>
Next of Kin
</div>

<div class="ibox-body">

<div class="detail-grid">

<div>
<div class="detail-label">Full Name</div>
<div class="detail-value">
<%= member.next_of_kin_First_name || '' %>
<%= member.next_of_kin_Last_name || '' %>
</div>
</div>

<div>
<div class="detail-label">Phone</div>
<div class="detail-value">
<%= member.next_of_kin_tel || '—' %>
</div>
</div>

<div>
<div class="detail-label">Address</div>
<div class="detail-value">
<%= member.next_of_kin_address || '—' %>
</div>
</div>

</div>

</div>

</div>

<!-- ================= DEPENDANTS ================= -->

<div class="ibox">

<div class="ibox-head">
<i class="fa fa-child"></i>
Dependants
(<%= dependants ? dependants.length : 0 %>)
</div>

<div class="ibox-body">

<% if (dependants && dependants.length) { %>

<% dependants.forEach(function(d,i){ %>

<div class="dep-card">

<div class="dep-avatar">
<%= (d.First_name || '?').charAt(0).toUpperCase() %>
<%= (d.Last_Name || '').charAt(0).toUpperCase() %>
</div>

<div>

<div class="dep-name">
<%= d.First_name %> <%= d.Last_Name %>
</div>

<div class="dep-dob">
DOB:
<%= d.child_date_of_birth || 'Not recorded' %>
</div>

</div>

<div style="margin-left:auto;color:#a0aec0;font-size:.7rem;">
#<%= i + 1 %>
</div>

</div>

<% }) %>

<% } else { %>

<div style="text-align:center;color:#a0aec0;padding:20px;">

<i class="fa fa-child" style="font-size:28px;"></i>

<p>No dependants registered.</p>

</div>

<% } %>

</div>

</div>

</div>

</body>

</html>