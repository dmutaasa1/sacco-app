<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Member - Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; }
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

/* ══════════════════════════════════════════
   BASE LAYOUT — matches admin dashboard
══════════════════════════════════════════ */
body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
.page-wrapper { 
    margin-left: 220px !important;
    margin-top: 60px; 
    width: calc(100% - 220px) !important; 
    max-width: 100%; 
    transition: margin-left .22s ease, width .22s ease;
}
body.sidebar-collapsed .page-wrapper { 
    margin-left: 60px !important; 
    width: calc(100% - 60px) !important; 
}
@media (max-width: 991px) {
    .page-wrapper { 
        margin-left: 0 !important; 
        width: 100% !important; 
        max-width: 100%; 
    }
    .page-heading { padding: 12px 14px 0; }
    .page-content { padding: 12px 14px 24px; }
}

/* ══════════════════════════════════════════
   PAGE HEADING
══════════════════════════════════════════ */
.page-heading {
    padding: 14px 22px 0;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
}
.page-heading h3 {
    font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0;
}
.page-heading .sub { font-size: .72rem; color: #a0aec0; margin-top: 2px; }

/* ══════════════════════════════════════════
   SHARED CARD
══════════════════════════════════════════ */
.ibox { margin-bottom: 0 !important; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 6px rgba(26,31,46,.06); border: 1px solid #eaeef2; }
.ibox-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border-bottom: 1px solid #eaeef2; background: #fff;
}
.ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
.ibox-body  { padding: 14px; background: #fff; }

/* ══════════════════════════════════════════
   FORM STYLING
══════════════════════════════════════════ */
.form-group label {
    font-size: .75rem;
    font-weight: 600;
    color: #1a1f2e;
    margin-bottom: 5px;
}
.form-control, .form-select {
    font-size: .75rem;
    padding: 6px 10px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    background: #fff;
    color: #333;
}
.form-control:focus, .form-select:focus {
    border-color: #00b894;
    box-shadow: 0 0 0 3px rgba(0, 184, 148, 0.1);
}

/* ══════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════ */
.btn {
    font-size: .75rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 6px;
    transition: all .15s;
}
.btn-save {
    background: #00b894;
    color: #fff;
    border: none;
}
.btn-save:hover {
    background: #00a388;
    color: #fff;
}
.btn-cancel {
    background: #e9ecef;
    color: #555;
    border: none;
}
.btn-cancel:hover {
    background: #dee2e6;
    color: #333;
}

/* Page content */
.page-content { padding: 12px 22px 24px; }

/* Footer */
.page-footer {
    padding: 12px 22px;
    font-size: .72rem;
    color: #a0aec0;
    text-align: center;
    border-top: 1px solid #eaeef2;
    background: #fff;
}

/* Grid layout */
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 768px) { .form-grid { grid-template-columns: 1fr; } }

/* Section heading */
.section-title {
    font-size: .85rem;
    font-weight: 700;
    color: #1a1f2e;
    margin: 14px 0 10px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.section-title i { color: #00b894; }

/* Loading spinner */
.loading-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 9999;
    justify-content: center;
    align-items: center;
}
.loading-overlay.active { display: flex; }
.spinner {
    border: 3px solid rgba(255,255,255,.3);
    border-top: 3px solid #fff;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
}
@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Photo Upload Section */
.photo-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 14px 0;
    align-items: start;
}
@media (max-width: 768px) {
    .photo-section { grid-template-columns: 1fr; }
}
.photo-preview {
    background: #f7fafc;
    border: 2px dashed #dee2e6;
    border-radius: 8px;
    padding: 16px;
    text-align: center;
}
.photo-preview img {
    max-width: 100%;
    max-height: 300px;
    border-radius: 6px;
    margin-bottom: 8px;
}
.photo-placeholder {
    width: 100%;
    height: 200px;
    background: #e9ecef;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a0aec0;
    font-size: 3rem;
    margin-bottom: 8px;
}
.photo-label {
    font-size: .68rem;
    color: #718096;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 10px;
    display: block;
}
.file-input-wrapper {
    position: relative;
    display: inline-block;
    width: 100%;
}
.file-input-wrapper input[type="file"] {
    display: none;
}
.file-input-label {
    display: block;
    padding: 8px 14px;
    background: #00b894;
    color: #fff;
    border-radius: 6px;
    font-size: .75rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    transition: background .15s;
}
.file-input-label:hover {
    background: #00a388;
}
.file-input-info {
    font-size: .68rem;
    color: #a0aec0;
    margin-top: 6px;
}
#photoPreviewContainer {
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a0aec0;
}

</style>
</head>

<body>
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
    </div>

    <%- include('partials/header') %>
    <%- include('partials/sidebar') %>

    <div class="page-wrapper">
        <div class="page-heading">
            <div>
                <h3><i class="fa fa-edit" style="margin-right: 8px; color: #00b894;"></i>Edit Member Profile</h3>
                <div class="sub">Member ID: #<%= member.id %></div>
            </div>
        </div>

        <div class="page-content">
            <div class="ibox">
                <div class="ibox-head">
                    <span class="ibox-title"><i class="fa fa-user" style="color: #00b894; margin-right: 5px;"></i><%= member.First_name %> <%= member.Middle_Name %> <%= member.Last_Name %></span>
                </div>

                <div class="ibox-body">
                    <form id="editMemberForm">
                        <!-- Basic Information Section -->
                        <div class="section-title">
                            <i class="fa fa-address-card"></i> Personal Information
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="First_name">First Name</label>
                                <input type="text" id="First_name" name="First_name" class="form-control" value="<%= member.First_name %>" required>
                            </div>
                            <div class="form-group">
                                <label for="Middle_Name">Middle Name</label>
                                <input type="text" id="Middle_Name" name="Middle_Name" class="form-control" value="<%= member.Middle_Name || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="Last_Name">Last Name</label>
                                <input type="text" id="Last_Name" name="Last_Name" class="form-control" value="<%= member.Last_Name %>" required>
                            </div>
                            <div class="form-group">
                                <label for="tel_no">Phone Number</label>
                                <input type="tel" id="tel_no" name="tel_no" class="form-control" value="<%= member.tel_no || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="sex">Gender</label>
                                <select id="sex" name="sex" class="form-select">
                                    <option value="">Select Gender</option>
                                    <option value="Male" <%= member.sex === 'Male' ? 'selected' : '' %>>Male</option>
                                    <option value="Female" <%= member.sex === 'Female' ? 'selected' : '' %>>Female</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="date_of_birth">Date of Birth</label>
                                <input type="date" id="date_of_birth" name="date_of_birth" class="form-control" value="<%= member.date_of_birth || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="national_id">National ID</label>
                                <input type="text" id="national_id" name="national_id" class="form-control" value="<%= member.national_id || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="marital_status">Marital Status</label>
                                <select id="marital_status" name="marital_status" class="form-select">
                                    <option value="">Select Status</option>
                                    <option value="Single" <%= member.marital_status === 'Single' ? 'selected' : '' %>>Single</option>
                                    <option value="Married" <%= member.marital_status === 'Married' ? 'selected' : '' %>>Married</option>
                                    <option value="Divorced" <%= member.marital_status === 'Divorced' ? 'selected' : '' %>>Divorced</option>
                                    <option value="Widowed" <%= member.marital_status === 'Widowed' ? 'selected' : '' %>>Widowed</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="occupation">Occupation</label>
                                <input type="text" id="occupation" name="occupation" class="form-control" value="<%= member.occupation || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="status">Member Status</label>
                                <select id="status" name="status" class="form-select">
                                    <option value="">Select Status</option>
                                    <option value="ACTIVE" <%= member.Status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                                    <option value="INACTIVE" <%= member.Status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
                                    <option value="SUSPENDED" <%= member.Status === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
                                </select>
                            </div>
                        </div>

                        <!-- Location Information -->
                        <div class="section-title" style="margin-top: 18px;">
                            <i class="fa fa-map-marker"></i> Location Information
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="village_lc1">Village/LC1</label>
                                <input type="text" id="village_lc1" name="village_lc1" class="form-control" value="<%= member.village_lc1 || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="parish">Parish</label>
                                <input type="text" id="parish" name="parish" class="form-control" value="<%= member.parish || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="sub_county">Sub-County</label>
                                <input type="text" id="sub_county" name="sub_county" class="form-control" value="<%= member.sub_county || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="place_of_birth">Place of Birth</label>
                                <input type="text" id="place_of_birth" name="place_of_birth" class="form-control" value="<%= member.place_of_birth || '' %>">
                            </div>
                        </div>

                        <!-- Membership Information -->
                        <div class="section-title" style="margin-top: 18px;">
                            <i class="fa fa-calendar"></i> Membership Information
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="date_joined">Date Joined</label>
                                <input type="date" id="date_joined" name="date_joined" class="form-control" value="<%= member.date_joined || '' %>">
                            </div>
                        </div>

                        <!-- Next of Kin -->
                        <div class="section-title" style="margin-top: 18px;">
                            <i class="fa fa-users"></i> Next of Kin
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="next_of_kin_First_name">First Name</label>
                                <input type="text" id="next_of_kin_First_name" name="next_of_kin_First_name" class="form-control" value="<%= member.next_of_kin_First_name || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="next_of_kin_Last_name">Last Name</label>
                                <input type="text" id="next_of_kin_Last_name" name="next_of_kin_Last_name" class="form-control" value="<%= member.next_of_kin_Last_name || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="next_of_kin_tel">Phone</label>
                                <input type="tel" id="next_of_kin_tel" name="next_of_kin_tel" class="form-control" value="<%= member.next_of_kin_tel || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="next_of_kin_address">Address</label>
                                <input type="text" id="next_of_kin_address" name="next_of_kin_address" class="form-control" value="<%= member.next_of_kin_address || '' %>">
                            </div>
                        </div>

                        <!-- Comments -->
                        <div class="section-title" style="margin-top: 18px;">
                            <i class="fa fa-comment"></i> Additional Information
                        </div>

                        <div class="form-group">
                            <label for="comments">Comments</label>
                            <textarea id="comments" name="comments" class="form-control" rows="3" style="resize: vertical;"><%= member.comments || '' %></textarea>
                        </div>

                        <!-- Passport Photo -->
                        <div class="section-title" style="margin-top: 18px;">
                            <i class="fa fa-image"></i> Passport Photo
                        </div>

                        <div class="photo-section">
                            <!-- Current Photo -->
                            <div class="photo-preview">
                                <span class="photo-label">Current Photo</span>
                                <div id="currentPhotoContainer">
                                    <% if (photoBase64) { %>
                                        <img id="currentPhoto" src="data:image/jpeg;base64,<%= photoBase64 %>" alt="Current passport photo">
                                    <% } else { %>
                                        <div class="photo-placeholder">
                                            <i class="fa fa-image"></i>
                                        </div>
                                        <p style="font-size: .75rem; color: #a0aec0; margin: 8px 0;">No photo on record</p>
                                    <% } %>
                                </div>
                            </div>

                            <!-- New Photo Preview -->
                            <div class="photo-preview">
                                <span class="photo-label">Preview New Photo</span>
                                <div id="photoPreviewContainer">
                                    <div class="photo-placeholder" id="photoPreviewPlaceholder">
                                        <i class="fa fa-plus"></i>
                                    </div>
                                </div>
                                <div class="file-input-wrapper">
                                    <input type="file" id="passportPhoto" name="photo" accept="image/*">
                                    <label for="passportPhoto" class="file-input-label">
                                        <i class="fa fa-upload"></i> Choose Photo
                                    </label>
                                </div>
                                <div class="file-input-info">
                                    <i class="fa fa-info-circle"></i> JPG, PNG (Max 5MB)
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div style="display: flex; gap: 10px; margin-top: 20px;">
                            <button type="submit" class="btn btn-save" id="submitBtn">
                                <i class="fa fa-save"></i> Save Changes
                            </button>
                            <a href="/members" class="btn btn-cancel">
                                <i class="fa fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <footer class="page-footer">
            <div>2026 © <b>Agali Awamu SACCO</b> — All rights reserved.</div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        $(document).ready(function() {
            // Photo preview
            $('#passportPhoto').on('change', function(e) {
                const file = e.target.files[0];
                const container = $('#photoPreviewContainer');

                if (file) {
                    // Validate file size (5MB max)
                    if (file.size > 5 * 1024 * 1024) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'File Too Large',
                            text: 'Please select an image smaller than 5MB'
                        });
                        $(this).val('');
                        container.html('<div class="photo-placeholder" id="photoPreviewPlaceholder"><i class="fa fa-plus"></i></div>');
                        return;
                    }

                    // Validate file type
                    if (!file.type.match('image.*')) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Invalid File',
                            text: 'Please select a valid image file'
                        });
                        $(this).val('');
                        container.html('<div class="photo-placeholder" id="photoPreviewPlaceholder"><i class="fa fa-plus"></i></div>');
                        return;
                    }

                    // Show preview
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        container.html('<img src="' + event.target.result + '" alt="Preview" style="max-width: 100%; max-height: 300px; border-radius: 6px;">');
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Form Submission
            $('#editMemberForm').on('submit', async function(e) {
                e.preventDefault();

                $('#loadingOverlay').addClass('active');
                $('#submitBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

                // Use FormData to handle file upload
                const formData = new FormData(this);

                try {
                    const response = await fetch('/members/<%= member.id %>/edit', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();
                    $('#loadingOverlay').removeClass('active');

                    if (response.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Member profile updated successfully',
                            confirmButtonColor: '#00b894'
                        }).then(() => {
                            window.location.href = '/members';
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Update Failed',
                            text: result.error || result.message || 'An error occurred while updating'
                        });
                        $('#submitBtn').prop('disabled', false).html('<i class="fa fa-save"></i> Save Changes');
                    }
                } catch (error) {
                    $('#loadingOverlay').removeClass('active');
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An unexpected error occurred: ' + error.message
                    });
                    $('#submitBtn').prop('disabled', false).html('<i class="fa fa-save"></i> Save Changes');
                }
            });
        });
    </script>
</body>
</html>