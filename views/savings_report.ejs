<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Savings Summary Report</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading { padding: 14px 22px 0; }
        .page-heading h3 { font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0; }
        .page-subtitle { margin-top: 4px; color: #718096; font-size: .78rem; }
        .page-content { padding: 12px 22px 24px; }
        .page-footer { padding: 12px 22px; font-size: .72rem; color: #a0aec0; text-align: center; border-top: 1px solid #eaeef2; background: #fff; }

        .hero-strip {
            background: linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(14, 165, 233, 0.16);
        }
        .hero-strip .title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .hero-strip .meta {
            font-size: .78rem;
            opacity: .92;
        }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #eaeef2;
            background: #fff;
            flex-wrap: wrap;
        }
        .ibox-title {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #718096;
        }
        .ibox-body { padding: 14px; background: #fff; }

        .btn {
            font-size: .75rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            transition: all .15s;
        }
        .btn-sm { padding: 5px 12px; font-size: .7rem; }
        .btn-primary { background: #0ea5e9; border: none; color: #fff; }
        .btn-primary:hover { background: #0284c7; color: #fff; }
        .btn-secondary { background: #edf2f7; border: none; color: #2d3748; }
        .btn-secondary:hover { background: #e2e8f0; color: #1a202c; }
        .btn-outline-primary { border: 1px solid #0ea5e9; color: #0ea5e9; background: #fff; }
        .btn-outline-primary:hover { background: #0ea5e9; color: #fff; }

        .filters-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            align-items: end;
        }
        @media (max-width: 991px) {
            .filters-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 575px) {
            .filters-grid { grid-template-columns: 1fr; }
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (max-width: 767px) {
            .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 575px) {
            .summary-grid { grid-template-columns: 1fr; }
        }
        .metric-card {
            background: #fff;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            padding: 14px;
            min-height: 104px;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
        }
        .metric-label {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #718096;
            margin-bottom: 10px;
        }
        .metric-value {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1f2e;
            line-height: 1.35;
        }
        .metric-sub {
            margin-top: 6px;
            font-size: .72rem;
            color: #718096;
        }

        .form-group label {
            font-size: .75rem;
            font-weight: 600;
            color: #1a1f2e;
            margin-bottom: 5px;
        }
        .form-control {
            font-size: .75rem;
            padding: 8px 10px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            background: #fff;
            min-height: 38px;
        }
        .form-control:focus {
            border-color: #0ea5e9;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
        }

        .table-responsive { overflow-x: auto; }
        #savingsTable {
            width: 100% !important;
            font-size: .75rem;
        }
        #savingsTable thead th {
            padding: 7px 8px;
            font-size: .72rem;
            font-weight: 700;
            background: #f7fafc;
            border-bottom: 2px solid #eaeef2;
            color: #1a1f2e;
            white-space: nowrap;
        }
        #savingsTable tbody td {
            padding: 7px 8px;
            vertical-align: middle;
            border-color: #eaeef2;
        }
        #savingsTable tbody tr:hover { background: #f7fafc; }
        .text-right { text-align: right !important; }
        .details-control {
            cursor: pointer;
            text-align: center;
            color: #0ea5e9;
            font-weight: 700;
        }
        .details-control:before { content: '+'; font-size: 18px; }
        tr.shown .details-control:before { content: '-'; }

        .child-row-content {
            background: #f8fbff;
            padding: 16px;
            border: 1px solid #dbeafe;
            border-radius: 8px;
        }
        .monthly-details {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
        }
        @media (max-width: 991px) {
            .monthly-details { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }
        @media (max-width: 575px) {
            .monthly-details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .month-item {
            padding: 10px;
            background: #fff;
            border: 1px solid #dbeafe;
            border-radius: 8px;
        }
        .month-name {
            font-weight: 700;
            color: #475569;
            font-size: .78rem;
            margin-bottom: 4px;
        }
        .month-amount {
            color: #0f766e;
            font-size: .85rem;
            font-weight: 700;
        }

        .dataTables_wrapper { font-size: .75rem; }
        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: .75rem;
        }
        .dataTables_wrapper .pagination .page-link {
            font-size: .75rem;
            padding: .4rem .6rem;
            color: #0ea5e9;
        }
        .dataTables_wrapper .pagination .page-item.active .page-link {
            background: #0ea5e9;
            border-color: #0ea5e9;
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <h3><i class="fa fa-piggy-bank" style="color: #0ea5e9; margin-right: 8px;"></i>Savings Summary Report</h3>
            <div class="page-subtitle">Member savings position, year-to-date movement, and monthly contribution breakdown.</div>
        </div>

        <div class="page-content">
            <div class="hero-strip">
                <div class="title">Member savings overview</div>
                <div class="meta">Expand a row to inspect monthly savings movement for the current year.</div>
            </div>

            <div class="summary-grid">
                <div class="metric-card">
                    <div class="metric-label">Members Shown</div>
                    <div class="metric-value" id="membersShown">-</div>
                    <div class="metric-sub">Current filtered export set</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Opening Balance</div>
                    <div class="metric-value" id="openingBalanceTotal">-</div>
                    <div class="metric-sub">Brought forward before this year</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Deposits YTD</div>
                    <div class="metric-value" id="depositsTotal">-</div>
                    <div class="metric-sub">Savings paid this year</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Net Total</div>
                    <div class="metric-value" id="netTotal">-</div>
                    <div class="metric-sub">Savings less withdrawals</div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Filters & Actions</div>
                    <div class="ibox-tools">
                        <button class="btn btn-outline-primary btn-sm" id="excelExportBtn">
                            <i class="fa fa-file-excel-o"></i> Excel Export
                        </button>
                        <button class="btn btn-secondary btn-sm" id="pdfExportBtn">
                            <i class="fa fa-file-pdf-o"></i> PDF Print
                        </button>
                    </div>
                </div>
                <div class="ibox-body">
                    <div class="filters-grid">
                        <div class="form-group mb-0">
                            <label for="memberId">Member ID</label>
                            <input type="text" id="memberId" class="form-control" placeholder="Member ID">
                        </div>
                        <div class="form-group mb-0">
                            <label for="memberName">Member Name</label>
                            <input type="text" id="memberName" class="form-control" placeholder="Member name">
                        </div>
                        <div class="form-group mb-0">
                            <label for="phoneNumber">Phone Number</label>
                            <input type="text" id="phoneNumber" class="form-control" placeholder="Phone number">
                        </div>
                        <div class="form-group mb-0">
                            <label>&nbsp;</label>
                            <div style="display:flex; gap:10px;">
                                <button id="filterBtn" class="btn btn-primary btn-sm btn-block">
                                    <i class="fa fa-filter"></i> Apply
                                </button>
                                <button id="clearBtn" class="btn btn-secondary btn-sm btn-block">
                                    <i class="fa fa-undo"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Member Savings Summary</div>
                </div>
                <div class="ibox-body">
                    <div class="table-responsive">
                        <table id="savingsTable" class="table table-striped table-bordered table-hover" cellspacing="0">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th class="text-right">B/F</th>
                                    <th class="text-right">Deposits YTD</th>
                                    <th class="text-right">Withdrawals YTD</th>
                                    <th class="text-right">Net YTD</th>
                                    <th class="text-right">Net Total</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            2026 © Agali Awamu SACCO — All rights reserved.
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <script>
        function formatCurrency(amount) {
            return 'UGX ' + Number(amount || 0).toLocaleString('en-UG', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function getFilterPayload() {
            return {
                memberId: $('#memberId').val(),
                memberName: $('#memberName').val(),
                phoneNumber: $('#phoneNumber').val()
            };
        }

        function formatMonthlyDetails(d) {
            return `
                <div class="child-row-content">
                    <div style="font-weight:700; color:#1a1f2e; margin-bottom: 14px;">Monthly Breakdown for ${escapeHtml(d.Name)}</div>
                    <div class="monthly-details">
                        ${[
                            ['January', d.Jan], ['February', d.Feb], ['March', d.Mar], ['April', d.April],
                            ['May', d.May], ['June', d.June], ['July', d.July], ['August', d.Aug],
                            ['September', d.Sept], ['October', d.Oct], ['November', d.Nov], ['December', d.Dec]
                        ].map(([label, value]) => `
                            <div class="month-item">
                                <div class="month-name">${escapeHtml(label)}</div>
                                <div class="month-amount">${escapeHtml(formatCurrency(value))}</div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        async function fetchAllSavingsRows() {
            const response = await $.ajax({
                url: '/savings_report/savings-summary',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ...getFilterPayload(),
                    start: 0,
                    length: 10000,
                    draw: 1
                })
            });

            return Array.isArray(response.data) ? response.data : [];
        }

        function updateSummaryCards(rows) {
            const totals = rows.reduce((acc, row) => {
                acc.count += 1;
                acc.bf += Number(row.BF || 0);
                acc.deposits += Number(row.Total_Deposits_YTD || 0);
                acc.net += Number(row.Net_Total || 0);
                return acc;
            }, { count: 0, bf: 0, deposits: 0, net: 0 });

            $('#membersShown').text(totals.count);
            $('#openingBalanceTotal').text(formatCurrency(totals.bf));
            $('#depositsTotal').text(formatCurrency(totals.deposits));
            $('#netTotal').text(formatCurrency(totals.net));
        }

        function exportSavingsExcel(rows) {
            if (!rows.length) {
                alert('No savings rows available for export.');
                return;
            }

            let tableHtml = `
                <table>
                    <tr><th colspan="21">Savings Summary Report</th></tr>
                </table>
                <br />
                <table border="1">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>B/F</th>
                            <th>Deposits YTD</th>
                            <th>Withdrawals YTD</th>
                            <th>Net YTD</th>
                            <th>Net Total</th>
                            <th>Jan</th>
                            <th>Feb</th>
                            <th>Mar</th>
                            <th>Apr</th>
                            <th>May</th>
                            <th>Jun</th>
                            <th>Jul</th>
                            <th>Aug</th>
                            <th>Sep</th>
                            <th>Oct</th>
                            <th>Nov</th>
                            <th>Dec</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            rows.forEach(row => {
                tableHtml += `
                    <tr>
                        <td>${escapeHtml(row.id)}</td>
                        <td>${escapeHtml(row.Name)}</td>
                        <td>${escapeHtml(row.Tel_No)}</td>
                        <td>${escapeHtml(Number(row.BF || 0))}</td>
                        <td>${escapeHtml(Number(row.Total_Deposits_YTD || 0))}</td>
                        <td>${escapeHtml(Number(row.Total_Withdrawals_YTD || 0))}</td>
                        <td>${escapeHtml(Number(row.Net_Savings_YTD || 0))}</td>
                        <td>${escapeHtml(Number(row.Net_Total || 0))}</td>
                        <td>${escapeHtml(Number(row.Jan || 0))}</td>
                        <td>${escapeHtml(Number(row.Feb || 0))}</td>
                        <td>${escapeHtml(Number(row.Mar || 0))}</td>
                        <td>${escapeHtml(Number(row.April || 0))}</td>
                        <td>${escapeHtml(Number(row.May || 0))}</td>
                        <td>${escapeHtml(Number(row.June || 0))}</td>
                        <td>${escapeHtml(Number(row.July || 0))}</td>
                        <td>${escapeHtml(Number(row.Aug || 0))}</td>
                        <td>${escapeHtml(Number(row.Sept || 0))}</td>
                        <td>${escapeHtml(Number(row.Oct || 0))}</td>
                        <td>${escapeHtml(Number(row.Nov || 0))}</td>
                        <td>${escapeHtml(Number(row.Dec || 0))}</td>
                    </tr>
                `;
            });

            tableHtml += '</tbody></table>';

            const blob = new Blob(['\ufeff' + tableHtml], { type: 'application/vnd.ms-excel' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'savings-summary-report.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(link.href);
        }

        function printSavingsPdf(rows) {
            if (!rows.length) {
                alert('No savings rows available for printing.');
                return;
            }

            const printWindow = window.open('', '_blank', 'width=1200,height=800');
            if (!printWindow) {
                alert('Please allow popups to print the report.');
                return;
            }

            const summaryCardsHtml = document.querySelector('.summary-grid').innerHTML;
            const rowsHtml = rows.map(row => `
                <tr>
                    <td>${escapeHtml(row.id)}</td>
                    <td>${escapeHtml(row.Name)}</td>
                    <td>${escapeHtml(row.Tel_No)}</td>
                    <td style="text-align:right;">${escapeHtml(formatCurrency(row.BF))}</td>
                    <td style="text-align:right;">${escapeHtml(formatCurrency(row.Total_Deposits_YTD))}</td>
                    <td style="text-align:right;">${escapeHtml(formatCurrency(row.Total_Withdrawals_YTD))}</td>
                    <td style="text-align:right;">${escapeHtml(formatCurrency(row.Net_Total))}</td>
                </tr>
            `).join('');

            printWindow.document.write(`
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <title>Savings Summary Report</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 24px; color: #1a1f2e; }
                        h1 { margin: 0 0 6px; font-size: 24px; }
                        .meta { color: #4a5568; margin-bottom: 18px; font-size: 13px; }
                        .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
                        .metric-card { border: 1px solid #dfe6ee; border-radius: 8px; padding: 12px; }
                        .metric-label { font-size: 11px; text-transform: uppercase; color: #718096; font-weight: 700; margin-bottom: 8px; }
                        .metric-value { font-size: 16px; font-weight: 700; }
                        .metric-sub { font-size: 11px; color: #718096; margin-top: 6px; }
                        table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 12px; }
                        th, td { border: 1px solid #dfe6ee; padding: 7px 8px; text-align: left; }
                        th { background: #f7fafc; }
                    </style>
                </head>
                <body>
                    <h1>Savings Summary Report</h1>
                    <div class="meta">Generated from current filters</div>
                    <div class="grid">${summaryCardsHtml}</div>
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>B/F</th>
                                <th>Deposits YTD</th>
                                <th>Withdrawals YTD</th>
                                <th>Net Total</th>
                            </tr>
                        </thead>
                        <tbody>${rowsHtml}</tbody>
                    </table>
                </body>
                </html>
            `);

            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => printWindow.print(), 400);
        }

        $(document).ready(function() {
            const table = $('#savingsTable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                pageLength: 25,
                order: [[1, 'asc']],
                ajax: {
                    url: '/savings_report/savings-summary',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function(d) {
                        return JSON.stringify({
                            ...d,
                            ...getFilterPayload()
                        });
                    },
                    dataSrc: function(json) {
                        updateSummaryCards(Array.isArray(json.data) ? json.data : []);
                        return json.data;
                    },
                    error: function(xhr) {
                        alert('Error: ' + (xhr.responseJSON?.error || 'Could not load data.'));
                    }
                },
                columns: [
                    {
                        className: 'details-control',
                        orderable: false,
                        data: null,
                        defaultContent: '',
                        width: '3%'
                    },
                    { data: 'id', width: '6%' },
                    { data: 'Name', width: '18%' },
                    { data: 'Tel_No', width: '12%' },
                    {
                        data: 'BF',
                        width: '10%',
                        className: 'text-right',
                        render: function(data) { return formatCurrency(data); }
                    },
                    {
                        data: 'Total_Deposits_YTD',
                        width: '11%',
                        className: 'text-right',
                        render: function(data) { return '<strong style="color:#2f855a;">' + escapeHtml(formatCurrency(data)) + '</strong>'; }
                    },
                    {
                        data: 'Total_Withdrawals_YTD',
                        width: '11%',
                        className: 'text-right',
                        render: function(data) { return '<strong style="color:#c53030;">' + escapeHtml(formatCurrency(data)) + '</strong>'; }
                    },
                    {
                        data: 'Net_Savings_YTD',
                        width: '11%',
                        className: 'text-right',
                        render: function(data) {
                            const color = Number(data || 0) >= 0 ? '#2f855a' : '#c53030';
                            return '<strong style="color:' + color + ';">' + escapeHtml(formatCurrency(data)) + '</strong>';
                        }
                    },
                    {
                        data: 'Net_Total',
                        width: '11%',
                        className: 'text-right',
                        render: function(data) {
                            const color = Number(data || 0) >= 0 ? '#2f855a' : '#c53030';
                            return '<strong style="color:' + color + ';">' + escapeHtml(formatCurrency(data)) + '</strong>';
                        }
                    }
                ],
                dom: '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>',
                scrollX: true,
                autoWidth: false
            });

            $('#savingsTable tbody').on('click', 'td.details-control', function() {
                const tr = $(this).closest('tr');
                const row = table.row(tr);

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                } else {
                    row.child(formatMonthlyDetails(row.data())).show();
                    tr.addClass('shown');
                }
            });

            $('#filterBtn').on('click', function() {
                table.ajax.reload();
                fetchAllSavingsRows().then(updateSummaryCards).catch(function() {});
            });

            $('#clearBtn').on('click', function() {
                $('#memberId, #memberName, #phoneNumber').val('');
                table.ajax.reload();
                fetchAllSavingsRows().then(updateSummaryCards).catch(function() {});
            });

            $('#excelExportBtn').on('click', async function() {
                const rows = await fetchAllSavingsRows();
                updateSummaryCards(rows);
                exportSavingsExcel(rows);
            });

            $('#pdfExportBtn').on('click', async function() {
                const rows = await fetchAllSavingsRows();
                updateSummaryCards(rows);
                printSavingsPdf(rows);
            });

            fetchAllSavingsRows().then(updateSummaryCards).catch(function() {});
        });
    </script>
</body>
</html>
