<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - SACCO Management System</title>
    <link href="./assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="./assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="./assets/vendors/themify-icons/css/themify-icons.css" rel="stylesheet" />
    <link href="assets/css/main.min.css" rel="stylesheet" />

    <style>
        body { overflow-x: hidden; }
        .sidebar { position: fixed; left: 0; top: 0; }
        .content { margin-left: 250px; padding: 20px; }
        .member-stat { border-radius: 6px; overflow: hidden; margin-bottom: 15px; }
        .member-stat .ibox-body { padding: 15px; }
    </style>

</head>
<body class="bg-light">

<%- include('partials/member_sidebar') %>

<div class="content">

    <h3>Member Dashboard</h3>

    <div class="row">

        <div class="col-md-6">
            <div class="ibox member-stat">
                <div class="ibox-body bg-white">
                    <h5>Total Savings</h5>
                    <h3 class="text-success">
                        UGX <%= totalSavings.toLocaleString() %>
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="ibox member-stat">
                <div class="ibox-body bg-white">
                    <h5>Outstanding Loan</h5>
                    <h3 class="text-danger">
                        UGX <%= outstandingLoan.toLocaleString() %>
                    </h3>
                </div>
            </div>
        </div>

    </div>

</div>

</body>
</html>