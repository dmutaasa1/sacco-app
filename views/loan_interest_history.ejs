<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Interest History - Loan #<%= loan.id %></title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading { padding: 14px 22px 0; }
        .page-heading h3 { font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0; }
        .page-subtitle { margin-top: 4px; color: #718096; font-size: .78rem; }
        .page-content { padding: 12px 22px 24px; }
        .page-footer { padding: 12px 22px; font-size: .72rem; color: #a0aec0; text-align: center; border-top: 1px solid #eaeef2; background: #fff; }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #eaeef2;
            background: #fff;
        }
        .ibox-title {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #718096;
        }
        .ibox-body { padding: 14px; background: #fff; }

        .btn {
            font-size: .75rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            transition: all .15s;
        }
        .btn-sm { padding: 5px 12px; font-size: .7rem; }
        .btn-primary { background: #00b894; border: none; color: #fff; }
        .btn-primary:hover { background: #00a388; color: #fff; }
        .btn-secondary { background: #edf2f7; border: none; color: #2d3748; }
        .btn-secondary:hover { background: #e2e8f0; color: #1a202c; }
        .btn-outline-primary {
            border: 1px solid #00b894;
            color: #00b894;
            background: #fff;
        }
        .btn-outline-primary:hover {
            background: #00b894;
            color: #fff;
        }

        .hero-strip {
            background: linear-gradient(135deg, #00b894 0%, #008f76 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(0, 184, 148, 0.16);
        }
        .hero-strip .title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .hero-strip .meta {
            font-size: .78rem;
            opacity: .92;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (max-width: 1199px) {
            .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 575px) {
            .summary-grid { grid-template-columns: 1fr; }
        }
        .metric-card {
            background: #fff;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            padding: 14px;
            min-height: 104px;
        }
        .metric-label {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #718096;
            margin-bottom: 10px;
        }
        .metric-value {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1f2e;
            line-height: 1.35;
        }
        .metric-sub {
            margin-top: 6px;
            font-size: .72rem;
            color: #718096;
        }

        .table-responsive { overflow-x: auto; }
        #interestTable {
            width: 100% !important;
            font-size: .75rem;
        }
        #interestTable thead th {
            padding: 7px 8px;
            font-size: .72rem;
            font-weight: 700;
            background: #f7fafc;
            border-bottom: 2px solid #eaeef2;
            color: #1a1f2e;
            white-space: nowrap;
        }
        #interestTable tbody td,
        #interestTable tfoot td {
            padding: 7px 8px;
            vertical-align: middle;
            border-color: #eaeef2;
        }
        #interestTable tbody tr:hover { background: #f7fafc; }
        #interestTable tfoot tr {
            background: #edfdf8;
            font-weight: 700;
        }
        .text-right { text-align: right !important; }

        .status-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
            white-space: nowrap;
            background: rgba(49, 130, 206, .12);
            color: #2b6cb0;
        }

        .dataTables_wrapper { font-size: .75rem; }
        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: .75rem;
        }
        .dataTables_wrapper .pagination .page-link {
            font-size: .75rem;
            padding: .4rem .6rem;
            color: #00b894;
        }
        .dataTables_wrapper .pagination .page-item.active .page-link {
            background: #00b894;
            border-color: #00b894;
        }

        .note-panel {
            margin-top: 12px;
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid #bee3f8;
            background: #ebf8ff;
            color: #2c5282;
            font-size: .75rem;
        }
    </style>
</head>

<body>
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <h3><i class="fa fa-line-chart" style="color: #00b894; margin-right: 8px;"></i>Loan Interest History</h3>
            <div class="page-subtitle">Daily interest calculations and outstanding balance movement for this loan.</div>
        </div>

        <div class="page-content">
            <div class="hero-strip">
                <div class="title">Loan #<%= loan.id %> interest history for <%= loan.member_name %></div>
                <div class="meta">
                    Reducing balance loan •
                    Current balance UGX <%= parseFloat(loan.balance).toLocaleString('en-UG', { maximumFractionDigits: 0 }) %> •
                    Annual rate <%= parseFloat(loan.interest_rate).toFixed(2) %>%
                </div>
            </div>

            <div class="summary-grid">
                <div class="metric-card">
                    <div class="metric-label">Loan Amount</div>
                    <div class="metric-value">UGX <%= parseFloat(loan.loan_amount).toLocaleString('en-UG', { maximumFractionDigits: 0 }) %></div>
                    <div class="metric-sub">Original disbursed principal</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Current Balance</div>
                    <div class="metric-value">UGX <%= parseFloat(loan.balance).toLocaleString('en-UG', { maximumFractionDigits: 0 }) %></div>
                    <div class="metric-sub">Outstanding principal</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Accumulated Interest</div>
                    <div class="metric-value">UGX <%= parseFloat(loan.accumulated_interest).toLocaleString('en-UG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                    <div class="metric-sub">Interest currently carried on the loan</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Status</div>
                    <div class="metric-value"><span class="status-pill"><%= loan.status %></span></div>
                    <div class="metric-sub"><%= parseFloat(loan.interest_rate).toFixed(2) %>% per annum</div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Interest History Actions</div>
                    <div class="ibox-tools">
                        <a href="/Loan_statement?loan_id=<%= loan.id %>" class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-file-text"></i> View Statement
                        </a>
                        <a href="/loans/<%= loan.id %>/interest-export" class="btn btn-primary btn-sm">
                            <i class="fa fa-download"></i> Export CSV
                        </a>
                    </div>
                </div>
                <div class="ibox-body">
                    <div class="note-panel">
                        <i class="fa fa-info-circle"></i>
                        Each row shows the daily interest accrued using the loan’s outstanding balance on that date. This view is intended for reducing-balance loans where interest is calculated day by day.
                    </div>
                </div>
            </div>

            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-title">Daily Interest Calculations</div>
                </div>
                <div class="ibox-body">
                    <div class="table-responsive">
                        <table id="interestTable" class="table table-striped table-bordered table-hover" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-right">Outstanding Balance</th>
                                    <th class="text-right">Daily Interest</th>
                                    <th class="text-right">Annual Rate</th>
                                    <th class="text-right">Daily Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% history.forEach(record => { %>
                                    <tr>
                                        <td><%= new Date(record.calculation_date).toLocaleDateString('en-GB') %></td>
                                        <td class="text-right">UGX <%= parseFloat(record.outstanding_balance).toLocaleString('en-UG', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></td>
                                        <td class="text-right">UGX <%= parseFloat(record.daily_interest_amount).toLocaleString('en-UG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-right"><%= parseFloat(record.annual_interest_rate).toFixed(2) %>%</td>
                                        <td class="text-right"><%= (parseFloat(record.annual_interest_rate) / 365).toFixed(6) %>%</td>
                                    </tr>
                                <% }); %>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>Total</td>
                                    <td></td>
                                    <td id="totalInterest" class="text-right"></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            2026 © Agali Awamu SACCO — All rights reserved.
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#interestTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 50,
                lengthMenu: [[25, 50, 100, -1], [25, 50, 100, 'All']],
                scrollX: true,
                autoWidth: false,
                columnDefs: [
                    { targets: [1, 2, 3, 4], className: 'text-right' }
                ],
                footerCallback: function() {
                    const api = this.api();
                    const total = api
                        .column(2, { page: 'current' })
                        .data()
                        .reduce(function(a, b) {
                            const num = parseFloat(String(b).replace(/[^0-9.-]+/g, ''));
                            return a + (isNaN(num) ? 0 : num);
                        }, 0);

                    $('#totalInterest').html('UGX ' + total.toLocaleString('en-UG', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }));
                },
                dom: '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>'
            });
        });
    </script>
</body>
</html>
