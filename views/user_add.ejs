<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New User</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --users-primary: #0ea5e9;
            --users-primary-dark: #0369a1;
            --users-soft: #f0f9ff;
            --users-border: #dbeafe;
            --users-text: #1a1f2e;
            --users-muted: #718096;
            --users-success: #047857;
        }

        * { box-sizing: border-box; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }
        body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }

        .page-wrapper {
            margin-left: 220px !important;
            margin-top: 60px;
            width: calc(100% - 220px) !important;
            max-width: 100%;
            transition: margin-left .22s ease, width .22s ease;
        }
        body.sidebar-collapsed .page-wrapper {
            margin-left: 60px !important;
            width: calc(100% - 60px) !important;
        }
        @media (max-width: 991px) {
            .page-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100%;
            }
            .page-heading { padding: 12px 14px 0; }
            .page-content { padding: 12px 14px 24px; }
        }

        .page-heading {
            padding: 14px 22px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }
        .page-heading h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--users-text);
            margin: 0;
        }
        .page-subtitle {
            margin-top: 4px;
            color: var(--users-muted);
            font-size: .78rem;
        }
        .page-content { padding: 12px 22px 24px; }
        .page-footer {
            padding: 12px 22px;
            font-size: .72rem;
            color: #a0aec0;
            text-align: center;
            border-top: 1px solid #eaeef2;
            background: #fff;
        }

        .top-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: .75rem;
            font-weight: 600;
            background: var(--users-soft);
            color: var(--users-primary-dark);
            border: 1px solid var(--users-border);
            text-decoration: none;
        }
        .top-link:hover {
            text-decoration: none;
            color: var(--users-primary-dark);
            background: #e0f2fe;
        }

        .hero-strip {
            background: linear-gradient(135deg, var(--users-primary) 0%, var(--users-primary-dark) 100%);
            border-radius: 10px;
            color: #fff;
            padding: 16px 18px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(14, 165, 233, 0.16);
        }
        .hero-strip .title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .hero-strip .meta {
            font-size: .78rem;
            opacity: .92;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }
        @media (max-width: 767px) {
            .summary-grid { grid-template-columns: 1fr; }
        }
        .metric-card {
            background: #fff;
            border: 1px solid var(--users-border);
            border-radius: 10px;
            padding: 14px;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            position: relative;
            min-height: 102px;
        }
        .metric-card::after {
            content: '';
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            border-radius: 10px 0 0 10px;
            background: linear-gradient(180deg, var(--users-primary), var(--users-primary-dark));
        }
        .metric-label {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--users-muted);
            margin-bottom: 10px;
        }
        .metric-value {
            font-size: 1rem;
            font-weight: 700;
            color: var(--users-text);
            line-height: 1.35;
        }
        .metric-sub {
            margin-top: 6px;
            font-size: .72rem;
            color: var(--users-muted);
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
            gap: 14px;
            align-items: start;
        }
        @media (max-width: 991px) {
            .content-grid { grid-template-columns: 1fr; }
        }

        .ibox {
            margin-bottom: 14px !important;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 1px 6px rgba(26,31,46,.06);
            border: 1px solid #eaeef2;
        }
        .ibox-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #eaeef2;
            background: #fff;
            flex-wrap: wrap;
        }
        .ibox-title {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--users-muted);
        }
        .ibox-body { padding: 14px; background: #fff; }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }
        @media (max-width: 767px) {
            .form-grid { grid-template-columns: 1fr; }
        }
        .form-group label {
            font-size: .75rem;
            font-weight: 600;
            color: var(--users-text);
            margin-bottom: 5px;
        }
        .form-control {
            font-size: .75rem;
            padding: 8px 10px;
            border: 1px solid #d9e2ec;
            border-radius: 6px;
            min-height: 38px;
            background: #fff;
        }
        .form-control:focus {
            border-color: var(--users-primary);
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
        }
        .form-control[readonly] {
            background: #f8fafc;
        }
        .form-hint {
            margin-top: 5px;
            font-size: .68rem;
            color: var(--users-muted);
        }

        .full-span { grid-column: 1 / -1; }

        .role-pill-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }
        .role-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 700;
            background: #f8fafc;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .btn {
            font-size: .75rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            transition: all .15s;
        }
        .btn-primary {
            background: var(--users-primary);
            border: none;
            color: #fff;
        }
        .btn-primary:hover {
            background: var(--users-primary-dark);
            color: #fff;
        }
        .btn-secondary {
            background: #edf2f7;
            border: none;
            color: #2d3748;
        }
        .btn-secondary:hover {
            background: #e2e8f0;
            color: #1a202c;
        }
        .btn-success {
            background: var(--users-success);
            border: none;
            color: #fff;
        }
        .btn-success:hover {
            background: #065f46;
            color: #fff;
        }

        .actions-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        .helper-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .helper-item {
            padding: 12px;
            border: 1px solid #eaeef2;
            border-radius: 10px;
            background: #fff;
        }
        .helper-title {
            font-size: .74rem;
            font-weight: 700;
            color: var(--users-text);
            margin-bottom: 4px;
        }
        .helper-copy {
            font-size: .72rem;
            color: var(--users-muted);
            line-height: 1.5;
        }
    </style>
</head>

<body class="fixed-navbar">
    <div class="page-wrapper">
        <%- include('partials/header') %>
        <%- include('partials/sidebar') %>

        <div class="page-heading">
            <div>
                <h3><i class="fa fa-user-plus" style="color:var(--users-primary); margin-right: 8px;"></i>Add New User</h3>
                <div class="page-subtitle">Create a new system account, assign the correct role, and optionally link it to an active member.</div>
            </div>
            <a href="/users" class="top-link">
                <i class="fa fa-arrow-left"></i> Back to Users
            </a>
        </div>

        <div class="page-content">
            <div class="hero-strip">
                <div class="title">New user setup</div>
                <div class="meta">Use this form to create admin, user, or member accounts with the correct access profile from the start.</div>
            </div>

            <div class="summary-grid">
                <div class="metric-card">
                    <div class="metric-label">Available Roles</div>
                    <div class="metric-value">3</div>
                    <div class="metric-sub">User, Admin, and Member access levels</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Member Accounts</div>
                    <div class="metric-value"><%= (members || []).length %></div>
                    <div class="metric-sub">Active members available for account linking</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Default Status</div>
                    <div class="metric-value">Active</div>
                    <div class="metric-sub">New users start enabled unless changed here</div>
                </div>
            </div>

            <div class="content-grid">
                <div class="ibox">
                    <div class="ibox-head">
                        <div class="ibox-title">User Registration Form</div>
                    </div>
                    <div class="ibox-body">
                        <form id="addUserForm">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="username">Username <span class="text-danger">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="username"
                                        name="username"
                                        required
                                        placeholder="Enter username"
                                    >
                                </div>

                                <div class="form-group">
                                    <label for="role">Role <span class="text-danger">*</span></label>
                                    <select class="form-control" id="role" name="role" required>
                                        <option value="">Select Role</option>
                                        <option value="user">User</option>
                                        <option value="admin">Admin</option>
                                        <option value="member">Member</option>
                                    </select>
                                    <div class="role-pill-row">
                                        <span class="role-pill"><i class="fa fa-user"></i> User</span>
                                        <span class="role-pill"><i class="fa fa-shield"></i> Admin</span>
                                        <span class="role-pill"><i class="fa fa-users"></i> Member</span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="first_name">First Name <span class="text-danger">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="first_name"
                                        name="first_name"
                                        required
                                        placeholder="Enter first name"
                                    >
                                </div>

                                <div class="form-group">
                                    <label for="last_name">Last Name <span class="text-danger">*</span></label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="last_name"
                                        name="last_name"
                                        required
                                        placeholder="Enter last name"
                                    >
                                </div>

                                <div class="form-group full-span d-none" id="memberPickerRow">
                                    <label for="member_id">Member ID <span class="text-danger">*</span></label>
                                    <select class="form-control" id="member_id" name="member_id">
                                        <option value="">Select active member</option>
                                        <% (members || []).forEach(function(member) { %>
                                            <option
                                                value="<%= member.id %>"
                                                data-first-name="<%= member.First_name %>"
                                                data-last-name="<%= member.Last_Name %>">
                                                <%= member.id %> - <%= member.First_name %> <%= member.Last_Name %>
                                            </option>
                                        <% }); %>
                                    </select>
                                    <div class="form-hint">For member accounts, the name fields will be filled from the members register.</div>
                                </div>

                                <div class="form-group">
                                    <label for="password">Password <span class="text-danger">*</span></label>
                                    <input
                                        type="password"
                                        class="form-control"
                                        id="password"
                                        name="password"
                                        required
                                        minlength="6"
                                        placeholder="Minimum 6 characters"
                                    >
                                    <div class="form-hint">Use at least 6 characters.</div>
                                </div>

                                <div class="form-group">
                                    <label for="confirm_password">Confirm Password <span class="text-danger">*</span></label>
                                    <input
                                        type="password"
                                        class="form-control"
                                        id="confirm_password"
                                        name="confirm_password"
                                        required
                                        placeholder="Re-enter password"
                                    >
                                </div>

                                <div class="form-group">
                                    <label for="status">Status <span class="text-danger">*</span></label>
                                    <select class="form-control" id="status" name="status" required>
                                        <option value="active" selected>Active</option>
                                        <option value="inactive">Inactive</option>
                                    </select>
                                </div>
                            </div>

                            <div class="actions-row">
                                <button type="submit" class="btn btn-success" id="submitBtn">
                                    <i class="fa fa-plus"></i> Create User
                                </button>
                                <a href="/users" class="btn btn-secondary">
                                    <i class="fa fa-times"></i> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="ibox">
                    <div class="ibox-head">
                        <div class="ibox-title">Quick Guidance</div>
                    </div>
                    <div class="ibox-body">
                        <div class="helper-list">
                            <div class="helper-item">
                                <div class="helper-title">Admin accounts</div>
                                <div class="helper-copy">Use this for staff who need full control over member records, loans, transactions, and reports.</div>
                            </div>
                            <div class="helper-item">
                                <div class="helper-title">Member accounts</div>
                                <div class="helper-copy">Pick the linked member first. Their first and last name will populate automatically from the active register.</div>
                            </div>
                            <div class="helper-item">
                                <div class="helper-title">Before saving</div>
                                <div class="helper-copy">Double-check the username, assigned role, and account status so the new user lands with the right access immediately.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-footer">
            2026 &copy; Agali Awamu SACCO - All rights reserved.
        </div>
    </div>

    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        function syncMemberMode() {
            const isMemberRole = ($('#role').val() || '').toLowerCase() === 'member';
            $('#memberPickerRow').toggleClass('d-none', !isMemberRole);
            $('#member_id').prop('required', isMemberRole);
            $('#first_name, #last_name').prop('readonly', isMemberRole);

            if (!isMemberRole) {
                $('#member_id').val('');
                $('#first_name, #last_name').val('');
            } else {
                $('#member_id').trigger('change');
            }
        }

        $('#role').on('change', syncMemberMode);

        $('#member_id').on('change', function() {
            const selected = this.options[this.selectedIndex];
            const firstName = selected ? selected.getAttribute('data-first-name') || '' : '';
            const lastName = selected ? selected.getAttribute('data-last-name') || '' : '';

            $('#first_name').val(firstName);
            $('#last_name').val(lastName);
        });

        syncMemberMode();

        $('#addUserForm').on('submit', async function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            if ((data.role || '').toLowerCase() === 'member' && !data.member_id) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: 'Please select a valid member'
                });
                return;
            }

            if (data.password !== data.confirm_password) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: 'Passwords do not match'
                });
                return;
            }

            $('#submitBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Creating...');

            try {
                const response = await fetch('/users/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Validation Errors',
                        html: result.errors.map(function(e) { return `<p>- ${e}</p>`; }).join('')
                    });

                    $('#submitBtn').prop('disabled', false).html('<i class="fa fa-plus"></i> Create User');
                    return;
                }

                Swal.fire({
                    icon: 'success',
                    title: 'User Created',
                    html: `
                        <p><strong>Username:</strong> ${result.user.username}</p>
                        <p><strong>Name:</strong> ${result.user.first_name} ${result.user.last_name}</p>
                        <p><strong>Role:</strong> ${result.user.role}</p>
                    `
                }).then(() => {
                    window.location.href = '/users';
                });

            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Could not create user'
                });

                $('#submitBtn').prop('disabled', false).html('<i class="fa fa-plus"></i> Create User');
            }
        });
    </script>
</body>
</html>
