<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Financial Statements</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    
    <style>
/* Financial Statements custom styling */
.fs-topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; flex-wrap:wrap; gap:12px; }
.fs-title  { font-weight:700; color:#1a1f2e; }
.fs-sub    { font-size:.78rem; color:#a0aec0; margin-top:2px; }

/* Filter card */
.fs-filter {
    background:#fff; border-radius:8px; padding:14px 16px;
    display:flex; align-items:flex-end; gap:12px; flex-wrap:wrap;
    box-shadow:0 1px 4px rgba(0,0,0,.06); margin-bottom:16px;
    border:1px solid #e9ecef;
}
.fs-filter label { font-size:.7rem; font-weight:600; color:#6c757d; display:block; margin-bottom:4px; text-transform:uppercase; letter-spacing:.4px; }
.fs-filter input[type=date] {
    height:32px; border:1px solid #dee2e6; border-radius:6px;
    padding:0 8px; font-size:.78rem; color:#212529; outline:none;
    font-family:'DM Sans',sans-serif; background:#f8f9fa;
    transition:border-color .15s, box-shadow .15s;
}
.fs-filter input[type=date]:focus { border-color:#00b894; box-shadow:0 0 0 3px rgba(0,184,148,.08); }
.fs-btn {
    height:32px; padding:0 16px; border-radius:6px; border:none; cursor:pointer;
    font-size:.75rem; font-weight:600; font-family:'DM Sans',sans-serif;
    display:inline-flex; align-items:center; gap:6px; transition:all .12s;
}
.fs-btn-primary { background:#00b894; color:#fff; }
.fs-btn-primary:hover { background:#00a37d; box-shadow:0 2px 6px rgba(0,184,148,.25); }
.fs-btn-outline { background:#fff; color:#495057; border:1px solid #dee2e6; }
.fs-btn-outline:hover { background:#f8f9fa; border-color:#adb5bd; }
.fs-btn:disabled { opacity:.5; cursor:not-allowed; }

/* Statement cards */
.fs-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px; }
@media(max-width:1024px){ .fs-grid { grid-template-columns:1fr; } }

.fs-card {
    background:#fff; border-radius:8px; overflow:hidden;
    box-shadow:0 1px 4px rgba(0,0,0,.06); border:1px solid #e9ecef;
}
.fs-card-head {
    padding:10px 14px; display:flex; align-items:center; gap:8px;
    border-bottom:1px solid #f0f1f3;
}
.fs-card-head-ico {
    width:28px; height:28px; border-radius:6px;
    display:flex; align-items:center; justify-content:center; font-size:.8rem; flex-shrink:0;
}
.fs-card-head-title { font-size:.82rem; font-weight:700; color:#212529; }
.fs-card-head-sub   { font-size:.66rem; color:#6c757d; margin-top:2px; }
.fs-card-body { padding:0; }

/* Statement table */
.fs-table { width:100%; border-collapse:collapse; font-size:.78rem; }
.fs-table .sec-row td {
    padding:6px 12px; font-size:.65rem; font-weight:700;
    letter-spacing:.8px; text-transform:uppercase; color:#fff;
    background:#495057;
}
.fs-table .sec-row.income td { background:#00b894; }
.fs-table .sec-row.expense td { background:#dc3545; }
.fs-table .sec-row.asset  td { background:#00b894; }
.fs-table .sec-row.liab   td { background:#dc3545; }
.fs-table .sec-row.equity td { background:#6c757d; }
.fs-table .sec-row.loan   td { background:#00b894; }

.fs-table .item-row td {
    padding:6px 12px; color:#495057;
    border-bottom:1px solid #f8f9fa;
}
.fs-table .item-row:nth-child(even) td { background:#f8f9fa; }
.fs-table .item-row td:last-child { text-align:right; font-variant-numeric:tabular-nums; font-weight:500; color:#212529; }

.fs-table .total-row td {
    padding:6px 12px; font-size:.77rem; font-weight:600;
    background:#f0fdf9; color:#212529;
    border-top:2px solid #00b894;
}
.fs-table .total-row.red td { background:#fff5f5; border-top-color:#dc3545; }
.fs-table .net-row td {
    padding:7px 12px; font-size:.8rem; font-weight:700;
    background:#495057; color:#fff;
}
.fs-table .net-row.surplus td { background:#00b894; }
.fs-table .net-row.deficit td { background:#dc3545; }

/* Summary stats */
.fs-stats { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
.fs-stat {
    flex:1; min-width:120px; background:#fff; border-radius:6px;
    padding:10px 12px; border:1px solid #e9ecef;
    box-shadow:0 1px 3px rgba(0,0,0,.05);
}
.fs-stat-label { font-size:.63rem; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:#6c757d; margin-bottom:3px; }
.fs-stat-value { font-size:.95rem; font-weight:700; color:#212529; font-variant-numeric:tabular-nums; }
.fs-stat-value.green { color:#00b894; }
.fs-stat-value.red   { color:#dc3545; }
.fs-stat-value.blue  { color:#4294dc; }

/* Empty / loading states */
.fs-empty { padding:32px; text-align:center; color:#6c757d; font-size:.8rem; }
.fs-empty i { font-size:1.8rem; display:block; margin-bottom:8px; opacity:.5; }
.fs-spinner { animation:spin 1s linear infinite; }
@keyframes spin{ to{ transform:rotate(360deg); } }

/* Mobile responsive */
@media(max-width:768px) {
    .fs-filter { gap:8px; }
    .fs-btn { font-size:.7rem; padding:0 12px; height:28px; }
    .fs-table { font-size:.7rem; }
}
    </style>
</head>

<body class="fixed-navbar">
