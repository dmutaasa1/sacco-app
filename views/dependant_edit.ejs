<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Dependant - Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; }
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

/* ══════════════════════════════════════════
   BASE LAYOUT — matches dashboard
══════════════════════════════════════════ */
body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
.page-wrapper { 
    margin-left: 220px !important;
    margin-top: 60px; 
    width: calc(100% - 220px) !important; 
    max-width: 100%; 
    transition: margin-left .22s ease, width .22s ease;
}
body.sidebar-collapsed .page-wrapper { 
    margin-left: 60px !important; 
    width: calc(100% - 60px) !important; 
}
@media (max-width: 991px) {
    .page-wrapper { 
        margin-left: 0 !important; 
        width: 100% !important; 
        max-width: 100%; 
    }
    .page-heading { padding: 12px 14px 0; }
    .page-content { padding: 12px 14px 24px; }
}

/* PAGE HEADING */
.page-heading {
    padding: 14px 22px 0;
}
.page-heading h3 {
    font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0;
}

/* SHARED CARD */
.ibox { margin-bottom: 0 !important; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 6px rgba(26,31,46,.06); border: 1px solid #eaeef2; }
.ibox-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border-bottom: 1px solid #eaeef2; background: #fff;
}
.ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
.ibox-body  { padding: 14px; background: #fff; }

/* FORM STYLING */
.form-group label {
    font-size: .75rem;
    font-weight: 600;
    color: #1a1f2e;
    margin-bottom: 5px;
}
.form-control, .form-select {
    font-size: .75rem;
    padding: 6px 10px;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    background: #fff;
}
.form-control:focus, .form-select:focus {
    border-color: #00b894;
    box-shadow: 0 0 0 3px rgba(0, 184, 148, 0.1);
}

/* BUTTONS */
.btn {
    font-size: .75rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 6px;
    transition: all .15s;
}
.btn-save {
    background: #00b894;
    color: #fff;
    border: none;
}
.btn-save:hover {
    background: #00a388;
    color: #fff;
}
.btn-cancel {
    background: #e9ecef;
    color: #555;
    border: none;
}
.btn-cancel:hover {
    background: #dee2e6;
    color: #333;
}

.page-content { padding: 12px 22px 24px; }

.page-footer {
    padding: 12px 22px;
    font-size: .72rem;
    color: #a0aec0;
    text-align: center;
    border-top: 1px solid #eaeef2;
    background: #fff;
}

/* GRID LAYOUT */
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 768px) { .form-grid { grid-template-columns: 1fr; } }

.section-title {
    font-size: .85rem;
    font-weight: 700;
    color: #1a1f2e;
    margin: 14px 0 10px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.section-title i { color: #00b894; }

/* LOADING SPINNER */
.loading-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 9999;
    justify-content: center;
    align-items: center;
}
.loading-overlay.active { display: flex; }
.spinner {
    border: 3px solid rgba(255,255,255,.3);
    border-top: 3px solid #fff;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
}
@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
</style>
</head>
<body>
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
    </div>

    <div class="page-wrapper">
        <!-- START HEADER-->         
        <%- include('partials/header') %>
        <!-- END HEADER-->
        <!-- START SIDEBAR-->
        <%- include('partials/sidebar') %>        
        <!-- END SIDEBAR-->
        
        <div class="page-heading">
            <h3><i class="fa fa-users-o" style="color: #00b894; margin-right: 8px;"></i>Edit Dependant</h3>
        </div>
        
        <div class="page-content">
            <div class="ibox">
                <div class="ibox-body">
                    <form id="editDependantForm">
                        <!-- Status Section -->
                        <div class="section-title">
                            <i class="fa fa-shield"></i> Status
                        </div>
                        <div class="form-group">
                            <label for="status">Dependant Status</label>
                            <select id="status" name="status" class="form-select">
                                <option value="Active" <%= dependant.Status === 'Active' ? 'selected' : '' %>>Active</option>
                                <option value="Disabled" <%= dependant.Status === 'Disabled' ? 'selected' : '' %>>Disabled</option>
                            </select>
                        </div>

                        <!-- Personal Details Section -->
                        <div class="section-title">
                            <i class="fa fa-user"></i> Personal Details
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="First_Name">First Name</label>
                                <input type="text" id="First_Name" name="First_Name" 
                                       class="form-control" 
                                       value="<%= dependant.First_Name || '' %>" required>
                            </div>
                            <div class="form-group">
                                <label for="Middle_Name">Middle Name</label>
                                <input type="text" id="Middle_Name" name="Middle_Name" 
                                       class="form-control" 
                                       value="<%= dependant.Middle_Name || '' %>">
                            </div>
                            <div class="form-group">
                                <label for="Last_Name">Last Name</label>
                                <input type="text" id="Last_Name" name="Last_Name" 
                                       class="form-control" 
                                       value="<%= dependant.Last_Name || '' %>" required>
                            </div>
                            <div class="form-group">
                                <label for="child_date_of_birth">Date of Birth</label>
                                <input type="date" id="child_date_of_birth" name="child_date_of_birth" 
                                       class="form-control" 
                                       value="<%= dependant.child_date_of_birth || '' %>" required>
                            </div>
                            <div class="form-group">
                                <label for="sex">Gender</label>
                                <select id="sex" name="sex" class="form-select" required>
                                    <option value="">Select Gender</option>
                                    <option value="Male" <%= dependant.Gender === 'Male' ? 'selected' : '' %>>Male</option>
                                    <option value="Female" <%= dependant.Gender === 'Female' ? 'selected' : '' %>>Female</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="person_id">Member Number</label>
                                <input type="number" id="person_id" name="person_id" 
                                       class="form-control" 
                                       value="<%= dependant.person_id || '' %>" required>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div style="display: flex; gap: 10px; margin-top: 20px; border-top: 1px solid #eaeef2; padding-top: 14px;">
                            <button type="submit" class="btn btn-save" id="submitBtn">
                                <i class="fa fa-save"></i> Update Dependant
                            </button>
                            <a href="/dependants" class="btn btn-cancel">
                                <i class="fa fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="page-footer">
            2026 © <strong>Agali Awamu SACCO</strong> — All rights reserved.
        </div>
    </div>

    <!-- CORE PLUGINS-->
    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        $(document).ready(function() {
            // Form Submission
            $('#editDependantForm').on('submit', async function(e) {
                e.preventDefault();

                // Show loading overlay
                $('#loadingOverlay').addClass('active');
                $('#submitBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Updating...');

                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch('/dependants/<%= dependant.id %>/edit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    // Hide loading overlay
                    $('#loadingOverlay').removeClass('active');

                    if (response.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: result.message || 'Dependant updated successfully',
                            confirmButtonColor: '#00b894',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            window.location.href = '/dependants';
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Update Failed',
                            text: result.error || 'An error occurred while updating',
                            confirmButtonColor: '#00b894'
                        });
                        $('#submitBtn').prop('disabled', false).html('<i class="fa fa-save"></i> Update Dependant');
                    }
                } catch (error) {
                    $('#loadingOverlay').removeClass('active');
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An unexpected error occurred',
                        confirmButtonColor: '#00b894'
                    });
                    $('#submitBtn').prop('disabled', false).html('<i class="fa fa-save"></i> Update Dependant');
                }
            });
        });
    </script>
</body>
</html>