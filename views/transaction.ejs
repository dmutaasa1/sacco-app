<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Transaction - Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    
    <style>
* { box-sizing: border-box; }
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
.page-wrapper { 
    margin-left: 220px !important;
    margin-top: 60px; 
    width: calc(100% - 220px) !important; 
    max-width: 100%; 
    transition: margin-left .22s ease, width .22s ease;
}
body.sidebar-collapsed .page-wrapper { 
    margin-left: 60px !important; 
    width: calc(100% - 60px) !important; 
}
@media (max-width: 991px) {
    .page-wrapper { 
        margin-left: 0 !important; 
        width: 100% !important; 
        max-width: 100%; 
    }
    .page-heading { padding: 12px 14px 0; }
    .page-content { padding: 12px 14px 24px; }
}

.page-heading { padding: 14px 22px 0; }
.page-heading h3 { font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0; }

.ibox { margin-bottom: 14px !important; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 6px rgba(26,31,46,.06); border: 1px solid #eaeef2; }
.ibox-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-bottom: 1px solid #eaeef2; background: #fff; }
.ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
.ibox-body { padding: 14px; background: #fff; }

.page-content { padding: 12px 22px 24px; }
.page-footer { padding: 12px 22px; font-size: .72rem; color: #a0aec0; text-align: center; border-top: 1px solid #eaeef2; background: #fff; }

.form-group label { font-size: .75rem; font-weight: 600; color: #1a1f2e; margin-bottom: 5px; }
.form-control, .form-select { font-size: .75rem; padding: 6px 10px; border: 1px solid #dee2e6; border-radius: 6px; background: #fff; }
.form-control:focus, .form-select:focus { border-color: #00b894; box-shadow: 0 0 0 3px rgba(0, 184, 148, 0.1); }

.section-title { font-size: .85rem; font-weight: 700; color: #1a1f2e; margin: 14px 0 10px; display: flex; align-items: center; gap: 6px; border-bottom: 1px solid #eaeef2; padding-bottom: 8px; }
.section-title i { color: #00b894; }

.btn { font-size: .75rem; font-weight: 600; padding: 7px 16px; border-radius: 6px; transition: all .15s; }
.btn-primary { background: #00b894; color: #fff; border: none; }
.btn-primary:hover { background: #00a388; color: #fff; }
.btn-secondary { background: #e9ecef; color: #555; border: none; }
.btn-secondary:hover { background: #dee2e6; color: #333; }

.member-info-card { background: #fff; border-radius: 8px; border: 1px solid #eaeef2; box-shadow: 0 1px 6px rgba(26,31,46,.06); padding: 14px; margin-bottom: 14px; }
.member-avatar { width: 80px; height: 80px; border-radius: 8px; object-fit: cover; border: 2px solid #eaeef2; margin: 0 auto 12px; display: block; }
.member-name { font-size: .9rem; font-weight: 700; text-align: center; margin-bottom: 4px; color: #1a1f2e; }
.member-id { text-align: center; color: #718096; font-size: .7rem; margin-bottom: 12px; }
.member-detail-row { padding: 6px 0; border-bottom: 1px solid #eaeef2; display: flex; justify-content: space-between; font-size: .7rem; }
.member-detail-row:last-child { border-bottom: none; }
.member-detail-label { color: #718096; font-weight: 600; }
.member-detail-value { color: #1a1f2e; font-weight: 700; }

.input-group .input-group-text { background: #f7fafc; border-color: #dee2e6; font-size: .75rem; }
.waiting-state { text-align: center; padding: 40px 20px; color: #a0aec0; }
.waiting-state i { font-size: 48px; margin-bottom: 12px; color: #eaeef2; }

@media (max-width: 768px) {
    .member-info-card { position: relative; }
}
    </style>
</head>

<body>
    <div class="page-wrapper">
        <!-- START HEADER-->         
        <%- include('partials/header') %>
        <!-- END HEADER-->
        <!-- START SIDEBAR-->
        <%- include('partials/sidebar') %>        
        <!-- END SIDEBAR-->
        
        <div class="page-heading">
            <h3><i class="fa fa-exchange" style="color: #00b894; margin-right: 8px;"></i>Member Transaction</h3>
        </div>
        
        <div class="page-content">
            <div class="row">
                <!-- LEFT COLUMN - Member Info -->
                <div class="col-lg-4">
                    <div class="member-info-card">
                        <div id="memberInfoDisplay">
                            <div class="waiting-state">
                                <i class="fa fa-user-circle"></i>
                                <p style="margin: 8px 0 4px; font-size: .75rem; font-weight: 600; color: #1a1f2e;">Enter Member ID</p>
                                <p style="font-size: .7rem; color: #a0aec0; margin: 0;">Details will appear here</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- RIGHT COLUMN - Transaction Form -->
                <div class="col-lg-8">
                    <div class="ibox">
                        <div class="ibox-body">
                            <form class="form" id="member_trans">
                                
                                <!-- Member Search Section -->
                                <div class="section-title">
                                    <i class="fa fa-search"></i> Member Search
                                </div>
                                
                                <div class="form-group">
                                    <label>Member Number <span style="color: #f56565;">*</span></label>
                                    <input 
                                        class="form-control" 
                                        type="number" 
                                        name="member_id" 
                                        id="member_id"
                                        placeholder="Enter member number"
                                        required
                                        autofocus
                                    >
                                    <small id="memberFeedback" class="form-text" style="font-size: .7rem; color: #718096;"></small>
                                </div>

                                <!-- Transaction Details Section -->
                                <div class="section-title">
                                    <i class="fa fa-money"></i> Transaction Details
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Amount <span style="color: #f56565;">*</span></label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">UGX</span>
                                                </div>
                                                <input 
                                                    class="form-control" 
                                                    type="number" 
                                                    placeholder="0.00" 
                                                    name="Amount"
                                                    id="Amount"
                                                    min="0"
                                                    step="0.01"
                                                    required
                                                >
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Transaction Date <span style="color: #f56565;">*</span></label>
                                            <div class="input-group date">
                                                <span class="input-group-addon bg-white">
                                                    <i class="fa fa-calendar"></i>
                                                </span>
                                                <input 
                                                    class="form-control" 
                                                    type="text" 
                                                    name="tran_date"
                                                    id="tran_date"
                                                    placeholder="YYYY/MM/DD"
                                                    required
                                                    readonly
                                                >
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Payment Period <span style="color: #f56565;">*</span></label>
                                            <select class="form-select" name="payment_period" id="payment_period" required>
                                                <option value="">Select Year</option>
                                                <option value="2022">2022</option>
                                                <option value="2023">2023</option>
                                                <option value="2024">2024</option>
                                                <option value="2025">2025</option>
                                                <option value="2026" selected>2026</option>
                                                <option value="2027">2027</option>
                                                <option value="2028">2028</option>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Debit/Credit <span style="color: #f56565;">*</span></label>
                                            <select class="form-select" name="Debit_Credit" id="Debit_Credit" required>
                                                <option value="Credit" selected>Credit (+)</option>
                                                <option value="Debit">Debit (-)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Transaction Type <span style="color: #f56565;">*</span></label>
                                    <select class="form-select" name="transaction_type" id="transaction_type" required>
                                        <option value="">Select Type</option>
                                        <option value="Membership Fee">Membership Fee</option>
                                        <option value="Saving" selected>Saving</option>
                                        <option value="Insurance Cover">Insurance Cover</option>
                                        <option value="Penalty Fees">Penalty Fees</option>
                                        <option value="Loan Debit Interest">Loan Penalty Interest</option>
                                        <option value="Savings Credit Interest">Savings Credit Interest</option>
                                        <option value="welfare Fee">Annual Welfare Fee</option>
                                    </select>
                                </div>
                                
                                <div class="form-group">
                                    <label>Narration / Description</label>
                                    <textarea 
                                        class="form-control" 
                                        name="Narration"
                                        id="Narration"
                                        rows="2"
                                        placeholder="Optional transaction notes"
                                        style="font-size: .75rem;"
                                    ></textarea>
                                </div>
                                
                                <!-- Form Actions -->
                                <div style="display: flex; gap: 10px; margin-top: 20px; border-top: 1px solid #eaeef2; padding-top: 14px;">
                                    <button class="btn btn-primary" type="submit" id="submitBtn">
                                        <i class="fa fa-check-circle"></i> Submit Transaction
                                    </button>
                                    <a href="/transaction_list" class="btn btn-secondary">
                                        <i class="fa fa-list"></i> View All
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="page-footer">
            2026 © <strong>Agali Awamu SACCO</strong> — All rights reserved.
        </div>
    </div>

    <!-- CORE PLUGINS-->
    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        let typingTimer;
        const typingDelay = 500;
        let memberValidated = false;
        let memberData = null;

        const memberInput = document.getElementById('member_id');
        const feedback = document.getElementById('memberFeedback');
        const memberInfoDisplay = document.getElementById('memberInfoDisplay');

        // Initialize date picker - use HTML5 date input
        $(document).ready(function () {
            console.log('Initializing date handler...');
            
            // Set today's date on page load
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const dateStr = `${year}/${month}/${day}`;
            
            $('#tran_date').val(dateStr);
            
            // Allow calendar icon to open date picker
            $('.input-group-addon').on('click', function() {
                $('#tran_date').trigger('focus');
            });
        });

        // Validate member on typing
        memberInput.addEventListener('input', () => {
            clearTimeout(typingTimer);
            memberValidated = false;
            memberData = null;

            const memberNo = memberInput.value.trim();

            if (memberNo.length < 1) {
                resetMember();
                return;
            }

            // Show loading state
            feedback.innerHTML = '<span class="validation-spinner"></span> Validating...';
            feedback.className = 'form-text text-info';
            memberInput.classList.remove('member-valid', 'member-invalid');
            
            showLoadingState();

            // Wait for user to stop typing
            typingTimer = setTimeout(() => {
                validateMember(memberNo);
            }, typingDelay);
        });

        // Show loading state
        function showLoadingState() {
            memberInfoDisplay.innerHTML = `
                <div class="waiting-state">
                    <div class="validation-spinner" style="width: 40px; height: 40px; border-width: 4px; margin: 0 auto 15px;"></div>
                    <p class="text-muted">Validating member...</p>
                </div>
            `;
        }

        // Validate member function
        function validateMember(memberNo) {
            console.log('Validating member:', memberNo);
            fetch(`/api/member/${memberNo}`)
                .then(res => {
                    console.log('API response status:', res.status);
                    if (!res.ok) {
                        throw new Error(`HTTP ${res.status}: ${res.statusText}`);
                    }
                    return res.json();
                })
                .then(data => {
                    console.log('API response data:', data);
                    if (data.success) {
                        // Member found
                        memberData = data.member;
                        feedback.innerHTML = '<i class="fa fa-check-circle"></i> Member validated';
                        feedback.className = 'form-text text-success';
                        memberInput.classList.add('member-valid');
                        memberInput.classList.remove('member-invalid');
                        memberValidated = true;

                        // Show member info
                        displayMemberInfo(data);

                        // Warn if not active
                        if (data.member.status.toLowerCase() !== 'active') {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Member Not Active',
                                text: `This member's status is "${data.member.status}". Transactions may be restricted.`,
                                confirmButtonText: 'Continue Anyway',
                                confirmButtonColor: '#00b894'
                            });
                        }
                    } else {
                        // Member not found
                        resetMember();
                        feedback.innerHTML = '<i class="fa fa-times-circle"></i> Member not found';
                        feedback.className = 'form-text text-danger';
                        memberInput.classList.add('member-invalid');
                        memberInput.classList.remove('member-valid');
                        
                        showNotFoundState(memberNo);
                    }
                })
                .catch(err => {
                    console.error('Validation error:', err);
                    resetMember();
                    feedback.innerHTML = '<i class="fa fa-exclamation-triangle"></i> Error validating';
                    feedback.className = 'form-text text-danger';
                    memberInput.classList.add('member-invalid');
                    memberInput.classList.remove('member-valid');
                    
                    showErrorState();
                });
        }

        // Display member information
        function displayMemberInfo(data) {
            const statusClass = data.member.status === 'Active' ? 'success' : 'warning';
            const statusBadge = data.member.status === 'Active' 
                ? '<span class="badge badge-success">Active</span>' 
                : '<span class="badge badge-warning">' + data.member.status + '</span>';

            memberInfoDisplay.innerHTML = `
                <img src="/assets/img/admin-avatar.png" alt="Member" class="member-avatar">
                <div class="member-name">${data.full_name}</div>
                <div class="member-id">ID: ${data.member.id}</div>
                
                <hr style="margin: 15px 0;">
                
                <div class="member-detail-row">
                    <span class="member-detail-label">Status</span>
                    <span class="member-detail-value">${statusBadge}</span>
                </div>
                
                <div class="member-detail-row">
                    <span class="member-detail-label">First Name</span>
                    <span class="member-detail-value">${data.member.first_name}</span>
                </div>
                
                <div class="member-detail-row">
                    <span class="member-detail-label">Last Name</span>
                    <span class="member-detail-value">${data.member.last_name}</span>
                </div>
                
                ${data.member.middle_name ? `
                <div class="member-detail-row">
                    <span class="member-detail-label">Middle Name</span>
                    <span class="member-detail-value">${data.member.middle_name}</span>
                </div>
                ` : ''}
                
                <div style="margin-top: 20px; text-align: center;">
                    <a href="/members/${data.member.id}" target="_blank" class="btn btn-sm btn-primary btn-block">
                        <i class="fa fa-eye"></i> View Full Profile
                    </a>
                </div>
            `;
        }

        // Show not found state
        function showNotFoundState(memberNo) {
            memberInfoDisplay.innerHTML = `
                <div class="waiting-state">
                    <i class="fa fa-user-times" style="color: #dc3545;"></i>
                    <p><strong>Member Not Found</strong></p>
                    <p class="text-muted small">ID "${memberNo}" does not exist in the system</p>
                </div>
            `;
        }

        // Show error state
        function showErrorState() {
            memberInfoDisplay.innerHTML = `
                <div class="waiting-state">
                    <i class="fa fa-exclamation-triangle" style="color: #ffc107;"></i>
                    <p><strong>Validation Error</strong></p>
                    <p class="text-muted small">Please try again</p>
                </div>
            `;
        }

        // Reset member validation
        function resetMember() {
            memberValidated = false;
            memberData = null;
            memberInfoDisplay.innerHTML = `
                <div class="waiting-state">
                    <i class="fa fa-user-circle"></i>
                    <p><strong>Enter Member ID</strong></p>
                    <p class="text-muted small">Member details will appear here</p>
                </div>
            `;
        }

        // Form submission
        document.getElementById('member_trans').addEventListener('submit', async function(e) {
            e.preventDefault();

            // Check if member is validated
            if (!memberValidated) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Validation Required',
                    text: 'Please enter a valid member number first',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#00b894'
                });
                memberInput.focus();
                return;
            }

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            // Disable submit button
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing...';

            try {
                const response = await fetch('/member_txns', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Validation Errors',
                        html: result.errors.map(err => `<p>• ${err}</p>`).join(''),
                        confirmButtonColor: '#00b894'
                    });
                    
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa fa-check-circle"></i> Submit Transaction';
                    return;
                }

                const formattedAmount = parseFloat(result.transaction.Amount).toLocaleString('en-UG', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });

                const amountColor = result.transaction.Debit_Credit.toLowerCase() === 'credit' ? 'green' : 'red';

                Swal.fire({
                    icon: 'success',
                    title: 'Transaction Posted!',
                    html: `
                        <div style="text-align: left; padding: 10px;">
                            <p><strong>Member:</strong> ${memberData.first_name} ${memberData.last_name}</p>
                            <p><strong>Amount:</strong> <span style="color:${amountColor}; font-weight:bold; font-size: 1.3em;">UGX ${formattedAmount}</span></p>
                            <p><strong>Type:</strong> ${result.transaction.transaction_type}</p>
                            <p><strong>Period:</strong> ${result.transaction.payment_period}</p>
                        </div>
                    `,
                    confirmButtonText: 'View Transactions',
                    confirmButtonColor: '#00b894',
                    showCancelButton: true,
                    cancelButtonText: 'Add Another'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/transaction_list';
                    } else {
                        // Reset form but keep member
                        document.getElementById('member_trans').reset();
                        document.getElementById('member_id').value = memberData.id;
                        
                        // Reset date field to today
                        const today = new Date();
                        const year = today.getFullYear();
                        const month = String(today.getMonth() + 1).padStart(2, '0');
                        const day = String(today.getDate()).padStart(2, '0');
                        $('#tran_date').val(`${year}/${month}/${day}`);
                        
                        // Re-enable button
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fa fa-check-circle"></i> Submit Transaction';
                    }
                });

            } catch (err) {
                console.error('Submission error:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'Server Error',
                    text: 'Could not submit transaction. Please try again.',
                    confirmButtonColor: '#00b894'
                });
                
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fa fa-check-circle"></i> Submit Transaction';
            }
        });

        // Amount formatting
        document.getElementById('Amount').addEventListener('blur', function() {
            if (this.value) {
                this.value = parseFloat(this.value).toFixed(2);
            }
        });
    </script>
</body>
</html>