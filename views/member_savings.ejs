<%- include('partials/member_sidebar') %>

<h4>Savings Statement</h4>



<table class="table table-bordered">

<thead>
<tr>
<th>Date</th>
<th>Amount</th>
<th>Description</th>
</tr>
</thead>

<tbody>

<% savings.forEach(row => { %>

<tr>
<td><%= row.date %></td>
<td class="text-success">
UGX <%= row.Amount.toLocaleString() %>
</td>
<td><%= row.description %></td>
</tr>

<% }) %>

</tbody>

</table>