<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dependants - Agali Awamu SACCO</title>
    <link href="/assets/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/assets/vendors/DataTables/datatables.min.css" rel="stylesheet" />
    <link href="/assets/css/main.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
* { box-sizing: border-box; }
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

/* ══════════════════════════════════════════
   BASE LAYOUT — matches admin dashboard
══════════════════════════════════════════ */
body { font-family: 'DM Sans', sans-serif; background: #f7fafc; }
.page-wrapper { 
    margin-left: 220px !important;
    margin-top: 60px; 
    width: calc(100% - 220px) !important; 
    max-width: 100%; 
    transition: margin-left .22s ease, width .22s ease;
}
body.sidebar-collapsed .page-wrapper { 
    margin-left: 60px !important; 
    width: calc(100% - 60px) !important; 
}
@media (max-width: 991px) {
    .page-wrapper { 
        margin-left: 0 !important; 
        width: 100% !important; 
        max-width: 100%; 
    }
    .page-heading { padding: 12px 14px 0; }
    .page-content { padding: 12px 14px 24px; }
}

/* ══════════════════════════════════════════
   PAGE HEADING
══════════════════════════════════════════ */
.page-heading {
    padding: 14px 22px 0;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
}
.page-heading h3 {
    font-size: 1.1rem; font-weight: 700; color: #1a1f2e; margin: 0;
}
.page-heading .sub { font-size: .72rem; color: #a0aec0; margin-top: 2px; }

/* ══════════════════════════════════════════
   SHARED CARD
══════════════════════════════════════════ */
.ibox { margin-bottom: 0 !important; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 6px rgba(26,31,46,.06); border: 1px solid #eaeef2; }
.ibox-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border-bottom: 1px solid #eaeef2; background: #fff;
}
.ibox-title { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #718096; }
.ibox-body  { padding: 12px 14px; background: #fff; }

/* ══════════════════════════════════════════
   DEPENDANTS TABLE
══════════════════════════════════════════ */
.dependants-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
#example-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .72rem;
}
#example-table th {
    font-size: .68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .4px; color: #a0aec0; padding: 8px 10px;
    border-bottom: 2px solid #eaeef2; background: #fafbfc; white-space: nowrap;
}
#example-table td {
    font-size: .74rem; padding: 8px 10px;
    border-bottom: 1px solid #f0f4f8; color: #444; vertical-align: middle;
}
#example-table tr:last-child td { border-bottom: none; }
@media (max-width: 600px) { #example-table .hide-sm { display: none; } }

/* Action buttons */
.btn-action { 
    font-size: .7rem; 
    padding: 4px 10px; 
    border-radius: 5px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    transition: all .15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
}
.btn-view { 
    background: #e3f2fd; 
    color: #1565c0;
}
.btn-edit { 
    background: #fff3e0; 
    color: #e65100;
}
.btn-view:hover { 
    background: #bbdefb; 
    color: #0d47a1;
}
.btn-edit:hover { 
    background: #ffe0b2; 
    color: #bf360c;
    text-decoration: none;
}

/* DataTables toolbar */
.dataTables_wrapper .dataTables_filter input {
    font-size: .75rem;
    padding: 5px 12px;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    background: #fff;
}
.dataTables_wrapper .dataTables_length select {
    font-size: .75rem;
    padding: 5px 8px;
    border: 1px solid #dee2e6;
    border-radius: 5px;
    background: #fff;
}
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_length { margin-bottom: 8px; }
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_paginate { font-size: .72rem; margin-top: 8px; }
.dataTables_wrapper .paginate_button {
    padding: 4px 8px !important;
    font-size: .72rem !important;
    border-radius: 4px;
    margin: 0 2px;
}
.dataTables_wrapper .paginate_button.current {
    background: #00b894 !important;
    border-color: #00b894 !important;
}

/* Dropdown menu */
.dropdown-menu {
    border: 1px solid #eaeef2;
    border-radius: 6px;
    box-shadow: 0 1px 6px rgba(26,31,46,.06);
    padding: 4px 0;
}
.dropdown-item {
    font-size: .74rem;
    padding: 6px 14px;
    color: #444;
}
.dropdown-item:hover {
    background: #f7fafc;
    color: #00b894;
}

/* Page content */
.page-content { padding: 12px 22px 24px; }

/* Footer */
.page-footer {
    padding: 12px 22px;
    font-size: .72rem;
    color: #a0aec0;
    text-align: center;
    border-top: 1px solid #eaeef2;
    background: #fff;
}

/* Hide theme config panel */
.theme-config { display: none !important; }
</style>
</head>
<body>
    <%- include('partials/header') %>
    <%- include('partials/sidebar') %>

    <div class="page-wrapper">
        <div class="page-heading">
            <div>
                <h3><i class="fa fa-child" style="margin-right: 8px; color: #00b894;"></i>Dependants Directory</h3>
            </div>
        </div>

        <div class="page-content">
            <div class="ibox">
                <div class="ibox-head">
                    <span class="ibox-title"><i class="fa fa-list" style="color: #00b894; margin-right: 5px;"></i>Dependants List</span>
                    <a href="/dependant_add" class="btn" style="background: #00b894; color: #fff; border: none; font-size: .75rem; padding: 6px 14px; border-radius: 6px; margin: 0; font-weight: 600;">
                        <i class="fa fa-plus"></i> Add Dependant
                    </a>
                </div>

                <div class="ibox-body">
                    <div class="dependants-table-wrap">
                        <table class="table table-striped table-hover" id="example-table" width="100%">
                            <thead>
                                <tr>
                                    <th style="width:10%;">Member ID</th>
                                    <th style="width:8%;">Dep ID</th>
                                    <th style="width:20%;">First Name</th>
                                    <th style="width:20%;">Last Name</th>
                                    <th style="width:15%;">Date of Birth</th>
                                    <th class="hide-sm" style="width:12%;">Gender</th>
                                    <th style="width:15%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(dependants => { %>
                                   <tr>
                                    <td><%= dependants.person_id %></td>
                                    <td><%= dependants.id %></td>
                                    <td style="font-weight: 600;"><%= dependants.First_Name %></td>
                                    <td><%= dependants.Last_Name %></td>
                                    <td><%= dependants.child_date_of_birth %></td>
                                    <td class="hide-sm"><%= dependants.Gender %></td>
                                    <td>
                                        <a href="/dependants/<%= dependants.id %>/edit" class="btn btn-action btn-edit"><i class="fa fa-pencil"></i> Edit</a>
                                    </td>
                                </tr>
                               <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <footer class="page-footer">
            <div>2026 © <b>Agali Awamu SACCO</b> — All rights reserved.</div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="/assets/vendors/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendors/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendors/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/assets/vendors/metisMenu/dist/metisMenu.min.js"></script>
    <script src="/assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="/assets/vendors/DataTables/datatables.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <script>
        $(function () {
            $('#example-table').DataTable({
                pageLength: 25,
                order: [[0, 'desc']],
                language: {
                    search: '',
                    searchPlaceholder: 'Search…',
                    lengthMenu: 'Show _MENU_',
                    info: '_START_–_END_ of _TOTAL_',
                    paginate: { previous: '‹', next: '›' }
                }
            });
        });
    </script>
</body>
</html>
                    </label>
                </div>
                <div class="color-skin-box" data-toggle="tooltip" data-original-title="Green light">
                    <label>
                        <input type="radio" name="setting-theme" value="green-light">
                        <span class="color-check-icon"><i class="fa fa-check"></i></span>
                        <div class="color bg-green"></div>
                        <div class="color-small bg-silver-100"></div>
                    </label>
                </div>
                <div class="color-skin-box" data-toggle="tooltip" data-original-title="Purple light">
                    <label>
                        <input type="radio" name="setting-theme" value="purple-light">
                        <span class="color-check-icon"><i class="fa fa-check"></i></span>
                        <div class="color bg-purple"></div>
                        <div class="color-small bg-silver-100"></div>
                    </label>
                </div>
                <div class="color-skin-box" data-toggle="tooltip" data-original-title="Orange light">
                    <label>
                        <input type="radio" name="setting-theme" value="orange-light">
                        <span class="color-check-icon"><i class="fa fa-check"></i></span>
                        <div class="color bg-orange"></div>
                        <div class="color-small bg-silver-100"></div>
                    </label>
                </div>
                <div class="color-skin-box" data-toggle="tooltip" data-original-title="Pink light">
                    <label>
                        <input type="radio" name="setting-theme" value="pink-light">
                        <span class="color-check-icon"><i class="fa fa-check"></i></span>
                        <div class="color bg-pink"></div>
                        <div class="color-small bg-silver-100"></div>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <!-- END THEME CONFIG PANEL-->
    <!-- BEGIN PAGA BACKDROPS-->
    <div class="sidenav-backdrop backdrop"></div>
    <div class="preloader-backdrop">
        <div class="page-preloader">Loading</div>
    </div>
    <!-- END PAGA BACKDROPS-->
    <!-- CORE PLUGINS-->
    <script src="./assets/vendors/jquery/dist/jquery.min.js" type="text/javascript"></script>
    <script src="./assets/vendors/popper.js/dist/umd/popper.min.js" type="text/javascript"></script>
    <script src="./assets/vendors/bootstrap/dist/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="./assets/vendors/metisMenu/dist/metisMenu.min.js" type="text/javascript"></script>
    <script src="./assets/vendors/jquery-slimscroll/jquery.slimscroll.min.js" type="text/javascript"></script>
    <!-- PAGE LEVEL PLUGINS-->
    <script src="./assets/vendors/DataTables/datatables.min.js" type="text/javascript"></script>
    <!-- CORE SCRIPTS-->
    <script src="assets/js/app.min.js" type="text/javascript"></script>
    <!-- PAGE LEVEL SCRIPTS-->
    <script type="text/javascript">
        $(function() {
            $('#example-table').DataTable({
                pageLength: 15,
               
            });
        })
    </script>
</body>

</html>