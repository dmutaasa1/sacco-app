<script>
(function () {
    /* Mobile sidebar open/close handlers */
    window.openMobileSidebar = function () {
        document.body.classList.add('sidebar-open');
    };
    
    window.closeMobileSidebar = function () {
        document.body.classList.remove('sidebar-open');
    };

    /* Create and insert backdrop overlay */
    function createBackdrop() {
        var backdrop = document.getElementById('sidebarBackdrop');
        if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.id = 'sidebarBackdrop';
            backdrop.className = 'sidebar-backdrop';
            document.body.insertBefore(backdrop, document.body.firstChild);
            
            /* Close sidebar when backdrop is clicked/tapped */
            backdrop.addEventListener('click', closeMobileSidebar, false);
            backdrop.addEventListener('touchstart', closeMobileSidebar, false);
        }
        return backdrop;
    }

    /* Wait for jQuery + metisMenu + app.min.js to all finish,
       then re-init cleanly on our menu element only.
       Delay of 100ms ensures app.min.js has already run. */
    function initSidebar() {
        if (typeof jQuery === 'undefined' || !jQuery.fn.metisMenu) {
            return setTimeout(initSidebar, 50);
        }

        jQuery(function ($) {
            var $menu = $('#side-menu');

            /* Destroy any existing metisMenu instance the theme created */
            try {
                if ($menu.data('metisMenu')) {
                    $menu.metisMenu('dispose');
                }
            } catch (e) { /* older metisMenu versions don't have dispose */ }

            /* Remove theme's collapse classes so we start fresh */
            $menu.find('ul.nav-2-level').each(function () {
                $(this).removeClass('in collapsing');
            });

            /* Re-init metisMenu with proper settings for touch */
            $menu.metisMenu({ 
                toggle: true,
                preventDefault: false
            });

            /* Auto-open parent of active page */
            $menu.find('> li.active').each(function () {
                var $sub = $(this).children('ul.nav-2-level');
                if ($sub.length) {
                    $sub.addClass('in').css('height', '');
                    $(this).children('a').attr('aria-expanded', 'true');
                }
            });

            /* Auto-open parent when a child link is active */
            $menu.find('ul.nav-2-level a.active').each(function () {
                var $sub = $(this).closest('ul.nav-2-level');
                $sub.addClass('in').css('height', '');
                $sub.closest('li').children('a').attr('aria-expanded', 'true');
            });

            /* Create backdrop for mobile overlay */
            createBackdrop();

            /* Enhanced touch/click handling for parent dropdown items */
            $menu.find('> li > a[href="javascript:;"]').off('click touchend').on('click touchend', function (e) {
                var $this = $(this);
                var hasDropdown = $this.siblings('ul.nav-2-level').length > 0;
                
                if (hasDropdown) {
                    /* Prevent default to avoid page jumps */
                    e.preventDefault();
                    e.stopPropagation();
                    
                    /* Manually trigger MetisMenu toggle */
                    var $parent = $this.closest('li');
                    var $submenu = $parent.children('ul.nav-2-level');
                    
                    if ($submenu.hasClass('in')) {
                        /* Currently open, close it */
                        $submenu.removeClass('in').slideUp(300);
                        $this.attr('aria-expanded', 'false');
                    } else {
                        /* Currently closed, open it */
                        $submenu.addClass('in').slideDown(300);
                        $this.attr('aria-expanded', 'true');
                    }
                }
                return false;
            });

            /* Handle regular link clicks */
            $menu.find('> li > a:not([href="javascript:;"])').off('click').on('click', function () {
                if (window.innerWidth <= 991) {
                    setTimeout(closeMobileSidebar, 100);
                }
            });

            /* Handle submenu link clicks with explicit pointer-events */
            $menu.find('ul.nav-2-level > li > a').off('click').on('click', function (e) {
                /* Ensure this link is clickable */
                $(this).css('pointer-events', 'auto');
                
                if (window.innerWidth <= 991) {
                    closeMobileSidebar();
                }
            });

            /* Make sure all sidebar items are always clickable */
            $menu.find('a').css('pointer-events', 'auto');
        });
    }

    /* Run after everything else — 150ms after DOM ready */
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(initSidebar, 150);
        });
    } else {
        setTimeout(initSidebar, 150);
    }

    /* Handle resize - close sidebar on transition to mobile and reinit menu */
    window.addEventListener('resize', function () {
        if (window.innerWidth > 991) {
            closeMobileSidebar();
        } else {
            /* On mobile, ensure MetisMenu is properly initialized */
            if (typeof jQuery !== 'undefined' && jQuery.fn.metisMenu) {
                var $menu = jQuery('#side-menu');
                if ($menu.data('metisMenu')) {
                    try {
                        $menu.metisMenu('dispose');
                    } catch (e) {}
                    setTimeout(function () {
                        $menu.metisMenu({ 
                            toggle: true,
                            preventDefault: false
                        });
                    }, 100);
                }
            }
        }
    }, false);
}());
</script>
