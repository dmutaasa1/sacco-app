<%
/* Guard against currentPage being undefined (e.g. member pages) */
var _cp = (typeof currentPage !== 'undefined') ? currentPage : '';
function isActive(pages) {
    return pages.includes(_cp) ? 'active' : '';
}
%>

<style>
/* ═══════════════════════════════════════════════════
   SIDEBAR — all rules scoped to #sidebar
   so main.min.css cannot override them.
   bg #0f1623 = identical to header .page-brand
   width 220px | top 60px (matches header height)
═══════════════════════════════════════════════════ */

#sidebar {
    width: 220px;
    background: #0f1623;
    border-right: 1px solid rgba(255,255,255,.04);
    position: fixed;
    top: 60px;
    left: 0;
    bottom: 0;
    height: calc(100vh - 60px);
    z-index: 998;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    font-family: 'DM Sans', sans-serif;
    transition: width .22s ease;
    margin: 0;
    padding: 0;
    box-shadow: none;
}

/* Content wrapper positioned to the right of sidebar */
.page-wrapper .content-wrapper {
    margin-left: 220px !important;
    transition: margin-left .22s ease !important;
}

body.sidebar-collapsed #sidebar { width: 60px; }
body.sidebar-collapsed .page-wrapper .content-wrapper { margin-left: 60px !important; }

@media (max-width: 991px) {
    #sidebar {
        width: min(280px, 86vw);
        transform: translateX(-100%);
        transition: transform .2s ease;
        box-shadow: 0 10px 30px rgba(15,22,35,.24);
    }
    body.sidebar-open #sidebar {
        transform: translateX(0);
    }
    body.sidebar-collapsed #sidebar {
        width: min(280px, 86vw);
    }
    .page-wrapper .content-wrapper {
        margin-left: 0 !important;
    }
}

/* scroll container */
#sidebar-collapse {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.1) transparent;
}
#sidebar-collapse::-webkit-scrollbar       { width: 3px; }
#sidebar-collapse::-webkit-scrollbar-thumb { background: rgba(255,255,255,.12); border-radius: 4px; }

/* nav list */
#sidebar #side-menu {
    list-style: none;
    padding: 4px 7px 8px;
    margin: 0;
    flex: 1;
    background: transparent;
    border: none;
    box-shadow: none;
}

/* section headings */
#sidebar #side-menu > li.heading {
    font-size: .57rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(255,255,255,.2);
    padding: 12px 9px 4px;
    margin: 0;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    background: transparent;
    transition: opacity .15s, padding .15s, height .15s;
}
body.sidebar-collapsed #sidebar #side-menu > li.heading {
    opacity: 0; padding: 0; height: 0; overflow: hidden;
}

/* top-level links */
#sidebar #side-menu > li > a {
    display: flex !important;
    align-items: center !important;
    gap: 9px;
    padding: 8px 8px;
    border-radius: 8px;
    color: rgba(255,255,255,.52);
    font-size: .78rem;
    font-weight: 500;
    text-decoration: none !important;
    transition: background .13s, color .13s;
    position: relative;
    margin-bottom: 1px;
    overflow: hidden;
    background: transparent !important;
    border: none !important;
    height: auto !important;
    line-height: 1.3 !important;
    width: 100%;
    white-space: nowrap;
    box-shadow: none !important;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
}
#sidebar #side-menu > li > a:hover,
#sidebar #side-menu > li > a:active,
#sidebar #side-menu > li > a:focus {
    background: rgba(255,255,255,.07) !important;
    color: rgba(255,255,255,.9) !important;
}
#sidebar #side-menu > li.active > a {
    background: rgba(0,184,148,.13) !important;
    color: #00b894 !important;
}
#sidebar #side-menu > li.active > a::before {
    content: '';
    position: absolute;
    left: 0; top: 14%; bottom: 14%;
    width: 3px; border-radius: 0 3px 3px 0;
    background: #00b894;
}

/* icon pill */
#sidebar .sidebar-item-icon {
    width: 26px; height: 26px;
    border-radius: 7px;
    background: rgba(255,255,255,.06);
    display: inline-flex;
    align-items: center; justify-content: center;
    font-size: .76rem; flex-shrink: 0;
    color: rgba(255,255,255,.5);
    transition: background .13s, color .13s;
}
#sidebar #side-menu > li > a:hover .sidebar-item-icon {
    background: rgba(255,255,255,.1); color: rgba(255,255,255,.88);
}
#sidebar #side-menu > li.active > a .sidebar-item-icon {
    background: rgba(0,184,148,.18); color: #00b894;
}

/* nav label */
#sidebar .nav-label {
    flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: opacity .15s;
}
body.sidebar-collapsed #sidebar .nav-label { opacity: 0; width: 0; flex: 0; overflow: hidden; }

/* chevron */
#sidebar .arrow {
    margin-left: auto; font-size: .58rem;
    color: rgba(255,255,255,.2);
    transition: transform .18s, color .13s, opacity .15s;
    flex-shrink: 0;
}
body.sidebar-collapsed #sidebar .arrow { opacity: 0; width: 0; overflow: hidden; }
#sidebar #side-menu > li > a[aria-expanded="true"] > .arrow {
    transform: rotate(-90deg); color: rgba(255,255,255,.45);
}
#sidebar #side-menu > li.active > a .arrow { color: rgba(0,184,148,.5); }

/* submenu — Bootstrap/metismenu controls display, we only style */
#sidebar ul.nav-2-level {
    list-style: none;
    padding: 1px 0 3px 12px;
    margin: 0;
    background: transparent;
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease;
}
#sidebar ul.nav-2-level.in {
    max-height: 1000px;
}
body.sidebar-collapsed #sidebar ul.nav-2-level { display: none !important; }

#sidebar ul.nav-2-level > li > a {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 8px;
    border-radius: 6px;
    color: rgba(255,255,255,.37);
    font-size: .72rem; font-weight: 400;
    text-decoration: none;
    transition: background .12s, color .12s;
    background: transparent; border: none;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    width: 100%;
    cursor: pointer;
    position: relative;
    z-index: 1;
    pointer-events: auto;
}
#sidebar ul.nav-2-level > li > a::before {
    content: ''; width: 4px; height: 4px; border-radius: 50%;
    background: rgba(255,255,255,.14); flex-shrink: 0;
    display: inline-block; transition: background .12s, transform .12s;
}
#sidebar ul.nav-2-level > li > a:hover {
    color: rgba(255,255,255,.82); background: rgba(255,255,255,.04);
}
#sidebar ul.nav-2-level > li > a:hover::before { background: rgba(255,255,255,.4); }
#sidebar ul.nav-2-level > li > a.active {
    color: #00b894; background: rgba(0,184,148,.09); font-weight: 500;
}
#sidebar ul.nav-2-level > li > a.active::before { background: #00b894; transform: scale(1.4); }

/* bottom dock */
#sidebar .sb-bottom {
    padding: 7px;
    border-top: 1px solid rgba(255,255,255,.06);
    display: flex; flex-direction: column; gap: 1px;
    flex-shrink: 0; background: #0f1623; overflow: hidden;
}
#sidebar .sb-link {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 8px; border-radius: 7px;
    color: rgba(255,255,255,.38); font-size: .73rem; font-weight: 500;
    text-decoration: none;
    transition: background .12s, color .12s;
    background: transparent; white-space: nowrap; overflow: hidden;
}
#sidebar .sb-ico {
    width: 24px; height: 24px; border-radius: 6px;
    background: rgba(255,255,255,.05);
    display: flex; align-items: center; justify-content: center;
    font-size: .7rem; flex-shrink: 0;
}
#sidebar .sb-link:hover { background: rgba(255,255,255,.06); color: rgba(255,255,255,.82); }
#sidebar .sb-link.danger { color: rgba(220,80,80,.7); }
#sidebar .sb-link.danger:hover { background: rgba(214,48,49,.1); color: #ff7675; }
body.sidebar-collapsed #sidebar .sb-label { display: none; }

@media (max-width: 991px) {
    #sidebar #side-menu > li > a {
        padding: 10px 8px;
        min-height: 44px;
    }
    #sidebar ul.nav-2-level > li > a {
        padding: 8px 8px;
        min-height: 40px;
    }
    body.sidebar-collapsed #sidebar #side-menu > li.heading {
        opacity: 1 !important;
        padding: 12px 9px 4px !important;
        height: auto !important;
        display: block !important;
        overflow: visible !important;
    }
    body.sidebar-collapsed #sidebar .nav-label {
        opacity: 1 !important;
        width: auto !important;
        flex: 1 !important;
        overflow: visible !important;
    }
    body.sidebar-collapsed #sidebar .arrow {
        opacity: 1 !important;
        width: auto !important;
        display: inline-block !important;
        overflow: visible !important;
    }
    body.sidebar-collapsed #sidebar .sb-label {
        display: inline !important;
    }
    body.sidebar-collapsed #sidebar ul.nav-2-level {
        display: block !important;
    }
}

/* Mobile backdrop overlay */
.sidebar-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 997;
    display: none;
    opacity: 0;
    transition: opacity .2s ease;
    pointer-events: none;
}
body.sidebar-open .sidebar-backdrop {
    display: block;
    opacity: 1;
    pointer-events: auto;
}
@media (min-width: 992px) {
    .sidebar-backdrop { display: none !important; }
}

/* Ensure content doesn't interfere with sidebar on mobile */
@media (max-width: 991px) {
    .content-wrapper {
        position: relative;
        z-index: 0;
    }
    body.sidebar-open .content-wrapper {
        pointer-events: none;
    }
}

/* Ensure sidebar and its items are always clickable */
#sidebar,
#sidebar #side-menu,
#sidebar #side-menu a,
#sidebar ul.nav-2-level,
#sidebar ul.nav-2-level a,
#sidebar .sb-bottom,
#sidebar .sb-link {
    pointer-events: auto;
    position: relative;
}
</style>

