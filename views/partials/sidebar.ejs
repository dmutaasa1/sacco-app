<%
var _cp = (typeof currentPage !== 'undefined') ? currentPage : '';
function isActive(pages) { return pages.includes(_cp) ? 'active' : ''; }
%>

<style>
/* ── Overlay backdrop (mobile) ── */
.sb-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,.48); z-index: 997;
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
    cursor: pointer;
}
.sb-overlay.open { display: block; }

/* ── Sidebar shell ── */
#sidebar {
    width: 220px;
    background: #0f1623;
    border-right: 1px solid rgba(255,255,255,.04);
    position: fixed;
    top: 60px; left: 0; bottom: 0;
    height: calc(100vh - 60px);
    z-index: 998;
    display: flex; flex-direction: column;
    overflow: hidden;
    font-family: 'DM Sans', sans-serif;
    transition: width .22s ease, transform .22s ease;
}

/* Desktop collapsed */
body.sidebar-collapsed #sidebar { width: 60px; }

/* Tablet 768–991px : auto icon-rail */
@media (min-width: 768px) and (max-width: 991px) {
    #sidebar { width: 60px; }
    .content-wrapper, .page-wrapper { margin-left: 60px !important; }
}

/* Mobile < 768px : slide off-screen */
@media (max-width: 767px) {
    #sidebar {
        width: 240px;
        top: 0; height: 100vh;
        transform: translateX(-100%);
    }
    #sidebar.mobile-open { transform: translateX(0); box-shadow: 6px 0 28px rgba(0,0,0,.4); }
    .content-wrapper, .page-wrapper { margin-left: 0 !important; }
    .sb-mobile-header { display: flex !important; }
}

/* Scroll container */
#sidebar-collapse {
    display: flex; flex-direction: column;
    flex: 1; min-height: 0;
    overflow-y: auto; overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.1) transparent;
}
#sidebar-collapse::-webkit-scrollbar       { width: 3px; }
#sidebar-collapse::-webkit-scrollbar-thumb { background: rgba(255,255,255,.12); border-radius: 4px; }

/* Mobile brand header inside sidebar */
.sb-mobile-header {
    display: none; align-items: center; gap: 10px;
    padding: 14px 14px 12px; flex-shrink: 0;
    border-bottom: 1px solid rgba(255,255,255,.07);
}
.sb-mobile-logo {
    width: 32px; height: 32px; border-radius: 8px;
    background: linear-gradient(135deg,#00b894,#0984e3);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 800; color: #fff; flex-shrink: 0;
}
.sb-mobile-name { font-size: .86rem; font-weight: 700; color: #f0f4ff; }
.sb-mobile-sub  { font-size: .58rem; font-weight: 500; color: #00b894; text-transform: uppercase; letter-spacing: .8px; }

/* Nav list */
#side-menu {
    list-style: none;
    padding: 6px 7px 8px;
    margin: 0; flex: 1;
    background: transparent; border: none;
}

/* Section headings */
#side-menu > li.heading {
    font-size: .56rem; font-weight: 700;
    letter-spacing: 1.2px; text-transform: uppercase;
    color: rgba(255,255,255,.2);
    padding: 13px 9px 4px; margin: 0;
    pointer-events: none; user-select: none;
    white-space: nowrap; overflow: hidden;
    transition: opacity .15s, padding .15s, height .22s;
}
body.sidebar-collapsed #side-menu > li.heading { opacity:0; height:0; padding:0; }
@media (min-width:768px) and (max-width:991px) {
    #side-menu > li.heading { opacity:0; height:0; padding:0; }
}

/* Top-level links */
#side-menu > li > a {
    display: flex !important;
    align-items: center !important;
    gap: 9px; padding: 8px 8px;
    border-radius: 8px;
    color: rgba(255,255,255,.52);
    font-size: .77rem; font-weight: 500;
    text-decoration: none !important;
    transition: background .13s, color .13s;
    position: relative; margin-bottom: 1px;
    overflow: hidden; background: transparent !important;
    border: none !important; height: auto !important;
    line-height: 1.3; width: 100%; white-space: nowrap;
}
#side-menu > li > a:hover {
    background: rgba(255,255,255,.07) !important;
    color: rgba(255,255,255,.9) !important;
}
#side-menu > li.active > a {
    background: rgba(0,184,148,.13) !important;
    color: #00b894 !important;
}
#side-menu > li.active > a::before {
    content: ''; position: absolute;
    left: 0; top: 14%; bottom: 14%;
    width: 3px; border-radius: 0 3px 3px 0;
    background: #00b894;
}

/* Icon pill */
.sidebar-item-icon {
    width: 26px; height: 26px; border-radius: 7px;
    background: rgba(255,255,255,.06);
    display: inline-flex !important;
    align-items: center !important; justify-content: center !important;
    font-size: .75rem; flex-shrink: 0;
    color: rgba(255,255,255,.5);
    transition: background .13s, color .13s;
}
#side-menu > li > a:hover .sidebar-item-icon { background:rgba(255,255,255,.1); color:rgba(255,255,255,.9); }
#side-menu > li.active > a .sidebar-item-icon { background:rgba(0,184,148,.18); color:#00b894; }

/* Tooltip (icon-only mode) */
#side-menu > li { position: relative; }
#side-menu > li:hover .sb-tip { opacity: 1; pointer-events: auto; }
.sb-tip {
    position: absolute; left: calc(100% + 10px); top: 50%;
    transform: translateY(-50%);
    background: #1a202c; color: #fff;
    font-size: .72rem; font-weight: 600;
    padding: 5px 10px; border-radius: 6px;
    white-space: nowrap; opacity: 0;
    pointer-events: none; transition: opacity .15s;
    z-index: 9999; box-shadow: 0 4px 14px rgba(0,0,0,.3);
}
.sb-tip::before {
    content: ''; position: absolute;
    right: 100%; top: 50%; transform: translateY(-50%);
    border: 5px solid transparent;
    border-right-color: #1a202c;
}
/* Only show tooltip when in icon-only mode */
body:not(.sidebar-collapsed) #side-menu > li .sb-tip { display: none; }
@media (min-width:768px) and (max-width:991px) {
    #side-menu > li .sb-tip { display: block; }
}

/* Nav label */
.nav-label {
    flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    transition: opacity .15s, width .15s;
}
body.sidebar-collapsed .nav-label { opacity:0; width:0; flex:0; overflow:hidden; }
@media (min-width:768px) and (max-width:991px) {
    .nav-label { opacity:0; width:0; flex:0; overflow:hidden; }
}

/* Chevron */
.arrow {
    margin-left: auto; font-size: .55rem;
    color: rgba(255,255,255,.2);
    transition: transform .18s, color .13s, opacity .15s;
    flex-shrink: 0;
}
body.sidebar-collapsed .arrow { opacity:0; width:0; overflow:hidden; }
@media (min-width:768px) and (max-width:991px) {
    .arrow { opacity:0; width:0; overflow:hidden; }
}
#side-menu > li > a[aria-expanded="true"] > .arrow { transform:rotate(-90deg); color:rgba(255,255,255,.45); }
#side-menu > li.active > a .arrow { color:rgba(0,184,148,.5); }

/* Submenu */
#side-menu ul.nav-2-level {
    list-style: none; padding: 1px 0 3px 12px;
    margin: 0; background: transparent;
}
body.sidebar-collapsed #side-menu ul.nav-2-level { display:none !important; }
@media (min-width:768px) and (max-width:991px) {
    #side-menu ul.nav-2-level { display:none !important; }
}
#side-menu ul.nav-2-level > li > a {
    display: flex; align-items: center; gap: 7px;
    padding: 5px 8px; border-radius: 6px;
    color: rgba(255,255,255,.37); font-size: .71rem; font-weight: 400;
    text-decoration: none; transition: background .12s, color .12s;
    background: transparent; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; width: 100%;
}
#side-menu ul.nav-2-level > li > a::before {
    content: ''; width: 4px; height: 4px; border-radius: 50%;
    background: rgba(255,255,255,.15); flex-shrink: 0;
    display: inline-block; transition: background .12s, transform .12s;
}
#side-menu ul.nav-2-level > li > a:hover { color:rgba(255,255,255,.82); background:rgba(255,255,255,.04); }
#side-menu ul.nav-2-level > li > a:hover::before { background:rgba(255,255,255,.4); }
#side-menu ul.nav-2-level > li > a.active { color:#00b894; background:rgba(0,184,148,.09); font-weight:500; }
#side-menu ul.nav-2-level > li > a.active::before { background:#00b894; transform:scale(1.4); }

/* Bottom dock */
#sidebar .sb-bottom {
    padding: 7px; border-top: 1px solid rgba(255,255,255,.06);
    display: flex; flex-direction: column; gap: 2px;
    flex-shrink: 0; background: #0f1623; overflow: hidden;
}
.sb-link {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 8px; border-radius: 7px;
    color: rgba(255,255,255,.4); font-size: .73rem; font-weight: 500;
    text-decoration: none; transition: background .12s, color .12s;
    background: transparent; white-space: nowrap; overflow: hidden;
    position: relative;
}
.sb-link .sb-ico {
    width: 26px; height: 26px; border-radius: 7px;
    background: rgba(255,255,255,.05);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: .74rem; flex-shrink: 0;
    transition: background .12s, color .12s;
}
.sb-link:hover { background:rgba(255,255,255,.06); color:rgba(255,255,255,.82); }
.sb-link.danger { color:rgba(220,80,80,.75); }
.sb-link.danger .sb-ico { color:rgba(220,80,80,.75); background:rgba(214,48,49,.08); }
.sb-link.danger:hover { background:rgba(214,48,49,.1); color:#ff7675; }
.sb-link .sb-lbl {
    flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    transition: opacity .15s, width .15s;
}
body.sidebar-collapsed .sb-link .sb-lbl { opacity:0; width:0; overflow:hidden; flex:0; }
@media (min-width:768px) and (max-width:991px) {
    .sb-link .sb-lbl { opacity:0; width:0; overflow:hidden; flex:0; }
}

/* Tooltip on bottom dock links in icon-only */
.sb-link { position: relative; }
.sb-link:hover .sb-tip { opacity:1; pointer-events:auto; }
body:not(.sidebar-collapsed) .sb-link .sb-tip { display:none; }
@media (min-width:768px) and (max-width:991px) {
    .sb-link .sb-tip { display:block; }
}
</style>

