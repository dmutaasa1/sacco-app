<script>
(function () {
    var MOBILE = 768;

    /* restore desktop state */
    if (window.innerWidth >= MOBILE && localStorage.getItem('sbCollapsed') === '1') {
        document.body.classList.add('sidebar-collapsed');
    }

    /* Submenu toggle — no library needed */
    window.sbToggle = function (row) {
        var iconOnly = document.body.classList.contains('sidebar-collapsed') ||
                       (window.innerWidth >= MOBILE && window.innerWidth < 992);
        if (iconOnly) return; /* don't open submenus in icon-rail mode */

        var sub = row.nextElementSibling;
        if (!sub) return;
        var willOpen = !sub.classList.contains('sb-open');

        /* Close all others */
        document.querySelectorAll('#sb-nav .sb-sub.sb-open').forEach(function (s) {
            if (s !== sub) {
                s.classList.remove('sb-open');
                if (s.previousElementSibling) s.previousElementSibling.classList.remove('sb-open');
            }
        });

        sub.classList.toggle('sb-open', willOpen);
        row.classList.toggle('sb-open', willOpen);
    };

    /* Mobile open / close */
    window.sbOpen  = function () { document.body.classList.add('sb-open'); };
    window.sbClose = function () { document.body.classList.remove('sb-open'); };

    /* Desktop toggle (used by header button) */
    window.sbDesktopToggle = function () {
        document.body.classList.toggle('sidebar-collapsed');
        /* close all submenus when collapsing to icon rail */
        if (document.body.classList.contains('sidebar-collapsed')) {
            document.querySelectorAll('#sb-nav .sb-sub.sb-open').forEach(function(s){
                s.classList.remove('sb-open');
                if (s.previousElementSibling) s.previousElementSibling.classList.remove('sb-open');
            });
        }
        localStorage.setItem('sbCollapsed',
            document.body.classList.contains('sidebar-collapsed') ? '1' : '0');
    };

    /* Wire header toggle button */
    function wireBtn() {
        var btn = document.getElementById('sidebarToggleBtn');
        if (!btn) return;
        var clone = btn.cloneNode(true);
        btn.parentNode.replaceChild(clone, btn);
        clone.addEventListener('click', function () {
            if (window.innerWidth < MOBILE) { sbOpen(); }
            else { sbDesktopToggle(); }
        });
    }

    /* Auto-close mobile sidebar on resize to desktop */
    window.addEventListener('resize', function () {
        if (window.innerWidth >= MOBILE) {
            document.body.classList.remove('sb-open');
        }
    });

    /* ── Detect page layout and mark page-wrapper accordingly ── */
    function detectLayout() {
        var pw = document.querySelector('.page-wrapper');
        if (!pw) return;
        if (pw.querySelector('.content-wrapper')) {
            pw.classList.add('pw-shell');   /* A: shell wrapping content-wrapper */
        } else {
            pw.classList.add('pw-content'); /* B: page-wrapper is the content area */
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            wireBtn();
            detectLayout();
        });
    } else {
        wireBtn();
        detectLayout();
    }
}());
</script>
