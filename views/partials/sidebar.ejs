<%
var _cp = (typeof currentPage !== 'undefined') ? currentPage : '';
function isActive(pages) {
    return (Array.isArray(pages) ? pages : [pages]).includes(_cp) ? 'active' : '';
}
function isSubActive(pages) {
    return (Array.isArray(pages) ? pages : [pages]).includes(_cp) ? 'sub-active' : '';
}
%>

<style>
/* ═══════════════════════════════════════════════════════════
   ADMIN SIDEBAR — index.ejs compatible
   Structure: body.fixed-navbar
               └ div.page-wrapper
                  ├ header.header           (fixed, z:999)
                  ├ nav#sidebar             (fixed, z:1040)
                  └ div.content-wrapper     (has margin-left)
═══════════════════════════════════════════════════════════ */

/* Mobile overlay */
#sb-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(10,15,28,.6); z-index: 1039;
    backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
}
body.sb-open #sb-overlay { display: block; }

/* ── Sidebar shell ── */
#sidebar {
    position: fixed;
    top: 60px;              /* sit below 60px fixed header */
    left: 0; bottom: 0;
    width: 220px;
    height: calc(100vh - 60px);
    background: #0f1623;
    border-right: 1px solid rgba(255,255,255,.04);
    z-index: 998;           /* below header z-index:999 */
    display: flex; flex-direction: column;
    overflow: hidden;
    font-family: 'DM Sans',-apple-system,sans-serif;
    transition: width .24s cubic-bezier(.4,0,.2,1),
                transform .24s cubic-bezier(.4,0,.2,1);
    padding-top: 0;
    box-shadow: none;
    margin: 0;
}

/* Desktop collapsed → 60px icon rail */
body.sidebar-collapsed #sidebar { width: 60px; }

/* Tablet 768–991 → auto 60px rail */
@media (min-width:768px) and (max-width:991px) {
    #sidebar { width: 60px; }
}

/* Mobile <768 → off-canvas */
@media (max-width:767px) {
    #sidebar {
        top: 0;                     /* full height overlay on mobile */
        height: 100vh;
        width: 260px;
        padding-top: 0;
        transform: translateX(-260px);
        z-index: 1040;              /* above everything on mobile */
    }
    body.sb-open #sidebar {
        transform: translateX(0);
        box-shadow: 8px 0 36px rgba(0,0,0,.5);
    }
}

/* ── Layout offsets ──
   Two page structures exist:
   A) div.page-wrapper > div.content-wrapper   (index.ejs, member_add.ejs)
      → only .content-wrapper gets the margin; .page-wrapper is a plain shell
   B) div.page-wrapper (no content-wrapper)    (member dashboard etc.)
      → .page-wrapper itself gets the margin

   JS below marks which case we're in by adding .pw-shell or .pw-content
   to .page-wrapper at runtime. CSS then targets correctly.
── */

/* Case A: page-wrapper is a shell, content-wrapper is the offset target */
.page-wrapper.pw-shell {
    margin-left: 0 !important;
    margin-top: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
}
.page-wrapper.pw-shell > .content-wrapper {
    margin-left: 220px;
    margin-top: 60px;
    min-width: 0;
    transition: margin-left .24s cubic-bezier(.4,0,.2,1);
}
body.sidebar-collapsed .page-wrapper.pw-shell > .content-wrapper { margin-left: 60px; }
@media (min-width:768px) and (max-width:991px) {
    .page-wrapper.pw-shell > .content-wrapper { margin-left: 60px; }
}
@media (max-width:767px) {
    .page-wrapper.pw-shell > .content-wrapper { margin-left: 0; margin-top: 60px; }
}

/* Case B: page-wrapper IS the content area */
.page-wrapper.pw-content {
    margin-left: 220px !important;
    margin-top: 60px !important;
    min-width: 0;
    transition: margin-left .24s cubic-bezier(.4,0,.2,1);
}
body.sidebar-collapsed .page-wrapper.pw-content { margin-left: 60px !important; }
@media (min-width:768px) and (max-width:991px) {
    .page-wrapper.pw-content { margin-left: 60px !important; }
}
@media (max-width:767px) {
    .page-wrapper.pw-content { margin-left: 0 !important; margin-top: 60px !important; }
}

/* Fallback: plain .content-wrapper (no page-wrapper parent) */
body > .content-wrapper,
.page-wrapper:not(.pw-shell):not(.pw-content) > .content-wrapper {
    margin-left: 220px;
    margin-top: 60px;
    transition: margin-left .24s cubic-bezier(.4,0,.2,1);
}
body.sidebar-collapsed > .content-wrapper { margin-left: 60px; }

/* ── Inner scroll ── */
#sb-scroll {
    flex: 1; display: flex; flex-direction: column;
    overflow-y: auto; overflow-x: hidden;
    height: 100%;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.08) transparent;
}
#sb-scroll::-webkit-scrollbar { width: 3px; }
#sb-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 4px; }

/* ── Mobile brand bar ── */
#sb-topbar {
    display: none;
    align-items: center; justify-content: space-between;
    padding: 13px 14px 12px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    flex-shrink: 0;
}
@media (max-width:767px) { #sb-topbar { display: flex; } }
.sb-brand-a {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none;
}
.sb-logo-mark {
    width: 34px; height: 34px; border-radius: 9px;
    background: linear-gradient(135deg,#00b894,#0984e3);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; color: #fff; flex-shrink: 0;
}
.sb-brand-name { font-size:.86rem; font-weight:700; color:#f0f4ff; display:block; }
.sb-brand-sub  { font-size:.57rem; font-weight:500; color:#00b894; text-transform:uppercase; letter-spacing:.9px; }
.sb-close-btn  {
    width:30px; height:30px; border-radius:8px;
    background: rgba(255,255,255,.08); border:none;
    color: rgba(255,255,255,.6); font-size:.8rem;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
}
.sb-close-btn:hover { background:rgba(255,255,255,.14); color:#fff; }

/* ── Nav ── */
#sb-nav {
    list-style: none; padding: 8px 7px; margin: 0; flex: 1;
}
#sb-nav, #sb-nav * { box-sizing: border-box; }

/* Section heading */
.sb-section {
    font-size: .54rem; font-weight: 700; letter-spacing: 1.1px;
    text-transform: uppercase; color: rgba(255,255,255,.18);
    padding: 14px 10px 4px; white-space: nowrap;
    overflow: hidden; pointer-events: none; user-select: none;
    transition: opacity .18s, padding .18s, height .18s;
}
body.sidebar-collapsed .sb-section { opacity:0; height:0; padding:0; }
@media (min-width:768px) and (max-width:991px) {
    .sb-section { opacity:0; height:0; padding:0; }
}

/* Nav item */
#sb-nav > li { position: relative; list-style: none; }

/* Row (link or clickable parent) */
.sb-a, .sb-row {
    display: flex !important;
    align-items: center !important;
    height: 38px; min-height: 38px;
    border-radius: 8px;
    color: rgba(255,255,255,.5);
    font-size: .77rem; font-weight: 500;
    text-decoration: none !important;
    cursor: pointer;
    position: relative;
    margin-bottom: 2px;
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    background: transparent;
    border: none;
    transition: background .13s, color .13s;
    padding: 0;
}
.sb-a:hover, .sb-row:hover {
    background: rgba(255,255,255,.07) !important;
    color: rgba(255,255,255,.88) !important;
    text-decoration: none !important;
}
#sb-nav > li.active > .sb-a,
#sb-nav > li.active > .sb-row {
    background: rgba(0,184,148,.13) !important;
    color: #00b894 !important;
}
#sb-nav > li.active > .sb-a::before,
#sb-nav > li.active > .sb-row::before {
    content:''; position:absolute; left:0; top:20%; bottom:20%;
    width:3px; border-radius:0 3px 3px 0; background:#00b894;
}

/* Icon slot — always 38px wide, always visible */
.sb-ico {
    width: 38px; height: 38px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: .78rem; color: rgba(255,255,255,.42);
    transition: color .13s;
}
.sb-a:hover .sb-ico,
.sb-row:hover .sb-ico { color: rgba(255,255,255,.9); }
#sb-nav > li.active > .sb-a .sb-ico,
#sb-nav > li.active > .sb-row .sb-ico { color: #00b894; }

/* Label */
.sb-lbl {
    flex: 1; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap;
    transition: opacity .18s, max-width .18s;
    max-width: 160px;
}
body.sidebar-collapsed .sb-lbl { opacity:0; max-width:0; overflow:hidden; }
@media (min-width:768px) and (max-width:991px) {
    .sb-lbl { opacity:0; max-width:0; overflow:hidden; }
}

/* Arrow */
.sb-arr {
    width: 28px; height: 38px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: .52rem; color: rgba(255,255,255,.2);
    transition: transform .2s ease, opacity .18s;
}
.sb-row.sb-open > .sb-arr { transform: rotate(90deg); color: rgba(255,255,255,.5); }
body.sidebar-collapsed .sb-arr { opacity:0; pointer-events:none; }
@media (min-width:768px) and (max-width:991px) { .sb-arr { opacity:0; pointer-events:none; } }
#sb-nav > li.active .sb-arr { color: rgba(0,184,148,.45); }

/* Tooltip (icon-only) */
.sb-tip {
    position: absolute; left: calc(100% + 10px); top: 50%;
    transform: translateY(-50%);
    background: #1a202c; color: #f0f4ff;
    font-size: .71rem; font-weight: 600;
    padding: 5px 11px; border-radius: 7px;
    white-space: nowrap; pointer-events: none;
    opacity: 0; transition: opacity .14s;
    z-index: 2000;
    box-shadow: 0 4px 16px rgba(0,0,0,.4);
}
.sb-tip::before {
    content:''; position:absolute; right:100%; top:50%; transform:translateY(-50%);
    border:5px solid transparent; border-right-color:#1a202c;
}
/* Only show in icon-only mode */
body.sidebar-collapsed #sb-nav > li:hover > .sb-a .sb-tip,
body.sidebar-collapsed #sb-nav > li:hover > .sb-row .sb-tip { opacity: 1; }
@media (min-width:768px) and (max-width:991px) {
    #sb-nav > li:hover > .sb-a .sb-tip,
    #sb-nav > li:hover > .sb-row .sb-tip { opacity: 1; }
}

/* Submenu */
.sb-sub {
    list-style: none;
    margin: 0; padding: 0;
    max-height: 0; overflow: hidden;
    transition: max-height .28s cubic-bezier(.4,0,.2,1);
}
.sb-sub.sb-open { max-height: 500px; }
body.sidebar-collapsed .sb-sub { display: none !important; }
@media (min-width:768px) and (max-width:991px) { .sb-sub { display: none !important; } }

.sb-sub > li { list-style: none; }
.sb-sub > li > a {
    display: flex; align-items: center; gap: 8px;
    padding: 5px 8px 5px 46px;
    border-radius: 6px;
    color: rgba(255,255,255,.36); font-size: .71rem; font-weight: 400;
    text-decoration: none;
    transition: background .12s, color .12s;
    white-space: nowrap; width: 100%;
}
.sb-sub > li > a::before {
    content:''; width:5px; height:5px; border-radius:50%;
    background: rgba(255,255,255,.15); flex-shrink:0;
    display:inline-block;
    transition: background .12s, transform .12s;
}
.sb-sub > li > a:hover { color:rgba(255,255,255,.82); background:rgba(255,255,255,.04); }
.sb-sub > li > a:hover::before { background:rgba(255,255,255,.5); }
.sb-sub > li > a.sub-active { color:#00b894; font-weight:500; }
.sb-sub > li > a.sub-active::before { background:#00b894; transform:scale(1.5); }

/* Bottom dock */
#sb-dock {
    padding: 6px 7px 12px;
    border-top: 1px solid rgba(255,255,255,.06);
    flex-shrink: 0;
}
.sb-dock-link {
    display: flex; align-items: center;
    height: 36px; border-radius: 7px;
    color: rgba(255,255,255,.38); font-size: .73rem; font-weight: 500;
    text-decoration: none;
    transition: background .13s, color .13s;
    white-space: nowrap; overflow: hidden;
    position: relative; margin-bottom: 2px;
}
.sb-dock-link:hover { background: rgba(255,255,255,.06); color: rgba(255,255,255,.8); text-decoration:none; }
.sb-dock-link.danger { color: rgba(230,75,75,.72); }
.sb-dock-link.danger:hover { background: rgba(214,48,49,.1); color: #ff7675; }
</style>

