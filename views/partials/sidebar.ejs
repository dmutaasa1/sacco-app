<script>
(function () {
    /* ── Metismenu init ── */
    function initSidebar() {
        if (typeof jQuery === 'undefined' || !jQuery.fn.metisMenu) return setTimeout(initSidebar, 60);
        var $menu = jQuery('#side-menu');
        if ($menu.data('metisMenu')) return;
        $menu.metisMenu({ toggle: true });
        /* Auto-open active parent */
        $menu.find('> li.active').each(function () {
            var $sub = jQuery(this).children('ul.nav-2-level');
            if ($sub.length) { $sub.addClass('in').css('height',''); jQuery(this).children('a').attr('aria-expanded','true'); }
        });
        $menu.find('ul.nav-2-level a.active').each(function () {
            var $sub = jQuery(this).closest('ul.nav-2-level');
            $sub.addClass('in').css('height','');
            $sub.closest('li').children('a').attr('aria-expanded','true');
        });
    }

    /* ── Restore sidebar state ── */
    function restoreState() {
        if (window.innerWidth >= 768 && localStorage.getItem('sidebarCollapsed') === '1') {
            document.body.classList.add('sidebar-collapsed');
        }
    }

    /* ── Responsive auto-handler ── */
    function handleResize() {
        var sb = document.getElementById('sidebar');
        var overlay = document.getElementById('sbOverlay');
        if (window.innerWidth < 768) {
            /* Mobile: ensure sidebar is hidden unless toggled open */
            document.body.classList.remove('sidebar-collapsed');
            if (sb) { sb.classList.remove('mobile-open'); }
            if (overlay) { overlay.classList.remove('open'); }
        }
    }

    window.closeMobileSidebar = function() {
        var sb = document.getElementById('sidebar');
        var overlay = document.getElementById('sbOverlay');
        if (sb) sb.classList.remove('mobile-open');
        if (overlay) overlay.classList.remove('open');
    };

    window.openMobileSidebar = function() {
        var sb = document.getElementById('sidebar');
        var overlay = document.getElementById('sbOverlay');
        if (sb) sb.classList.add('mobile-open');
        if (overlay) overlay.classList.add('open');
    };

    window.addEventListener('resize', handleResize);
    restoreState();
    handleResize();

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(initSidebar, 150); });
    } else {
        setTimeout(initSidebar, 150);
    }
}());
</script>
